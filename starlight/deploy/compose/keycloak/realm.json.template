{
  "realm": "example",
  "enabled": true,
  "displayName": "Example Corp (development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {"name": "starlight-admins"},
    {"name": "ml-engineers"}
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@example.com",
      "firstName": "Ada",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/starlight-admins", "/ml-engineers"],
      "credentials": [{"type": "password", "value": "__USER_PASSWORD__", "temporary": false}]
    }
  ],
  "clients": [
    {
      "clientId": "starlight",
      "name": "TensorFold Starlight",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["__PUBLIC_URL__/auth/keycloak/callback"],
      "webOrigins": [],
      "frontchannelLogout": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "__PUBLIC_URL__/auth/keycloak/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "__PUBLIC_URL__/auth/login"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
