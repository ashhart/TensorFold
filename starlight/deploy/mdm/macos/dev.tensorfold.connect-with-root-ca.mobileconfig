<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Connect settings plus a trusted root for a Starlight certificate from a private CA. Replace every value marked REPLACE. -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>dev.tensorfold.connect</string>
			<key>PayloadIdentifier</key>
			<string>com.example.tensorfold.connect.settings</string>
			<key>PayloadUUID</key>
			<string>E48A7AAF-D074-4897-82EF-56F338BDF280</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>TensorFold Connect settings</string>
			<!-- REPLACE: your Starlight address. -->
			<key>ServerURL</key>
			<string>https://starlight.example.com</string>
			<key>AllowManualServer</key>
			<false/>
			<key>BridgePort</key>
			<integer>7171</integer>
			<key>DisableBridge</key>
			<false/>
		</dict>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.security.root</string>
			<key>PayloadIdentifier</key>
			<string>com.example.tensorfold.connect.root-ca</string>
			<key>PayloadUUID</key>
			<string>02F0D730-2CE5-474A-AB40-F088143BDC4B</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>Starlight root certificate</string>
			<key>PayloadCertificateFileName</key>
			<string>starlight-root-ca.cer</string>
			<!-- REPLACE: base64 of your root CA in DER form, from: openssl x509 -in ca.pem -outform der | base64 -->
			<key>PayloadContent</key>
			<data>UkVQTEFDRS1XSVRILUJBU0U2NC1ERVItT0YtWU9VUi1ST09ULUNB</data>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>TensorFold Connect with Starlight root CA</string>
	<key>PayloadDescription</key>
	<string>Points TensorFold Connect at your organisation's Starlight and trusts its private CA.</string>
	<!-- REPLACE: your organisation's reverse-DNS identifier and name. -->
	<key>PayloadIdentifier</key>
	<string>com.example.tensorfold.connect.with-ca</string>
	<key>PayloadOrganization</key>
	<string>Example Organisation</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>1D68CF17-30C9-46D1-B487-3B320044D392</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
