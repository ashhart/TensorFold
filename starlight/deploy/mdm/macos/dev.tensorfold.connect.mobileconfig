<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TensorFold Connect managed settings. Replace every value marked REPLACE, and run uuidgen for new PayloadUUIDs per profile. -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>dev.tensorfold.connect</string>
			<key>PayloadIdentifier</key>
			<string>com.example.tensorfold.connect.settings</string>
			<key>PayloadUUID</key>
			<string>E228D925-6503-4DC8-A180-112ACB45CD4C</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>TensorFold Connect settings</string>
			<!-- REPLACE: your Starlight address. -->
			<key>ServerURL</key>
			<string>https://starlight.example.com</string>
			<!-- false keeps users on ServerURL; true lets them sign in elsewhere. -->
			<key>AllowManualServer</key>
			<false/>
			<!-- Port of the local endpoint on 127.0.0.1, 1024-65535. -->
			<key>BridgePort</key>
			<integer>7171</integer>
			<!-- true turns the local endpoint off; tools must then call Starlight directly. -->
			<key>DisableBridge</key>
			<false/>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>TensorFold Connect</string>
	<key>PayloadDescription</key>
	<string>Points TensorFold Connect at your organisation's Starlight.</string>
	<!-- REPLACE: your organisation's reverse-DNS identifier and name. -->
	<key>PayloadIdentifier</key>
	<string>com.example.tensorfold.connect</string>
	<key>PayloadOrganization</key>
	<string>Example Organisation</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>4A0AB505-C5D2-49D9-AEE3-95C1C65DD35A</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
