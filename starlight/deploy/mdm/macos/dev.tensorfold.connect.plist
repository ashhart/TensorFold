<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Preference file for MDM tools that take a plist and a domain (dev.tensorfold.connect). REPLACE the address. -->
<plist version="1.0">
<dict>
	<key>ServerURL</key>
	<string>https://starlight.example.com</string>
	<key>AllowManualServer</key>
	<false/>
	<key>BridgePort</key>
	<integer>7171</integer>
	<key>DisableBridge</key>
	<false/>
</dict>
</plist>
