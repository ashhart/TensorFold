<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>TensorFold Connect</displayName>
  <description>Settings for TensorFold Connect, the desktop client for TensorFold Starlight.</description>
  <resources>
    <stringTable>
      <string id="TensorFold">TensorFold</string>
      <string id="Connect">Connect</string>
      <string id="SUPPORTED_Connect">TensorFold Connect</string>
      <string id="ServerURL">Starlight address</string>
      <string id="ServerURL_Explain">The HTTPS address of your organisation's TensorFold Starlight, for example https://starlight.example.com. Unless "Allow users to choose another server" is enabled, users cannot sign in to any other server.</string>
      <string id="AllowManualServer">Allow users to choose another server</string>
      <string id="AllowManualServer_Explain">When enabled, users may sign in to a server other than the managed Starlight address. When disabled or not configured while a Starlight address is set, the managed address is the only one Connect uses.</string>
      <string id="CAFile">CA certificate file</string>
      <string id="CAFile_Explain">Path to a PEM file holding the CA certificate that issued Starlight's HTTPS certificate. Connect trusts it in addition to the Windows certificate store.</string>
      <string id="CACertificatePEM">CA certificate (PEM)</string>
      <string id="CACertificatePEM_Explain">The PEM text of the CA certificate that issued Starlight's HTTPS certificate, one line per entry. It takes precedence over the CA certificate file.</string>
      <string id="BridgePort">Local endpoint port</string>
      <string id="BridgePort_Explain">The port on 127.0.0.1 where Connect's local endpoint listens, from 1024 to 65535. The default is 7171.</string>
      <string id="DisableBridge">Turn off the local endpoint</string>
      <string id="DisableBridge_Explain">When enabled, Connect does not run its local endpoint, so local tools must authenticate to Starlight directly.</string>
    </stringTable>
    <presentationTable>
      <presentation id="ServerURL">
        <textBox refId="ServerURL"><label>Starlight address:</label></textBox>
      </presentation>
      <presentation id="CAFile">
        <textBox refId="CAFile"><label>CA certificate file:</label></textBox>
      </presentation>
      <presentation id="CACertificatePEM">
        <multiTextBox refId="CACertificatePEM">CA certificate (PEM):</multiTextBox>
      </presentation>
      <presentation id="BridgePort">
        <decimalTextBox refId="BridgePort" defaultValue="7171">Port:</decimalTextBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
