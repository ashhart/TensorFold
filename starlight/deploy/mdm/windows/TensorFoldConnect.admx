<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="tensorfoldconnect" namespace="TensorFold.Policies.Connect" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Connect" displayName="$(string.SUPPORTED_Connect)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="TensorFold" displayName="$(string.TensorFold)" />
    <category name="Connect" displayName="$(string.Connect)">
      <parentCategory ref="TensorFold" />
    </category>
  </categories>
  <policies>
    <policy name="ServerURL" class="Both" displayName="$(string.ServerURL)" explainText="$(string.ServerURL_Explain)"
      presentation="$(presentation.ServerURL)" key="SOFTWARE\Policies\TensorFold\Connect">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <elements>
        <text id="ServerURL" valueName="ServerURL" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="AllowManualServer" class="Both" displayName="$(string.AllowManualServer)" explainText="$(string.AllowManualServer_Explain)"
      key="SOFTWARE\Policies\TensorFold\Connect" valueName="AllowManualServer">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="CAFile" class="Both" displayName="$(string.CAFile)" explainText="$(string.CAFile_Explain)"
      presentation="$(presentation.CAFile)" key="SOFTWARE\Policies\TensorFold\Connect">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <elements>
        <text id="CAFile" valueName="CAFile" required="true" maxLength="1024" />
      </elements>
    </policy>
    <policy name="CACertificatePEM" class="Both" displayName="$(string.CACertificatePEM)" explainText="$(string.CACertificatePEM_Explain)"
      presentation="$(presentation.CACertificatePEM)" key="SOFTWARE\Policies\TensorFold\Connect">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <elements>
        <multiText id="CACertificatePEM" valueName="CACertificatePEM" required="true" />
      </elements>
    </policy>
    <policy name="BridgePort" class="Both" displayName="$(string.BridgePort)" explainText="$(string.BridgePort_Explain)"
      presentation="$(presentation.BridgePort)" key="SOFTWARE\Policies\TensorFold\Connect">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <elements>
        <decimal id="BridgePort" valueName="BridgePort" required="true" minValue="1024" maxValue="65535" />
      </elements>
    </policy>
    <policy name="DisableBridge" class="Both" displayName="$(string.DisableBridge)" explainText="$(string.DisableBridge_Explain)"
      key="SOFTWARE\Policies\TensorFold\Connect" valueName="DisableBridge">
      <parentCategory ref="Connect" />
      <supportedOn ref="SUPPORTED_Connect" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
  </policies>
</policyDefinitions>
