<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.tensorfold.starlight-node</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/starlight-node</string>
		<string>run</string>
		<string>--state-dir</string>
		<string>/Library/Application Support/TensorFold/Starlight Node</string>
		<string>--engine</string>
		<string>/opt/homebrew/bin/tensorfold</string>
		<string>--prevent-sleep</string>
	</array>
	<key>UserName</key>
	<string>_tensorfold</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Library/Application Support/TensorFold/Starlight Node/home</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>180</integer>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Library/Logs/TensorFold/starlight-node.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/TensorFold/starlight-node.log</string>
</dict>
</plist>
