[Unit]
Description=TensorFold Starlight Node
Documentation=https://tensorfold.dev
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=starlight-node
Group=starlight-node
ExecStart=/usr/local/bin/starlight-node run --state-dir /var/lib/starlight-node --engine /opt/tensorfold/bin/tensorfold-native --hf-home /var/lib/starlight-node/hf
Environment=HOME=/var/lib/starlight-node/home
StateDirectory=starlight-node
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillMode=mixed
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
