[Unit]
Description=TensorFold Starlight
Documentation=https://github.com/ashhart/TensorFold/tree/main/starlight/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/starlight serve --config /etc/starlight/starlight.yaml
LoadCredential=master_key:/etc/starlight/credentials/master-key
LoadCredential=database_url:/etc/starlight/credentials/database-url
Environment=STARLIGHT_MASTER_KEY_FILE=%d/master_key
Environment=STARLIGHT_DATABASE_URL_FILE=%d/database_url
# To serve TLS directly, add LoadCredential= lines for the certificate and key and point STARLIGHT_TLS_CERT_FILE/STARLIGHT_TLS_KEY_FILE at %d.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
