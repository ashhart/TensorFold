#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

// ACT_IN_F32/ACT_OUT_F32/ACT_OUT_BF16: the norm's activation in/out while the gain stays bf16.
#ifdef ACT_IN_F32
#define ACT_IN float
#define ACT_IN_LOAD(x) (x)
#else
#define ACT_IN STORAGE_TYPE
#define ACT_IN_LOAD(x) LOAD_VALUE(x)
#endif
#ifdef ACT_OUT_F32
#define ACT_OUT float
#define ACT_OUT_STORE(f) (f)
#elif defined(ACT_OUT_BF16)
#define ACT_OUT uint16_t
#define ACT_OUT_STORE(f) bf16_store(f)
#else
#define ACT_OUT STORAGE_TYPE
#define ACT_OUT_STORE(f) STORE_VALUE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  ACT_IN values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
#ifdef LAYER_NORM
layout(set = 0, binding = 2, std430) readonly buffer Bias {
  STORAGE_TYPE values[];
} bias_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  ACT_OUT values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

#ifdef LAYER_NORM
    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum += ACT_IN_LOAD(input_data.values[start + index]);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mu = block_values[0] / float(row_length);
    barrier();
#endif

    float local_sq = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      float value = ACT_IN_LOAD(input_data.values[start + index]);
      local_sq += value * value;
    }
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
#ifdef LAYER_NORM
    float variance = mean_square - mu * mu;
#else
    float variance = mean_square;
#endif
    float norm = inversesqrt(variance + eps);

    for (uint index = thread; index < row_length; index += threads) {
      float value = ACT_IN_LOAD(input_data.values[start + index]);
      float weight =
          (params.lhs_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
#ifdef LAYER_NORM
      float bias =
          (params.aux_size == 1u)
              ? LOAD_VALUE(bias_data.values[params.aux_offset])
              : LOAD_VALUE(bias_data.values[params.aux_offset + index]);
      float result = (value - mu) * norm * weight + bias;
#else
#ifdef ORACLE_QWEN35
      // Ash8c Metal: bfloat(Wt*(hv*inv)); weight multiplies the product; one store rounding.
      float result = weight * (value * norm);
#else
      float result = value * norm * weight;
#endif
#endif
      output_data.values[params.output_offset + row * row_length + index] =
          ACT_OUT_STORE(result);
    }
    barrier();
  }
}
