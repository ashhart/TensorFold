#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// SwiGLU: out = silu(gate) * up in f32, one rounding on store (BF16 arm).

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint count;
    uint gate_offset;
    uint up_offset;
    uint materialize;
} params;

float bf16_to_f32(uint h) { return uintBitsToFloat((h & 0xffffu) << 16u); }

uint16_t f32_to_bf16(float x) {
    uint u = floatBitsToUint(x);
    if ((u & 0x7fffffffu) > 0x7f800000u) {
        return uint16_t((u >> 16u) | 0x0040u);
    }
    return uint16_t((u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u);
}

#if defined(ACT_F32)
layout(set = 0, binding = 0, std430) readonly buffer Gate { float v[]; } gate;
layout(set = 0, binding = 1, std430) readonly buffer Up { float v[]; } up;
layout(set = 0, binding = 2, std430) writeonly buffer Out { float v[]; } obuf;
#else
layout(set = 0, binding = 0, std430) readonly buffer Gate { uint16_t v[]; } gate;
layout(set = 0, binding = 1, std430) readonly buffer Up { uint16_t v[]; } up;
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint16_t v[]; } obuf;
#endif
layout(set = 0, binding = 3, std430) readonly buffer DummyA { uint v[]; } da;
layout(set = 0, binding = 4, std430) readonly buffer DummyB { uint v[]; } db;

void main() {
    uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += step) {
#if defined(ACT_F32)
        float g = gate.v[params.gate_offset + i];
        float u = up.v[params.up_offset + i];
        obuf.v[i] = (g / (1.0 + exp(-g))) * u;
#else
        float g = bf16_to_f32(uint(gate.v[params.gate_offset + i]));
        float u = bf16_to_f32(uint(up.v[params.up_offset + i]));
        obuf.v[i] = f32_to_bf16((g / (1.0 + exp(-g))) * u);
#endif
    }
}
