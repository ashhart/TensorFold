//  Fused rotary embedding matching mlx::core::fast::RoPE (mlx/fast.cpp, pinned 0.32.2) whose upstream Metal reference is rope.metal. No shared memory, no barriers.
//  Contract cases the kernel implements: - traditional (interleaved pairs, flags bit 1) and half-split layouts - forward and inverse (flags bit 0; the inverse form serves the VJP) - inv_freqs from the base, exp((-i) * log(base)/(dims/2)) with beta precomputed on the host in float, or from a float32 freqs buffer (USE_FREQS: 1/freqs[i], matching reciprocal() = 1.0f/x) - per-batch int32 offsets read from device memory (stride matrix_m; 0 for a scalar offset), positions = (t + offset) * scale in float32 - float32, float16, bfloat16 storage; each intermediate rounds once to storage precision exactly like the eager elementwise/cast kernels the fallback composition dispatches, so the fused output matches the composed path bit for bit in float16 and bfloat16. Float32 lands within an absolute 1e-6: the driver may contract x*y - z*w into a fused multiply-add and the composed path can never do that because its intermediates cross kernel boundaries; cancellation can amplify the round-off to many ulps while the absolute error stays at or below ~1e-8 (observed; pinned at 1e-6 in the value tests). - strided inputs: row-contiguous, 3D strided, and the 4D head/sequence transposed layout (flags bit 4) read through their strides; partial rotation (flags bit 3) also writes the passthrough tail from the input; anything else the host materializes into a temporary first
//  The bfloat16 branch deliberately avoids a 16-bit-typed storage block: a uint16_t block compiled from this exact source returns recycled-memory garbage on llvmpipe (observed 2026-09-03, stable across -Os/-O0 and across arithmetic changes, while the float16 twin of the same shader is bit-exact). The workaround is the repo's proven form - 32-bit word IO with constant shifts and select chains only, as in reduce_general's load_truthy fix (commit cf68e7d) - not a new 16-bit form. The two lanes of one output word can belong to different invocations, so the packed output store is a disjoint-half atomicOr pair, not a read-modify-write.
//  The input and output bindings are readonly and writeonly and never alias: the host rotates into a fresh output buffer instead of updating the input in place. Binding one buffer readonly in one slot and writeonly in another and then aliasing them drops stores on llvmpipe (observed 2026-09-03: the even outputs kept their stale copy-in values), so no path may rely on that form. scatter.comp's in-place output stays a single binding for the same reason.
//  Sin/cos are the GLSL built-ins, the same calls the eager composition makes through elementwise.comp cases 11/12. The kTrigArgumentLimit gate (1e5, primitives.cpp) ran per eager Sin/Cos primitive; fusion removes those primitive sites while the theta construction is unchanged, so the trusted envelope documented there applies verbatim. RoPE::eval_gpu carries an equivalent magnitude gate; see rope_trig_gate in primitives.cpp.
//  No data-dependent shift-and-mask appears anywhere: the only shifts are the constant 16-lane shifts of the bf16 word IO and the even/odd pair split, the device-probed select-chain form (commit cf68e7d).
//  Push-constant mapping (ComputeParams fields): count B*N*T*(dims/2), or B*N*T*D with the passthrough flag alpha scale beta float(log(base)/(dims/2)), base variant only flags bit0 forward, bit1 traditional, bit2 head-seq transpose, bit3 passthrough (dims < D) dims dims/2 shape[0] N, the product of the middle dimensions shape[1] T shape[2] D, the rotated-axis extent (passthrough only) matrix_m offset stride, 0 for a scalar offset lhs/output/rhs/aux_offset item offsets of input/output/offset/freqs in_strides input strides (head matrix, time, feature) out_strides output strides (head matrix, time, feature)

#version 460

#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
float rope_load(uint abs_index) {
  return float(input_data.values[abs_index]);
}
void rope_store(uint abs_index, float value) {
  output_data.values[abs_index] = float16_t(value);
}
float rope_round(float value) {
  // Round to storage precision and back to float: the eager composition stores every intermediate at storage precision and the next kernel loads it back, so every intermediate here passes through rope_round the same way. That is what makes float16 match the composed path bit for bit.
  return float(float16_t(value));
}
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
// The input rides 32-bit words, two bf16 lanes per word, constant shifts and selects only: a uint16_t-typed block compiled from this exact source returns recycled-memory garbage on llvmpipe (observed 2026-09-03, stable across -Os/-O0 and across arithmetic changes, while the float16 twin of the same shader is bit-exact), so the loads take the repo's proven reduce_general form. The in-register rope_round calls reproduce the composition's intermediate roundings and the store applies the one final rounding, so bfloat16 stays bit-exact against the composed path. The output binding stores packed bf16 words. The rotate writes the repo's proven constant-shift form; every element is written exactly once but the two lanes of one word can belong to different invocations, so the lane stores are disjoint-half atomicOr - each word receives exactly two ORs (one zeroing the high half, one zeroing the low half), so the OR result is the correct packed value regardless of initial memory content or arrival order. The store applies the RNE float32->bf16 rounding the cast kernel applied in the old float32-temporary path, and the rope_round intermediates already are exact bf16 values, so output bits are identical to the composed path's final cast.
layout(set = 0, binding = 0, std430) readonly buffer Input {
  uint values[];
} input_data;
layout(set = 0, binding = 1, std430) buffer Output {
  uint values[];
} output_data;
float rope_load(uint abs_index) {
  uint word = input_data.values[abs_index >> 1u];
  uint bits = ((abs_index & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
  return uintBitsToFloat(bits << 16u);
}
uint bf16_bits(float value) {
  uint bits = floatBitsToUint(value);
  return isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
}
// ASH_QWEN35 (dense Qwen3.5-2B Metal oracle, zig/kernels/metal/qwen3_5/ layout.metal qwen35_rotate): Metal computes angle, cos, sin and both products in f32 and rounds once at the bfloat store, so the oracle variant skips every intermediate bf16 rounding. The final store still goes through bf16_bits's RNE, matching Metal's bfloat() conversion. Default (MLX composed path) keeps the rope_round chain.
float rope_round(float value) {
#ifdef ASH_QWEN35
  return value;
#else
  uint bits = floatBitsToUint(value);
  uint rounded = isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
  return uintBitsToFloat(rounded << 16u);
#endif
}
#else
#define STORAGE_TYPE float
layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
float rope_load(uint abs_index) {
  return input_data.values[abs_index];
}
void rope_store(uint abs_index, float value) {
  output_data.values[abs_index] = value;
}
float rope_round(float value) {
  return value;
}
#endif

layout(set = 0, binding = 2, std430) readonly buffer Offsets {
  int values[];
} offset_data;
#ifdef USE_FREQS
layout(set = 0, binding = 3, std430) readonly buffer Freqs {
  float values[];
} freqs_data;
#endif

// ASH_QWEN35: Metal builds the inverse frequency as pow(10000000.0f, -i/32) rather than exp(-i*log(base)/(dims/2)); keep the exact expression. i is always < 32 here (the half-split pair).
float rope_inv_freq(uint i) {
#if defined(ASH_QWEN35)
  return pow(1.0e7f, -float(i) / 32.0f);
#elif defined(USE_FREQS)
  return 1.0f / freqs_data.values[params.aux_offset + i];
#else
  return exp(-float(i) * params.beta);
#endif
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
#ifdef USE_BF16
  // Pair-granular bf16 main: each invocation owns whole 32-bit output words (two adjacent elements of one row) and computes both lanes itself, so plain stores replace the atomicOr pair that proved lane-lossy on Apple-hardware Vulkan (see receipts/2026-09-21-decode-kv-direct). Requires an even rotation half (dims % 4 == 0), an even passthrough extent, and even kv window element offsets - all host-guarded. params.count enumerates output WORDS: the host halves the element count for the passthrough branch only (the rotated branch already enumerates half_dims threads per row, each of which now emits two words).
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint half_dims = params.dims;
  uint time = params.shape[1];
  uint heads = params.shape[0];
  bool forward = (params.flags & 1u) != 0u;
  bool traditional = (params.flags & 2u) != 0u;
  bool head_seq_transpose = (params.flags & 4u) != 0u;
  bool passthrough = (params.flags & 8u) != 0u;
  while (index < params.count) {
    uint k;
    uint t;
    uint mat;
    if (!passthrough && !traditional) {
      // Half-split rotation: row_words = D/2 words per row.
      {
        uint row_words = half_dims;
        k = index % row_words;
        t = (index / row_words) % time;
        mat = index / (row_words * time);
        uint b = mat / heads;
        uint head = mat - b * heads;
        float offset = float(
            offset_data.values[params.rhs_offset + b * params.matrix_m]);
        float position = params.alpha * (float(t) + offset);
        // k < half_dims/2 owns the r1 word for elements 2k, 2k+1; k >= half_dims/2 owns the r2 word for the mirrored pair in the second half of the row.
        bool r1_side = k < (half_dims >> 1u);
        // Element index j0/j1; the theta and the rotation operands always use the mirrored position i = element - half_dims on the r2 side (the std kernel's i, see out_index_2 there).
        uint j0 = r1_side ? (2u * k)
                          : (half_dims + 2u * (k - (half_dims >> 1u)));
        uint j1 = j0 + 1u;
        uint i0 = r1_side ? j0 : (j0 - half_dims);
        uint i1 = i0 + 1u;
#ifdef USE_FREQS
        float inv0 = 1.0f / freqs_data.values[params.aux_offset + i0];
        float inv1 = 1.0f / freqs_data.values[params.aux_offset + i1];
#else
        float inv0 = exp(-float(i0) * params.beta);
        float inv1 = exp(-float(i1) * params.beta);
#endif
        float cos0 = rope_round(omarchy_trig_cos(position * inv0));
        float sin0 = rope_round(omarchy_trig_sin(position * inv0));
        float cos1 = rope_round(omarchy_trig_cos(position * inv1));
        float sin1 = rope_round(omarchy_trig_sin(position * inv1));
        uint in_base;
        if (head_seq_transpose) {
          in_base = b * (time * params.in_strides[1]) +
              t * params.in_strides[1] + head * params.in_strides[0];
        } else {
          in_base = t * params.in_strides[1] + mat * params.in_strides[0];
        }
        uint out_row =
            t * params.out_strides[1] + mat * params.out_strides[0];
        uint x1a = in_base + i0 * params.in_strides[2];
        uint x2a = x1a + half_dims * params.in_strides[2];
        uint x1b = in_base + i1 * params.in_strides[2];
        uint x2b = x1b + half_dims * params.in_strides[2];
        float xa = rope_load(params.lhs_offset + x1a);
        float xb = rope_load(params.lhs_offset + x2a);
        float xc = rope_load(params.lhs_offset + x1b);
        float xd = rope_load(params.lhs_offset + x2b);
        float v0;
        float v1;
        if (r1_side) {
          v0 = forward ? (rope_round(xa * cos0) - rope_round(xb * sin0))
                       : (rope_round(xb * sin0) + rope_round(xa * cos0));
          v1 = forward ? (rope_round(xc * cos1) - rope_round(xd * sin1))
                       : (rope_round(xd * sin1) + rope_round(xc * cos1));
        } else {
          v0 = forward ? (rope_round(xa * sin0) + rope_round(xb * cos0))
                       : (rope_round(xb * cos0) - rope_round(xa * sin0));
          v1 = forward ? (rope_round(xc * sin1) + rope_round(xd * cos1))
                       : (rope_round(xd * cos1) - rope_round(xc * sin1));
        }
        uint word_base = (params.output_offset + out_row) >> 1u;
        output_data.values[word_base + k] =
            bf16_bits(v0) | (bf16_bits(v1) << 16u);
      }
    } else {
      // Traditional half-split (elements 2i, 2i+1 already form one word) and the passthrough branch (one word per d pair).
      uint row_words = passthrough ? (params.shape[2] >> 1u) : half_dims;
      uint k = index % row_words;
      t = (index / row_words) % time;
      mat = index / (row_words * time);
      uint b = mat / heads;
      uint head = mat - b * heads;
      float offset = float(
          offset_data.values[params.rhs_offset + b * params.matrix_m]);
      float position = params.alpha * (float(t) + offset);
      uint in_base;
      if (head_seq_transpose) {
        in_base = b * (time * params.in_strides[1]) +
            t * params.in_strides[1] + head * params.in_strides[0];
      } else {
        in_base = t * params.in_strides[1] + mat * params.in_strides[0];
      }
      uint out_row = t * params.out_strides[1] + mat * params.out_strides[0];
      uint word_base = (params.output_offset + out_row) >> 1u;
      if (!passthrough) {
        // Traditional: element 2i = r1, element 2i+1 = r2, one theta.
        uint i = k;
#ifdef USE_FREQS
        float inv_freq = 1.0f / freqs_data.values[params.aux_offset + i];
#else
        float inv_freq = exp(-float(i) * params.beta);
#endif
        float theta = position * inv_freq;
        float cos_t = rope_round(omarchy_trig_cos(theta));
        float sin_t = rope_round(omarchy_trig_sin(theta));
        uint in_row = in_base;
        float x1 = rope_load(
            params.lhs_offset + in_row + (2u * i) * params.in_strides[2]);
        float x2 = rope_load(
            params.lhs_offset + in_row + (2u * i + 1u) * params.in_strides[2]);
        float xa = rope_round(x1 * cos_t);
        float xb = rope_round(x2 * sin_t);
        float xc = rope_round(x1 * sin_t);
        float xd = rope_round(x2 * cos_t);
        float r1 = forward ? (xa - xb) : (xb + xa);
        float r2 = forward ? (xc + xd) : (xd - xa);
        output_data.values[word_base + k] =
            bf16_bits(r1) | (bf16_bits(r2) << 16u);
      } else {
        // Passthrough pair: two adjacent d, both rotated (d < dims) or both tail.
        uint d0 = 2u * k;
        uint d1 = d0 + 1u;
        float v0;
        float v1;
        if (d0 >= 2u * half_dims) {
          v0 = rope_load(
              params.lhs_offset + in_base + d0 * params.in_strides[2]);
          v1 = rope_load(
              params.lhs_offset + in_base + d1 * params.in_strides[2]);
        } else {
          float vals[2];
          for (uint side = 0u; side < 2u; ++side) {
            uint d = d0 + side;
            uint i = d % half_dims;
#ifdef USE_FREQS
            float inv_freq = 1.0f / freqs_data.values[params.aux_offset + i];
#else
            float inv_freq = exp(-float(i) * params.beta);
#endif
            float theta = position * inv_freq;
            float cos_t = rope_round(omarchy_trig_cos(theta));
            float sin_t = rope_round(omarchy_trig_sin(theta));
            uint x1_index = in_base + i * params.in_strides[2];
            uint x2_index = x1_index + half_dims * params.in_strides[2];
            float x1 = rope_load(params.lhs_offset + x1_index);
            float x2 = rope_load(params.lhs_offset + x2_index);
            float xa = rope_round(x1 * cos_t);
            float xb = rope_round(x2 * sin_t);
            float xc = rope_round(x1 * sin_t);
            float xd = rope_round(x2 * cos_t);
            vals[side] = (d < half_dims) ? (forward ? (xa - xb) : (xb + xa))
                                         : (forward ? (xc + xd) : (xd - xa));
          }
          v0 = vals[0];
          v1 = vals[1];
        }
        output_data.values[word_base + k] =
            bf16_bits(v0) | (bf16_bits(v1) << 16u);
      }
    }
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
  return;
#else
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint half_dims = params.dims;
  uint time = params.shape[1];
  uint heads = params.shape[0];
  bool forward = (params.flags & 1u) != 0u;
  bool traditional = (params.flags & 2u) != 0u;
  bool head_seq_transpose = (params.flags & 4u) != 0u;
  bool passthrough = (params.flags & 8u) != 0u;
  while (index < params.count) {
    uint i;
    uint t;
    uint mat;
    if (passthrough) {
      uint d = index % params.shape[2];
      t = (index / params.shape[2]) % time;
      mat = index / (params.shape[2] * time);
      uint b = mat / heads;
      uint head = mat - b * heads;
      i = traditional ? (d >> 1u) : (d - (d / half_dims) * half_dims);
      float offset =
          float(offset_data.values[params.rhs_offset + b * params.matrix_m]);
      float position = params.alpha * (float(t) + offset);
#ifdef USE_FREQS
      float inv_freq = 1.0f / freqs_data.values[params.aux_offset + i];
#else
      float inv_freq = exp(-float(i) * params.beta);
#endif
      float theta = position * inv_freq;
      float cos_t = rope_round(omarchy_trig_cos(theta));
      float sin_t = rope_round(omarchy_trig_sin(theta));
      uint in_base;
      if (head_seq_transpose) {
        in_base = b * (time * params.in_strides[1]) +
            t * params.in_strides[1] + head * params.in_strides[0];
      } else {
        in_base = t * params.in_strides[1] + mat * params.in_strides[0];
      }
      uint out_base =
          t * params.out_strides[1] + mat * params.out_strides[0];
      uint x1_index = in_base +
          (traditional ? (d & ~1u) : i) * params.in_strides[2];
      uint x2_index = traditional
          ? (x1_index + params.in_strides[2])
          : (x1_index + half_dims * params.in_strides[2]);
      uint out_index = out_base + d * params.out_strides[2];
      if (d >= 2u * half_dims) {
        // Passthrough tail: the rotated range ends at dims; the rest of the axis carries the input through untouched.
        rope_store(
            params.output_offset + out_index,
            rope_load(params.lhs_offset + in_base + d * params.in_strides[2]));
      } else {
        float x1 = rope_load(params.lhs_offset + x1_index);
        float x2 = rope_load(params.lhs_offset + x2_index);
        float xa = rope_round(x1 * cos_t);
        float xb = rope_round(x2 * sin_t);
        float xc = rope_round(x1 * sin_t);
        float xd = rope_round(x2 * cos_t);
        bool first = traditional ? ((d & 1u) == 0u) : (d < half_dims);
        float r1 = forward ? (xa - xb) : (xb + xa);
        float r2 = forward ? (xc + xd) : (xd - xa);
        rope_store(params.output_offset + out_index, first ? r1 : r2);
      }
    } else {
      i = index % half_dims;
      t = (index / half_dims) % time;
      mat = index / (half_dims * time);
      uint b = mat / heads;
      uint head = mat - b * heads;
      float offset =
          float(offset_data.values[params.rhs_offset + b * params.matrix_m]);
      float position = params.alpha * (float(t) + offset);
#ifdef USE_FREQS
      float inv_freq = 1.0f / freqs_data.values[params.aux_offset + i];
#else
      float inv_freq = exp(-float(i) * params.beta);
#endif
      float theta = position * inv_freq;
      float cos_t = rope_round(omarchy_trig_cos(theta));
      float sin_t = rope_round(omarchy_trig_sin(theta));
      uint in_base;
      if (head_seq_transpose) {
        in_base = b * (time * params.in_strides[1]) +
            t * params.in_strides[1] + head * params.in_strides[0];
      } else {
        in_base = t * params.in_strides[1] + mat * params.in_strides[0];
      }
      uint out_base =
          t * params.out_strides[1] + mat * params.out_strides[0];
      uint in_index_1;
      uint in_index_2;
      uint out_index_1;
      uint out_index_2;
      if (traditional) {
        in_index_1 = in_base + (2u * i) * params.in_strides[2];
        in_index_2 = in_index_1 + params.in_strides[2];
        out_index_1 = out_base + (2u * i) * params.out_strides[2];
        out_index_2 = out_index_1 + params.out_strides[2];
      } else {
        in_index_1 = in_base + i * params.in_strides[2];
        in_index_2 = in_index_1 + half_dims * params.in_strides[2];
        out_index_1 = out_base + i * params.out_strides[2];
        out_index_2 = out_index_1 + half_dims * params.out_strides[2];
      }
      float x1 = rope_load(params.lhs_offset + in_index_1);
      float x2 = rope_load(params.lhs_offset + in_index_2);
      // The eager composition rounds every intermediate to storage precision (one elementwise or cast kernel per op). Reproduce those roundings exactly; float32 storage is transparent.
      float xa = rope_round(x1 * cos_t);
      float xb = rope_round(x2 * sin_t);
      float xc = rope_round(x1 * sin_t);
      float xd = rope_round(x2 * cos_t);
      float r1 = forward ? (xa - xb) : (xb + xa);
      float r2 = forward ? (xc + xd) : (xd - xa);
      rope_store(params.output_offset + out_index_1, r1);
      rope_store(params.output_offset + out_index_2, r2);
    }
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
#endif
}
