#version 460
// qmm_q4_tile with four rows of x a thread, so each weight is dequantized once for four outputs; same sums and order.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

float bf16_value(uint16_t x) {
  return uintBitsToFloat(uint(x) << 16u);
}

void main() {
  uint groups_per_row = params.matrix_k / 64u;
  uint blocks = (params.matrix_m + 3u) / 4u;
  uint total = blocks * params.matrix_n;
  uint stride = gl_NumWorkGroups.x * 256u;
  uint last_row = params.matrix_m - 1u;
  for (uint index = gl_GlobalInvocationID.x; index < total; index += stride) {
    uint block = index / params.matrix_n;
    uint column = index - block * params.matrix_n;
    uint tile = column >> 5u;
    uint lane = column & 31u;
    uint w_base = tile * params.matrix_k + lane;
    uint param_base = tile * (groups_per_row * 32u) + lane;
    uint row_vectors = params.matrix_k / 8u;
    uint x0 = min(block * 4u, last_row) * row_vectors;
    uint x1 = min(block * 4u + 1u, last_row) * row_vectors;
    uint x2 = min(block * 4u + 2u, last_row) * row_vectors;
    uint x3 = min(block * 4u + 3u, last_row) * row_vectors;
    float acc0 = 0.0;
    float acc1 = 0.0;
    float acc2 = 0.0;
    float acc3 = 0.0;
    for (uint group = 0u; group < groups_per_row; ++group) {
      float scale = bf16_value(scales.values[param_base + group * 32u]);
      float bias = bf16_value(biases.values[param_base + group * 32u]);
      for (uint half_group = 0u; half_group < 2u; ++half_group) {
        uvec4 w4 = input_w.values[w_base + (group * 2u + half_group) * 32u];
        for (uint t = 0u; t < 4u; ++t) {
          uint word = w4[t];
          uint at = group * 8u + half_group * 4u + t;
          uvec4 xa = input_x.values[x0 + at];
          uvec4 xb = input_x.values[x1 + at];
          uvec4 xc = input_x.values[x2 + at];
          uvec4 xd = input_x.values[x3 + at];
          for (uint pair = 0u; pair < 4u; ++pair) {
            float low = scale * float((word >> (pair * 8u)) & 0xfu) + bias;
            float high = scale * float((word >> (pair * 8u + 4u)) & 0xfu) + bias;
            acc0 += uintBitsToFloat(xa[pair] << 16u) * low;
            acc0 += uintBitsToFloat(xa[pair] & 0xffff0000u) * high;
            acc1 += uintBitsToFloat(xb[pair] << 16u) * low;
            acc1 += uintBitsToFloat(xb[pair] & 0xffff0000u) * high;
            acc2 += uintBitsToFloat(xc[pair] << 16u) * low;
            acc2 += uintBitsToFloat(xc[pair] & 0xffff0000u) * high;
            acc3 += uintBitsToFloat(xd[pair] << 16u) * low;
            acc3 += uintBitsToFloat(xd[pair] & 0xffff0000u) * high;
          }
        }
      }
    }
    uint row = block * 4u;
    output_data.values[params.output_offset + row * params.matrix_n + column] = bf16_store(acc0);
    if (row + 1u < params.matrix_m) output_data.values[params.output_offset + (row + 1u) * params.matrix_n + column] = bf16_store(acc1);
    if (row + 2u < params.matrix_m) output_data.values[params.output_offset + (row + 2u) * params.matrix_n + column] = bf16_store(acc2);
    if (row + 3u < params.matrix_m) output_data.values[params.output_offset + (row + 3u) * params.matrix_n + column] = bf16_store(acc3);
  }
}
