#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Row gather: for output element gid, id_idx = gid / window selects an id and
// elem = gid % window the column within that row. Out-of-range ids write zero.

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint count;
    uint operation;
    uint lhs_size;
    uint rhs_size;
    uint reduce_size;
    uint output_size;
    uint lhs_offset;
    uint rhs_offset;
    uint output_offset;
    uint aux_size;
    uint aux_offset;
    uint matrix_m;
    uint matrix_n;
    uint matrix_k;
    uint flags;
    float alpha;
    float beta;
    uint dims;
    uint shape[4];
    uint in_strides[4];
    uint out_strides[4];
} params;

#if defined(USE_U32)
layout(set = 0, binding = 0, std430) readonly buffer Table { uint v[]; } table;
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint v[]; } obuf;
#elif defined(USE_U16)
layout(set = 0, binding = 0, std430) readonly buffer Table { uint16_t v[]; } table;
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint16_t v[]; } obuf;
#endif
layout(set = 0, binding = 1, std430) readonly buffer Ids { uint v[]; } ids;

void main() {
    uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint gid = gl_GlobalInvocationID.x; gid < params.count; gid += step) {
        uint id_idx = gid / params.matrix_m;
        uint elem_in_row = gid - id_idx * params.matrix_m;
        uint row = ids.v[params.rhs_offset + id_idx];
#if defined(USE_U32)
        uint val = 0u;
        if (row < params.reduce_size) {
            val = table.v[params.lhs_offset + row * params.matrix_m + elem_in_row];
        }
        obuf.v[params.output_offset + gid] = val;
#elif defined(USE_U16)
        uint16_t val = uint16_t(0u);
        if (row < params.reduce_size) {
            val = table.v[params.lhs_offset + row * params.matrix_m + elem_in_row];
        }
        obuf.v[params.output_offset + gid] = val;
#endif
    }
}
