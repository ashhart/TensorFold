#version 460
// qmm.comp q4 g64 transposed bf16, 16-byte loads, one batch, zero offsets; same arithmetic; see ops_q4.qmmVariant.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

float bf16_value(uint16_t x) {
  return uintBitsToFloat(uint(x) << 16u);
}

void main() {
  uint groups_per_row = params.matrix_k / 64u;
  uint total = params.matrix_m * params.matrix_n;
  uint stride = gl_NumWorkGroups.x * 256u;
  for (uint index = gl_GlobalInvocationID.x; index < total; index += stride) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    uint w_vec = column * (params.matrix_k / 32u);
    uint x_vec = row * (params.matrix_k / 8u);
    uint param_base = column * groups_per_row;
    float accumulator = 0.0;
    for (uint group = 0u; group < groups_per_row; ++group) {
      float scale = bf16_value(scales.values[param_base + group]);
      float bias = bf16_value(biases.values[param_base + group]);
      for (uint half_group = 0u; half_group < 2u; ++half_group) {
        uvec4 w4 = input_w.values[w_vec + group * 2u + half_group];
        for (uint t = 0u; t < 4u; ++t) {
          uint word = w4[t];
          uvec4 x8 = input_x.values[x_vec + group * 8u + half_group * 4u + t];
          for (uint pair = 0u; pair < 4u; ++pair) {
            uint x_pair = x8[pair];
            accumulator += uintBitsToFloat(x_pair << 16u) *
                (scale * float((word >> (pair * 8u)) & 0xfu) + bias);
            accumulator += uintBitsToFloat(x_pair & 0xffff0000u) *
                (scale * float((word >> (pair * 8u + 4u)) & 0xfu) + bias);
          }
        }
      }
    }
    output_data.values[params.output_offset + index] = bf16_store(accumulator);
  }
}
