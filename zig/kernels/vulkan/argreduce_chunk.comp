#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Chunked argmax for the greedy gate: workgroup x owns chunk
// [x*matrix_m, min((x+1)*matrix_m, reduce_size)), 256 threads scan up to 16
// elements each, a shared-memory tree keeps the (val, idx) winner.
// Tie rule: a greater val wins; equal vals (incl. +0 == -0) keep the lowest
// global index.

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint count;
    uint operation;
    uint lhs_size;
    uint rhs_size;
    uint reduce_size;
    uint output_size;
    uint lhs_offset;
    uint rhs_offset;
    uint output_offset;
    uint aux_size;
    uint aux_offset;
    uint matrix_m;
    uint matrix_n;
    uint matrix_k;
    uint flags;
} params;

float bf16_to_f32(uint h) { return uintBitsToFloat((h & 0xffffu) << 16u); }

layout(set = 0, binding = 0, std430) readonly buffer Logits { uint16_t v[]; } lbuf;

struct Partial {
    float val;
    uint idx;
};
layout(set = 0, binding = 1, std430) writeonly buffer Partials { Partial v[]; } pbuf;

shared float svals[256];
shared uint sidxs[256];

void main() {
    const uint lid = gl_LocalInvocationID.x;
    uint start = gl_WorkGroupID.x * params.matrix_m;
    uint end = min(start + params.matrix_m, params.reduce_size);

    float best = -3.4028234663852886e38;
    uint best_idx = 0xffffffffu;
    for (uint i = start + lid; i < end; i += 256u) {
        float v = bf16_to_f32(uint(lbuf.v[i]));
        if (v > best || (v == best && i < best_idx)) {
            best = v;
            best_idx = i;
        }
    }
    svals[lid] = best;
    sidxs[lid] = best_idx;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (lid < st) {
            float ov = svals[lid + st];
            uint oi = sidxs[lid + st];
            if (ov > svals[lid] || (ov == svals[lid] && oi < sidxs[lid])) {
                svals[lid] = ov;
                sidxs[lid] = oi;
            }
        }
        barrier();
    }
    if (lid == 0u) {
        pbuf.v[gl_WorkGroupID.x].val = svals[0];
        pbuf.v[gl_WorkGroupID.x].idx = sidxs[0];
    }
}
