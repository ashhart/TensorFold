#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Elementwise vector add. The BF16->BF16 arms compute the sum exactly in
// integer fixed point (unit = 2^-149) whenever both operands are small enough
// for the result to be an F32 subnormal, so the result matches the host's
// toBf16(fromBf16(a) + fromBf16(b)) bit for bit on ANY driver denorm policy:
// hardware FTZ can only corrupt an F32 add whose true result is subnormal,
// and those operands always take the integer path. PRESERVE_F32 names the
// same denorm-preserving contract and additionally requests the
// OpExecutionMode DenormPreserve (f32) pipeline mode for devices that expose
// shaderDenormPreserveFloat32.

#if defined(PRESERVE_F32)
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 32);
#endif

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint count;
    uint operation;
    uint lhs_size;
    uint rhs_size;
    uint reduce_size;
    uint output_size;
    uint lhs_offset;
    uint rhs_offset;
    uint output_offset;
} params;

float bf16_to_f32(uint h) { return uintBitsToFloat((h & 0xffffu) << 16u); }

uint16_t f32_to_bf16(float x) {
    uint u = floatBitsToUint(x);
    if ((u & 0x7fffffffu) > 0x7f800000u) {
        return uint16_t((u >> 16u) | 0x0040u);
    }
    return uint16_t((u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u);
}

// Exact IEEE add of two BF16 operands; returns the F32 bit pattern of the
// correctly rounded sum. Operands with exponent > 36 can only produce
// normal-range sums (a subnormal sum needs cancellation within ~2^-126,
// impossible when either magnitude exceeds ~2^-86), so they take the
// floating-point path.
uint bf16_add_bits(uint ha, uint hb) {
    uint ea = (ha >> 7u) & 0xffu;
    uint eb = (hb >> 7u) & 0xffu;
    if (ea > 36u || eb > 36u) {
        return floatBitsToUint(bf16_to_f32(ha) + bf16_to_f32(hb));
    }
    uint siga = (ea == 0u) ? (ha & 0x7fu) : (0x80u | (ha & 0x7fu));
    uint sigb = (eb == 0u) ? (hb & 0x7fu) : (0x80u | (hb & 0x7fu));
    // Aligned fixed point, units of 2^(smax-K-F-149) with F fraction bits.
    // The 2^-149-absolute representation this replaces wrapped to zero for
    // exponents >= 9 (siga << (ea+15) exceeds u32). The larger operand's
    // significand sits at bit K+F; the smaller operand's sub-grid bits are a
    // sticky flag; the widest signed sum, 2 * 0xFF << (K+F), stays inside int32.
    const uint K = 14u;
    const uint F = 8u;
    uint sha = (ea == 0u) ? 16u : (ea + 15u);
    uint shb = (eb == 0u) ? 16u : (eb + 15u);
    uint bsig, ssig, d;
    bool bneg, sneg;
    if (sha >= shb) {
        bsig = siga; ssig = sigb; d = sha - shb;
        bneg = (ha & 0x8000u) != 0u; sneg = (hb & 0x8000u) != 0u;
    } else {
        bsig = sigb; ssig = siga; d = shb - sha;
        bneg = (hb & 0x8000u) != 0u; sneg = (ha & 0x8000u) != 0u;
    }
    uint smax = max(sha, shb);
    int vb = int(bsig << (K + F));
    uint kept;
    bool sticky = false;
    if (d <= K + F) {
        kept = ssig << (K + F - d);
    } else if (d <= K + F + 7u) {
        uint r = d - K - F;
        kept = ssig >> r;
        sticky = (ssig & ((1u << r) - 1u)) != 0u;
    } else {
        kept = 0u;
        sticky = ssig != 0u;
    }
    // A truncated operand being subtracted borrows its residue: the floor is
    // one finer unit lower and a residue always remains.
    if (sticky && (bneg != sneg)) kept += 1u;
    int sum = (bneg ? -vb : vb) + (sneg ? -int(kept) : int(kept));
    if (sum == 0) {
        // -0 + -0 -> -0; every other exact-zero sum is +0.
        return ((ha & hb) & 0x8000u) != 0u ? 0x80000000u : 0u;
    }
    uint sgn = (sum < 0) ? 0x80000000u : 0u;
    uint mag = uint(abs(sum));
    int p = findMSB(mag);
    int efield = int(smax) - int(K + F) - 22 + p;
    if (efield < 1) {
        // F32 subnormal: mantissa counts 2^-149 units, i.e. mag scaled by
        // 2^(smax-K-F). Above the grid is exact; below it needs
        // round-half-even. keep == 0x800000 carries into the minimum-normal
        // encoding, which is the same bit pattern.
        int mscale = int(smax) - int(K + F);
        if (mscale >= 0) return sgn | (mag << uint(mscale));
        uint r = uint(-mscale);
        uint keep = mag >> r;
        uint rem = mag & ((1u << r) - 1u);
        uint halfway = 1u << (r - 1u);
        if (rem > halfway || (rem == halfway && (sticky || (keep & 1u) != 0u))) keep += 1u;
        return sgn | keep;
    }
    uint keep = (p >= 23) ? (mag >> uint(p - 23)) : (mag << uint(23 - p));
    uint rem = (p >= 24) ? (mag & ((1u << uint(p - 23)) - 1u)) : 0u;
    uint halfway = (p >= 24) ? (1u << uint(p - 24)) : 1u;
    if (rem > halfway || (rem == halfway && (sticky || (keep & 1u) != 0u))) {
        keep += 1u;
        if (keep == (1u << 24u)) { keep >>= 1u; efield += 1; }
    }
    return sgn | (uint(efield) << 23u) | (keep & 0x7fffffu);
}

#if defined(ACT_F32)
layout(set = 0, binding = 0, std430) readonly buffer A { float v[]; } abuf;
layout(set = 0, binding = 1, std430) readonly buffer B { float v[]; } bbuf;
layout(set = 0, binding = 2, std430) writeonly buffer Out { float v[]; } obuf;
#elif defined(ADD_WIDE)
layout(set = 0, binding = 0, std430) readonly buffer A { float v[]; } abuf;
layout(set = 0, binding = 1, std430) readonly buffer B { uint16_t v[]; } bbuf;
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint16_t v[]; } obuf;
#elif defined(ADD_WIDE_F32)
layout(set = 0, binding = 0, std430) readonly buffer A { uint16_t v[]; } abuf;
layout(set = 0, binding = 1, std430) readonly buffer B { float v[]; } bbuf;
layout(set = 0, binding = 2, std430) writeonly buffer Out { float v[]; } obuf;
#else
layout(set = 0, binding = 0, std430) readonly buffer A { uint16_t v[]; } abuf;
layout(set = 0, binding = 1, std430) readonly buffer B { uint16_t v[]; } bbuf;
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint16_t v[]; } obuf;
#endif

void main() {
    uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += step) {
#if defined(ACT_F32)
        obuf.v[params.output_offset + i] = abuf.v[params.lhs_offset + i] + bbuf.v[params.rhs_offset + i];
#elif defined(ADD_WIDE)
        float s = abuf.v[params.lhs_offset + i] + bf16_to_f32(uint(bbuf.v[params.rhs_offset + i]));
        obuf.v[params.output_offset + i] = f32_to_bf16(s);
#elif defined(ADD_WIDE_F32)
        float s = bf16_to_f32(uint(abuf.v[params.lhs_offset + i])) + bbuf.v[params.rhs_offset + i];
        obuf.v[params.output_offset + i] = s;
#else
        uint sum = bf16_add_bits(uint(abuf.v[params.lhs_offset + i]), uint(bbuf.v[params.rhs_offset + i]));
        obuf.v[params.output_offset + i] = f32_to_bf16(uintBitsToFloat(sum));
#endif
    }
}
