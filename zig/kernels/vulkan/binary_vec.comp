#version 460

// -DPRESERVE_F32: DenormPreserve 4459/32; SPV_KHR_float_controls; cap 4464; shaderDenormPreserveFloat32; signed zero.
#ifdef PRESERVE_F32
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 32);
#endif

#ifdef ACT_F32
// F32 activations: all three buffers are plain vec4.
#define VEC_A vec4
#define VEC_B vec4
#define VEC_OUT vec4
#define LOAD_A(x) (x)
#define LOAD_B(x) (x)
#define STORE_OUT(v) (v)
#elif defined(ADD_WIDE)
// Mixed add: the f32 wide stream adds a bf16 residual and rounds the sum to bf16.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define VEC_A vec4
#define VEC_B u16vec4
#define VEC_OUT u16vec4
#define LOAD_A(x) (x)
#define LOAD_B(x) uintBitsToFloat(uvec4(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_OUT(v) \
  u16vec4(bf16_store(v.x), bf16_store(v.y), bf16_store(v.z), bf16_store(v.w))
#elif defined(ADD_WIDE_F32)
// Mixed add: the bf16 narrow stream joins the f32 wide stream, keeping the f32 sum.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define VEC_A u16vec4
#define VEC_B vec4
#define VEC_OUT vec4
#define LOAD_A(x) uintBitsToFloat(uvec4(x) << 16u)
#define LOAD_B(x) (x)
#define STORE_OUT(v) (v)
#else
#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_VEC f16vec4
#define LOAD_VEC(x) vec4(x)
#define STORE_VEC(v) f16vec4(v)
#else
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_VEC u16vec4
#define LOAD_VEC(x) uintBitsToFloat(uvec4(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VEC(v) \
  u16vec4(bf16_store(v.x), bf16_store(v.y), bf16_store(v.z), bf16_store(v.w))
#endif
#define VEC_A STORAGE_VEC
#define VEC_B STORAGE_VEC
#define VEC_OUT STORAGE_VEC
#define LOAD_A(x) LOAD_VEC(x)
#define LOAD_B(x) LOAD_VEC(x)
#define STORE_OUT(v) STORE_VEC(v)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  VEC_A values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  VEC_B values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  VEC_OUT values[];
} output_data;

// Push constants match elementwise.comp: first nine words are read; count, sizes, offsets are elements divided by four.
layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint vec_count = params.count / 4u;
  uint lhs_vecs = params.lhs_size / 4u;
  uint rhs_vecs = params.rhs_size / 4u;
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < vec_count) {
    uint lhs_index = params.lhs_offset / 4u +
        (lhs_vecs == vec_count ? index : index % lhs_vecs);
    uint rhs_index = params.rhs_offset / 4u +
        (rhs_vecs == vec_count ? index : index % rhs_vecs);
    vec4 lhs = LOAD_A(input_a.values[lhs_index]);
    vec4 rhs = LOAD_B(input_b.values[rhs_index]);
    vec4 value;
    switch (params.operation) {
      case 0u:
        value = lhs + rhs;
        break;
      case 1u:
        value = lhs * rhs;
        break;
      case 2u:
        value = lhs / rhs;
        break;
      default:
        value = lhs - rhs;
        break;
    }
    output_data.values[params.output_offset / 4u + index] = STORE_OUT(value);
    if (vec_count - index <= stride) {
      break;
    }
    index += stride;
  }
}
