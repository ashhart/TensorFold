#version 460

// Clean-room Q4 affine projection (issue #5215): out[m, n] =
// sum_k x[m, k] * (q[n, k] * scale[n, k / 64] + bias[n, k / 64]) in float32.
// Behaviour from spec-qmm-q4-4.md; ABI from zig/src/vulkan/ops_q4.zig.

// BF16 halves are addressed through uint16_t buffer views.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Activations and outputs are BF16 unless -DACT_F32 selects float32 for both.
#ifdef ACT_F32
#define ACT_TYPE float
#define ACT_READ(v) (v)
#define ACT_WRITE(f) (f)
#else
#define ACT_TYPE uint16_t
#define ACT_READ(v) uintBitsToFloat(uint(v) << 16u)
#define ACT_WRITE(f) bf16_store(f)

// Round-to-nearest-even f32 -> bf16: add 0x7fff + the kept lsb, then truncate;
// a NaN keeps its class with the quiet bit set.
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16u) | 0x0040u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
}
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  ACT_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  ACT_TYPE values[];
} output_data;

layout(push_constant, std430) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} p;

void main() {
  uint tid = gl_GlobalInvocationID.x;
  if (tid >= p.count) {
    return;
  }
  uint m = tid / p.matrix_n;
  uint n = tid % p.matrix_n;

  uint row_words = p.matrix_k / 8u;   // 8 codes per uint weight word
  uint row_groups = p.matrix_k / 64u; // one scale and bias per 64 codes
  uint x_base = p.lhs_offset + m * p.matrix_k;
  uint w_base = p.rhs_offset + n * row_words;
  uint sb_base = p.aux_offset + n * row_groups;

  float acc = 0.0;
  for (uint g = 0u; g < row_groups; ++g) {
    float s = uintBitsToFloat(uint(scales.values[sb_base + g]) << 16u);
    float b = uintBitsToFloat(uint(biases.values[sb_base + g]) << 16u);
    for (uint i = 0u; i < 8u; ++i) {
      uint word = input_w.values[w_base + g * 8u + i];
      for (uint j = 0u; j < 8u; ++j) {
        float xv = ACT_READ(input_x.values[x_base + g * 64u + i * 8u + j]);
        // Dequantized weight per code: x * (q * s + b). The factored form
        // s*sum(x*q) + b*sum(x) turns (inf, q=0) into NaN where this gives inf.
        acc += xv * (float((word >> (4u * j)) & 0xfu) * s + b);
      }
    }
  }
  output_data.values[p.output_offset + m * p.matrix_n + n] = ACT_WRITE(acc);
}
