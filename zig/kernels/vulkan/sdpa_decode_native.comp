//  Single-query SDPA in native Metal's decode arithmetic order (mlx/backend/metal/kernels/sdpa_vector.h). One 1024-thread workgroup owns one query head. Short and mid decode reproduce sdpa_vector's 32 interleaved online streams and final SIMD reduction. At native's long-context crossover the route switches to the native-shape two-pass pair (sdpa_decode_native_p1.comp + _p2.comp), so this kernel always runs the one-pass 32-stream decode; its former in-workgroup 64/128-block two-pass moved to that pair.
//  The bf16 compile (-DBF16_IO) does not ride that structure. Its parity contract is the f32-score composition, so it reproduces the composition's observable arithmetic exactly - matmul.comp's per-dot accumulation order, softmax_suffix.comp's max/exp/sum/normalize sequence over stored f32 scores, one f32 q*scale, and a single RNE bf16 output store - making the route bit-identical to the ten-dispatch path it replaces. See the comment above main().

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef BF16_IO
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
#ifdef BF16_IO
// bf16 storage rides a uint16 word view: loads widen exactly (the bf16 bits are the f32 top half), stores round-to-nearest-even like every other USE_BF16 leg (cast.comp).
layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uint16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uint16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#else
layout(set = 0, binding = 0, std430) readonly buffer Query {
  float16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  float16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  float16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  float16_t values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint SIMD = 32u;
const float FINITE_MIN = -3.4028234663852886e38;

// Query-head width. The default 64 keeps the original blobs; -DSDPA_DIM=N compiles the wider twins. In the bf16 arm N is any multiple of 32 up to 256 - every width runs the identical f32 score-composition sequence (ascending-d dot, 256-lane softmax, ascending-key 16-wide output tiles), so the route is bit-identical to the composed path it replaces at every width; only the per-dot length and the output thread count scale. In the f16 arm each lane covers SDPA_DIM/64 consecutive dim pairs (the 64-wide simdgroup mapping applied PAIRS times), so N must be a multiple of 64; the native 32-interleaved-stream order and its merge are unchanged per pair.
#ifndef SDPA_DIM
#define SDPA_DIM 64u
#endif
const uint PAIRS = SDPA_DIM / 64u;

#ifndef BF16_IO
shared float s_outputs[SIMD * SIMD];
shared float s_max[SIMD];
shared float s_sum[SIMD];
#else
// The composition-exact arm replaces the online-softmax structure with the f32-score composition's observable arithmetic. Scores and probs share one f32 stream (probs overwrite scores in place; the normalize pass reads and writes only its own strided slots). The kStreamKeys bound is enforced by the host guard; larger contexts fall through to the composition, which this arm reproduces bit for bit.
const uint kStreamKeys = 7168u;
shared float s_qrow[SDPA_DIM];
shared float s_stream[kStreamKeys];
shared float s_tree[256];
#endif

float native_exp(float x) {
  return exp(x);
}

#ifdef BF16_IO
// The cast.comp conversion pair, verbatim: exact widening in, RNE out.
float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define LD16(x) bf16_load(x)
#else
#define LD16(x) float(x)
#endif

void store_pair(
    uint head,
    uint lane,
    uint pair,
    float x,
    float y,
    float denominator) {
  if (lane == 0u) {
    uint out_base = params.output_offset + head * SDPA_DIM +
        pair * 64u + 2u * gl_SubgroupID;
#ifdef BF16_IO
    output_data.values[out_base] = bf16_store(x / denominator);
    output_data.values[out_base + 1u] = bf16_store(y / denominator);
#else
    output_data.values[out_base] = float16_t(x / denominator);
    output_data.values[out_base + 1u] = float16_t(y / denominator);
#endif
  }
}

void main() {
#ifdef BF16_IO
  // ------------------------------------------------------------------ The composition-exact bf16 arm. Every operation below reproduces the f32-score composition's observable arithmetic in the same order, so the route is bit-identical to the ten-dispatch path it replaces and no generated token can move: 1. q*scale once in f32 (the composition's elementwise multiply; the matmul alpha is 1.0 and its drain multiplies by it), 2. scores = per-dot ascending-d `acc += a * b` accumulation over 16-wide tiles with exact-zero tail padding, drained by 1.0f, stored f32 (matmul.comp), 3. softmax: 256-lane strided max scan + binary max tree, strided sequential exp-sum per lane + binary sum tree, normalizer 1.0/sum, probs = exp(score - max) * normalizer recomputed from the stored f32 scores (softmax_suffix.comp), 4. output = ascending-key `acc += a * b` over 16-wide tiles with exact-zero tail padding, drained by 1.0f (matmul.comp), stored through the cast.comp RNE bf16 pair. Threads 256..1023 share every barrier but do no phase work; the reduction trees only involve lanes 0..255, exactly as the 256-thread softmax kernel computes them. ------------------------------------------------------------------
  uint thread = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint k_len = params.matrix_k;
  // Batched decode: workgroup z is the batch row. Element offsets of that row: q out_strides[2], k lhs_size, v rhs_size, out out_strides[3] (all zero at batch 0, so a single-row dispatch reads what it always did).
  uint batch = gl_WorkGroupID.z;
  uint q_batch = params.lhs_offset + batch * params.out_strides[2];
  uint k_batch = params.rhs_offset + batch * params.lhs_size;
  uint v_batch = params.aux_offset + batch * params.rhs_size;
  uint o_batch = params.output_offset + batch * params.out_strides[3];
#ifdef SDPA_ROWS
  // Multi-token verify rows: workgroup (head, row). The row's causal bound turns every scan below into exactly the single-query arm's arithmetic over the row's visible key prefix (keys 0..key_end-1), so each row is bit-identical to that row decoded alone at q_len=1 with the same cache prefix. params.dims carries q_len, out_strides[0] the q row stride; out and q share the head stride (shape[0]).
  uint row = gl_WorkGroupID.y;
  uint key_end = params.matrix_k - params.dims + row + 1u;
#else
  uint row = 0u;
  uint key_end = params.matrix_k;
#endif

  if (thread < SDPA_DIM) {
#ifdef SDPA_ROWS
    s_qrow[thread] = params.alpha * bf16_load(
        query_data.values[q_batch + head * params.shape[0] +
            row * params.out_strides[0] + thread * params.shape[3]]);
#else
    s_qrow[thread] = params.alpha * bf16_load(
        query_data.values[q_batch +
            head * params.shape[0] + thread * params.shape[3]]);
#endif
  }
  barrier();

  // Scores over every key: ascending-d accumulation, matmul.comp order.
  for (uint key = thread; key < key_end; key += 1024u) {
    uint k_base = k_batch + kv_head * params.shape[1] +
        key * params.shape[2];
    float accumulator = 0.0;
    // Loads are independent of the accumulator chain: issue 16 K elements before the 16 in-order FMAs (same expression order, bit-identical).
    for (uint d = 0u; d < SDPA_DIM; d += 16u) {
      float kv[16];
      for (uint i = 0u; i < 16u; ++i) {
        kv[i] = bf16_load(key_data.values[k_base + (d + i) * params.in_strides[0]]);
      }
      for (uint i = 0u; i < 16u; ++i) {
        accumulator += s_qrow[d + i] * kv[i];
      }
    }
    s_stream[key] = 1.0 * accumulator;
  }
  barrier();

  // Row max: strided scan then the 256-lane binary tree.
  if (thread < 256u) {
    float local_max = uintBitsToFloat(0xff800000u);
    for (uint index = thread; index < key_end; index += 256u) {
      float next = s_stream[index];
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    s_tree[thread] = local_max;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] = max(s_tree[thread], s_tree[thread + stride]);
    }
    barrier();
  }
  float row_max = s_tree[0];
  barrier();

  // Denominator: strided sequential exp-sum per lane, then the tree.
  if (thread < 256u) {
    float local_sum = 0.0;
    for (uint index = thread; index < key_end; index += 256u) {
      local_sum += exp(s_stream[index] - row_max);
    }
    s_tree[thread] = local_sum;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] += s_tree[thread + stride];
    }
    barrier();
  }
  float normalizer = 1.0 / s_tree[0];
  barrier();

  // Probs in place: exp recomputed from the stored f32 scores, exactly as the normalize pass of softmax_suffix.comp does.
  if (thread < 256u) {
    for (uint index = thread; index < key_end; index += 256u) {
      s_stream[index] = exp(s_stream[index] - row_max) * normalizer;
    }
  }
  barrier();

  // Output dim d: ascending-key accumulation over 16-wide tiles with exact-zero tail padding, drained by 1.0f, stored RNE bf16.
  if (thread < SDPA_DIM) {
    uint d = thread;
    float accumulator = 0.0;
    uint key = 0u;
    uint v_base = v_batch + kv_head * params.in_strides[1] +
        d * params.in_strides[3];
    // Whole 16-key tiles: 16 independent V loads first, then the 16 in-order FMAs (a 64-key block spilled the load registers and was 9x slower).
    for (; key + 16u <= key_end; key += 16u) {
      float vv[16];
      for (uint index = 0u; index < 16u; ++index) {
        vv[index] = bf16_load(
            value_data.values[v_base + (key + index) * params.in_strides[2]]);
      }
      for (uint index = 0u; index < 16u; ++index) {
        accumulator += s_stream[key + index] * vv[index];
      }
    }
    for (uint index = 0u; index < 16u; ++index) {
      float prob = key < key_end ? s_stream[key] : 0.0;
      float value16 = key < key_end ? bf16_load(
          value_data.values[v_batch +
              kv_head * params.in_strides[1] +
              key * params.in_strides[2] +
              d * params.in_strides[3]]) : 0.0;
      accumulator += prob * value16;
      ++key;
    }
#ifdef SDPA_ROWS
    // Row stride is a push constant, not hardwired SDPA_DIM: the dense Qwen3.5 oracle stores y row-major as (rows, 8, 256), so the row stride is heads*SDPA_DIM (2048), not SDPA_DIM. Same change class as the q read above, which already takes out_strides[0].
    output_data.values[o_batch + head * params.shape[0] +
        row * params.out_strides[0] + d] = bf16_store(1.0 * accumulator);
#else
    output_data.values[o_batch + head * SDPA_DIM + d] =
        bf16_store(1.0 * accumulator);
#endif
  }
  return;
#else
  uint lane = gl_SubgroupInvocationID;
  uint sgid = gl_SubgroupID;
  uint head = gl_WorkGroupID.x;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint q_base = params.lhs_offset + head * params.shape[0];
  uint q_dim = 2u * lane;
  float q0[PAIRS];
  float q1[PAIRS];
  for (uint p = 0u; p < PAIRS; ++p) {
    q0[p] = params.alpha *
        LD16(query_data.values[q_base + (p * 64u + q_dim) * params.shape[3]]);
    q1[p] = params.alpha * LD16(
        query_data.values[q_base + (p * 64u + q_dim + 1u) * params.shape[3]]);
  }

  // Native sdpa_vector: each SIMD owns keys sgid, sgid+32, ... and keeps an independent online-softmax state before the 32 states are merged. The score dot runs ascending-d across the lane's dim pairs, so PAIRS=1 is the original two-fma sequence verbatim.
  float max_score = FINITE_MIN;
  float sum_exp_score = 0.0;
  float o0[PAIRS];
  float o1[PAIRS];
  for (uint p = 0u; p < PAIRS; ++p) {
    o0[p] = 0.0;
    o1[p] = 0.0;
  }
  for (uint key = sgid; key < params.matrix_k; key += SIMD) {
    uint k_base = params.rhs_offset + kv_head * params.shape[1] +
        key * params.shape[2] + q_dim * params.in_strides[0];
    float score = 0.0;
    for (uint p = 0u; p < PAIRS; ++p) {
      score = fma(
          q0[p],
          LD16(key_data.values[k_base + p * 64u * params.in_strides[0]]),
          score);
      score = fma(
          q1[p],
          LD16(key_data.values[
              k_base + (p * 64u + 1u) * params.in_strides[0]]),
          score);
    }
    score = subgroupAdd(score);
    float new_max = max(max_score, score);
    float factor = native_exp(max_score - new_max);
    float exp_score = native_exp(score - new_max);
    max_score = new_max;
    sum_exp_score = fma(sum_exp_score, factor, exp_score);
    uint v_base = params.aux_offset + kv_head * params.in_strides[1] +
        key * params.in_strides[2] + q_dim * params.in_strides[3];
    for (uint p = 0u; p < PAIRS; ++p) {
      o0[p] = fma(
          o0[p],
          factor,
          exp_score * LD16(value_data.values[
              v_base + p * 64u * params.in_strides[3]]));
      o1[p] = fma(
          o1[p],
          factor,
          exp_score * LD16(value_data.values[
              v_base + (p * 64u + 1u) * params.in_strides[3]]));
    }
  }

  if (lane == 0u) {
    s_max[sgid] = max_score;
    s_sum[sgid] = sum_exp_score;
  }
  barrier();
  max_score = s_max[lane];
  float merged_max = subgroupMax(max_score);
  float factor = native_exp(max_score - merged_max);
  float denominator = subgroupAdd(s_sum[lane] * factor);

  for (uint p = 0u; p < PAIRS; ++p) {
    s_outputs[lane * SIMD + sgid] = o0[p];
    barrier();
    float merged0 = subgroupAdd(s_outputs[sgid * SIMD + lane] * factor);
    barrier();
    s_outputs[lane * SIMD + sgid] = o1[p];
    barrier();
    float merged1 = subgroupAdd(s_outputs[sgid * SIMD + lane] * factor);
    store_pair(head, lane, p, merged0, merged1, denominator);
    // The next pair's write must not start before this pair's read ends.
    barrier();
  }
#endif
}
