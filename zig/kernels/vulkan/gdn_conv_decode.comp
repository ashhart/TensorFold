#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Single-step depthwise conv for GDN decode: per channel, convolve the
// [3, C] state plus the new x row through the [C, 4] taps, write the activated
// value, then shift the state left one row (bit-exact transport).

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint count;
    uint operation;
    uint lhs_size;
    uint rhs_size;
    uint reduce_size;
    uint output_size;
    uint lhs_offset;
    uint rhs_offset;
    uint output_offset;
    uint aux_size;
    uint aux_offset;
    uint matrix_m;
    uint matrix_n;
    uint matrix_k;
    uint flags;
} params;

float bf16_to_f32(uint h) { return uintBitsToFloat((h & 0xffffu) << 16u); }

uint16_t f32_to_bf16(float x) {
    uint u = floatBitsToUint(x);
    if ((u & 0x7fffffffu) > 0x7f800000u) {
        return uint16_t((u >> 16u) | 0x0040u);
    }
    return uint16_t((u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u);
}

layout(set = 0, binding = 0, std430) readonly buffer StateIn { uint16_t v[]; } sinbuf;
layout(set = 0, binding = 1, std430) readonly buffer X { uint16_t v[]; } xbuf;
layout(set = 0, binding = 2, std430) readonly buffer W { uint16_t v[]; } wbuf;
layout(set = 0, binding = 3, std430) writeonly buffer Act { uint16_t v[]; } abuf;
layout(set = 0, binding = 4, std430) writeonly buffer StateOut { uint16_t v[]; } soutbuf;

void main() {
    const uint C = params.reduce_size;
    const uint taps = params.operation;
    uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint ch = gl_GlobalInvocationID.x; ch < params.count; ch += step) {
        float acc = 0.0;
        for (uint k = 0u; k < taps; ++k) {
            float s = (k + 1u < taps)
                ? bf16_to_f32(uint(sinbuf.v[k * C + ch]))
                : bf16_to_f32(uint(xbuf.v[ch]));
            acc += s * bf16_to_f32(uint(wbuf.v[ch * taps + k]));
        }
        if ((params.flags & 1u) != 0u) {
            acc = acc / (1.0 + exp(-acc));
        }
        if ((params.flags & 2u) != 0u) {
            // Optional per-channel norm arm; callers pin flags to 0/1, so the
            // arm is intentionally inert until a caller defines its contract.
        }
        abuf.v[params.output_offset + ch] = f32_to_bf16(acc);
        for (uint k = 0u; k + 1u < taps; ++k) {
            soutbuf.v[k * C + ch] = sinbuf.v[(k + 1u) * C + ch];
        }
        soutbuf.v[(taps - 1u) * C + ch] = xbuf.v[ch];
    }
}
