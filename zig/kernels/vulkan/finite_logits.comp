// Finite scan for the stage-2 greedy draw, phase 0 of the argreduce pipeline.
// One pass over one BF16 logits row: sets word 0 to nonzero when ANY element
// is NaN or infinity (winner or not — the Ash q.backend.draw rule rejects the
// whole row) and word 1 to the lowest index of the first offending element.
// All three result words are device-filled per call (flag 0, first_bad and
// index 0xffffffff), so the atomics accumulate one clean row's verdict and an
// unwritten token can never pass. The argreduce phase behind this scan
// carries mlx NaN-wins semantics, which is unreachable here: with the flag
// clear no NaN exists in the row, so its strict-compare, lowest-index tie rule
// (identical to the draw rule for finite values, +0/-0 included) decides.
//
// Coverage mirrors argreduce_chunk.comp: 256 lanes x 16 values = one 4096-wide
// window per workgroup, so the greedy host dispatches the same group count for
// both phases. Grid: x = ceil(count / 4096) (at most 256).
#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  uint16_t values[];
} input_data;
layout(set = 0, binding = 1, std430) buffer Results {
  uint finite_flag;
  uint first_bad;
} results;

layout(push_constant) uniform Params {
  uint count;
} params;

shared uint block_bad[256];
shared uint block_flags[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint begin = gl_WorkGroupID.x * 4096u;
  uint end = min(begin + 4096u, params.count);
  // Non-finite BF16: exponent all ones — 0x7f80 is +/-inf, 0x7f81..0x7fff NaN,
  // the sign bit rides in front of both. Every finite value stays below.
  uint local_bad = 0xffffffffu;
  uint local_flag = 0u;
  for (uint k = 0u; k < 16u; ++k) {
    uint index = begin + thread + k * 256u;
    if (index < end) {
      uint bits = uint(input_data.values[index]);
      if ((bits & 0x7fffu) >= 0x7f80u) {
        local_flag = 1u;
        local_bad = min(local_bad, index);
      }
    }
  }
  block_bad[thread] = local_bad;
  block_flags[thread] = local_flag;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_bad[thread] = min(block_bad[thread], block_bad[thread + stride]);
      block_flags[thread] = block_flags[thread] | block_flags[thread + stride];
    }
    barrier();
  }
  if (thread == 0u) {
    // Clean workgroups contribute (0, 0xffffffff): no-ops on both words.
    atomicOr(results.finite_flag, block_flags[0]);
    atomicMin(results.first_bad, block_bad[0]);
  }
}
