// This reuses mlx-omarchy shaders/argreduce_combine.comp (MIT) for operation = 1 (max), one row, output_offset = 2.

// Preserve the omitted contract, precision, and host-interface facts from the original comment.
#version 460
#define ACC_LOWEST uintBitsToFloat(0xff800000u)
#define ACC_HIGHEST uintBitsToFloat(0x7f800000u)

layout(local_size_x = 256) in;

struct Partial {
  float value;
  uint index;
};

layout(set = 0, binding = 0, std430) readonly buffer Partials {
  Partial values[];
} partial_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
} params;

shared float block_values[256];
shared uint block_indices[256];

bool challenges_at(
    float next, float incumbent, uint next_index, uint incumbent_index,
    bool is_max) {
  return isnan(next)
      ? (!isnan(incumbent) || next_index < incumbent_index)
      : (!isnan(incumbent) &&
         ((is_max ? next > incumbent : next < incumbent) ||
          (next == incumbent && next_index < incumbent_index)));
}

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint chunks = params.matrix_n;
  bool is_max = params.operation == 1u;
  float never = is_max ? ACC_LOWEST : ACC_HIGHEST;
  uint row = gl_WorkGroupID.x;
  float value = never;
  uint index = 0u;
  if (thread < chunks) {
    Partial p = partial_data.values[row * chunks + thread];
    value = p.value;
    index = p.index;
  }
  block_values[thread] = value;
  block_indices[thread] = index;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      float mine = block_values[thread];
      float theirs = block_values[thread + stride];
      if (challenges_at(
              theirs, mine, block_indices[thread + stride],
              block_indices[thread], is_max)) {
        block_values[thread] = theirs;
        block_indices[thread] = block_indices[thread + stride];
      }
    }
    barrier();
  }
  if (thread == 0u) {
    output_data.values[params.output_offset + row] = block_indices[0];
  }
}
