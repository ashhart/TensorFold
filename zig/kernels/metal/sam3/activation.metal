inline float sam_gelu_fp32(float value) {
    const uint bits = as_type<uint>(value), magnitude = bits & 0x7fffffffu, sign = bits & 0x80000000u;
    if (magnitude >= 0x7f800000u) return magnitude > 0x7f800000u ? value + value : sign ? NAN : value;
    if (magnitude < 0x24800000u) {
        if (magnitude >= 0x01000000u) return as_type<float>(sign | (magnitude - 0x00800000u));
        const uint significand = (magnitude & 0x7fffffu) | (magnitude >= 0x00800000u ? 0x00800000u : 0);
        return as_type<float>(sign | ((significand >> 1) + uint((significand & 3u) == 3u)));
    }
    const float absolute = as_type<float>(magnitude);
    const float2 coordinate(absolute * 0.70710678118654752f, 0);
    if (coordinate.x >= 6) return sign ? as_type<float>(0x80000000u) : value;
    const ushort piece = min(ushort(fma(coordinate.x, 32.0f, 0.5f)), ushort(192));
    float2 offset = sam_two_sum(coordinate.x, -float(piece) * 0.03125f);
    sam_pair_add(offset, coordinate.y);
    float polynomial = sam_erfc_coefficients[piece][5].x;
    float low_polynomial = sam_erfc_coefficients[piece][5].y;
    float derivative = 5.0f * polynomial;
    TF_UNROLL
    for (short power = 4; power >= 1; --power) {
        polynomial = fma(polynomial, offset.x, sam_erfc_coefficients[piece][power].x);
        low_polynomial = fma(low_polynomial, offset.x, sam_erfc_coefficients[piece][power].y);
        derivative = fma(derivative, offset.x, float(power) * sam_erfc_coefficients[piece][power].x);
    }
    const float product = polynomial * offset.x;
    float2 result = sam_two_sum(sam_erfc_coefficients[piece][0].x, product);
    sam_pair_add(result, fma(polynomial, offset.x, -product));
    sam_pair_add(result, sam_erfc_coefficients[piece][0].y);
    sam_pair_add(result, low_polynomial * offset.x);
    sam_pair_add(result, derivative * offset.y);
    float2 complement = sam_two_sum(1.0f, -result.x);
    sam_pair_add(complement, -result.y);
    const float inner = sign ? -(complement.x + complement.y) : complement.x + complement.y;
    return 0.5f * value * (1.0f + inner);
}

[[kernel, max_total_threads_per_threadgroup(256)]]
void im_sam_gelu(const device float* input, device float* output, constant uint& count,
    uint at [[thread_position_in_grid]]) {
    if (at < count) output[at] = sam_gelu_fp32(input[at]);
}
