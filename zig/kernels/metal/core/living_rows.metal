    constant LwParams& p [[buffer(11)]],uint id [[thread_position_in_grid]]) { \
    LwParams call=p; call.u[14]=control; \
    if(control==3 && id+1==call.u[15])return; \
    lw_rows(op,id,call,a,b,c,d,e,f,g,h,x,y,z); }
