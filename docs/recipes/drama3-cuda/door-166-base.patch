-/// One bf16 step at |v|: the most an f32 sum's last bit can move a bf16-rounded result.
-fn ulp(v: f64) f64 {
-    return if (v == 0) 0x1p-133 else std.math.ldexp(@as(f64, 1), std.math.ilogb(@abs(v)) - 7);
