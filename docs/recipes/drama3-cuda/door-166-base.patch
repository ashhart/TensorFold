-/// nvfp4_experts.cu's SwiGLU epilogue, stored as bf16: bf16(bf16(silu(bf16(g))) * bf16(u)).
-fn servedSwiglu(g: f32, u: f32) f32 {
-    const gv = bf(g);
-    return bf(bf(gv / (1 + @exp(-gv))) * bf(u));
-}
