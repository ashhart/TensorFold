-/// Round to nearest even bf16 by the integer trick the kernels' __float2bfloat16_rn performs.
-fn bf(x: f32) f32 {
-    const b: u32 = @bitCast(x);
-    return @bitCast((b +% 0x7fff +% ((b >> 16) & 1)) & 0xffff0000);
-}
