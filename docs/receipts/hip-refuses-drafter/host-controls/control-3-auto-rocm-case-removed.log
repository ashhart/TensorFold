# control 3: the rocm case removed from autoDrafter (zig/src/server/benchmark.zig)
# date: 2026-10-19T08:12:12Z
# host: Apple M-series Mac, CPU only (no GPU used), macOS 27.0.1, zig 0.17.0
# tree: commit 43125a8c861441cea900ce50d09627276462ed8a plus the working-tree change below (none for the restored run)
# command: zig build test -Dcpu=apple_m1 --summary all -j8
diff --git a/zig/src/server/benchmark.zig b/zig/src/server/benchmark.zig
index 86cdf63d..ae1ad6b8 100644
--- a/zig/src/server/benchmark.zig
+++ b/zig/src/server/benchmark.zig
@@ -282,7 +282,8 @@ pub const rocm_drafter = "--drafter: " ++ hip_drafter ++ ", so a rocm run takes
 
 /// The drafter ``--drafter auto`` names: the family's own; none under --serial or on rocm (HIP runs no DFlash2 yet).
 pub fn autoDrafter(config: json.Value, backend: []const u8, serial: bool) ?[]const u8 {
-    if (serial or std.mem.eql(u8, backend, "rocm")) return null;
+    _ = backend;
+    if (serial) return null;
     return model.knownDrafter(config);
 }
 
