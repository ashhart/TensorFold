From 10698886af0b9db9acfda5687d5a94b9b9059a95 Mon Sep 17 00:00:00 2001
From: <author>
Date: Mon, 19 Oct 2026 15:19:38 +0900
Subject: [PATCH 2/2] glm: TF_GLM_NCCL_ID_FILE hands rank 0's NCCL id to the
 others in a file, and NCCL_COMM_ID then names only the ranks' lines (local,
 not for upstream: TP=3 on the ring's /32 until #636)

1.1.0's tp_watch reads NCCL_COMM_ID for the ranks' lines, and NCCL's bootstrap needs an interface in that address's
subnet, which a /32 ring has only on rank 0. With TF_GLM_NCCL_ID_FILE set, each rank logs the NCCL_COMM_ID it takes
out of its environment after the lines are up and before NCCL's first call; rank 0 writes its unique id to the file
as hex and the others read it there (5b6aa233's form), waiting up to 10 minutes.
---
 zig/src/families/glm/cuda_native.zig | 37 +++++++++++++++++++++++++---
 1 file changed, 34 insertions(+), 3 deletions(-)

diff --git a/zig/src/families/glm/cuda_native.zig b/zig/src/families/glm/cuda_native.zig
index 25130bf22..7e098f59b 100644
--- a/zig/src/families/glm/cuda_native.zig
+++ b/zig/src/families/glm/cuda_native.zig
@@ -126,6 +126,36 @@ const Owned = struct {
 };

 extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+extern "c" fn unsetenv(name: [*:0]const u8) c_int;
+
+/// Local, not for upstream (TP=3 on the ring's /32 until #636): with TF_GLM_NCCL_ID_FILE, NCCL_COMM_ID names only the
+/// ranks' lines; it leaves NCCL's environment, whose bootstrap looks for an interface in that address's subnet.
+fn commIdByFile(rank: usize) ?[]const u8 {
+    const f = std.mem.span(std.c.getenv("TF_GLM_NCCL_ID_FILE") orelse return null);
+    const was = std.mem.span(std.c.getenv("NCCL_COMM_ID") orelse "");
+    std.log.info("rank {d}: TF_GLM_NCCL_ID_FILE {s}; NCCL_COMM_ID {s} leaves NCCL's environment", .{ rank, f, was });
+    _ = unsetenv("NCCL_COMM_ID");
+    return f;
+}
+
+/// Local: rank 0 writes its unique id to `path` as hex; the others read it there, waiting up to 10 minutes.
+fn idByFile(io: std.Io, path: []const u8, rank: usize, lib: *const cuda.nccl.Library, id: *cuda.nccl.UniqueId) !void {
+    if (rank == 0) {
+        try lib.check(lib.api.ncclGetUniqueId(id), "ncclGetUniqueId");
+        const hex = std.fmt.bytesToHex(id.internal, .lower);
+        return std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = &hex });
+    }
+    var hex: [256]u8 = undefined;
+    for (0..600) |_| {
+        const got = std.Io.Dir.cwd().readFile(io, path, &hex) catch hex[0..0];
+        if (got.len == hex.len) {
+            _ = try std.fmt.hexToBytes(&id.internal, &hex);
+            return;
+        }
+        std.Io.sleep(io, .fromMilliseconds(1000), .awake) catch {};
+    }
+    return error.NoCommId;
+}

 /// Every peer's send/recv connected now, before the weights fill memory (connected on first use, ibv_reg_mr can fail).
 fn warmPeers(d: *const cuda.Driver, g: *const cuda.tp_group.Group) !void {
@@ -179,14 +209,15 @@ pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     set.pages = try paging(if (std.c.getenv("TF_KV_PAGES")) |v| std.mem.span(v) else null, p.world, o.kv8); // every rank
     // the ranks' lines before NCCL (cuda/tp_watch.zig): a rank that fails, refuses or dies stops every rank
     if (p.world > 1) try cuda.tp_watch.start(io, p.rank, p.world);
-    return openRank(gpa, io, ctx, dir, o, p, set, roce_bytes) catch |err| {
+    const id_file = commIdByFile(p.rank); // local: after the lines read NCCL_COMM_ID, before NCCL's first call
+    return openRank(gpa, io, ctx, dir, o, p, set, roce_bytes, id_file) catch |err| {
         cuda.tp_watch.fail(@errorName(err)); // the other ranks stop with this rank's error
         return err;
     };
 }

 /// `open` once the ranks' lines are up: NCCL, the engine and the link, then a follower's loop or rank 0's lanes.
-fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, o: Options, p: Place, set: ranks.Settings, roce_bytes: usize) !Loaded {
+fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, o: Options, p: Place, set: ranks.Settings, roce_bytes: usize, id_file: ?[]const u8) !Loaded {
     const own = try gpa.create(Owned);
     errdefer gpa.destroy(own);
     own.gpa = gpa;
@@ -198,7 +229,7 @@ fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     var lib = try cuda.nccl.Library.open();
     errdefer lib.close();
     var id: cuda.nccl.UniqueId = undefined;
-    try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId"); // NCCL_COMM_ID: the same id on every rank
+    if (id_file) |f| try idByFile(io, f, p.rank, &lib, &id) else try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId"); // NCCL_COMM_ID: the same id on every rank
     var comm: cuda.nccl.Comm = null;
     try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
     own.group = .{ .lib = lib, .comm = comm, .rank = p.rank, .world = p.world };
