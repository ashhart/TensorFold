new file mode 100644
--- /dev/null
+++ b/zig/src/families/glm/cuda_route_prof.zig
@@ -0,0 +1,166 @@
+//! Opt-in decode routing receipts: bounded device snapshots, read only after the forward's existing completion wait.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const max_layers = 64;
+pub const max_rows = 32;
+pub const max_slots = 17;
+pub const max_experts = 1024;
+const capacity = max_layers * max_rows * max_slots;
+
+pub const Meta = struct {
+    rank: usize,
+    layer: usize,
+    context_min: usize,
+    context_max: usize,
+    streams: usize = 1,
+};
+
+pub const Shape = struct { rows: usize, slots: usize, experts: usize };
+pub const Stats = struct {
+    unique: usize = 0,
+    pairs: usize = 0,
+    // hist[n] counts experts selected by n rows, excluding the shared expert and unselected experts.
+    hist: [max_rows + 1]usize = @splat(0),
+};
+
+fn valid(s: Shape) bool {
+    return s.rows > 0 and s.rows <= max_rows and s.slots >= 2 and s.slots <= max_slots and
+        s.experts > 0 and s.experts <= max_experts and s.slots - 1 <= s.experts;
+}
+
+/// A host reference over the untouched router's picks; duplicates and malformed shared slots invalidate the receipt.
+pub fn summarize(s: Shape, picks: []const i32) error{BadRouteReceipt}!Stats {
+    if (!valid(s) or picks.len != s.rows * s.slots) return error.BadRouteReceipt;
+    var counts: [max_experts]u8 = @splat(0);
+    const expert_count: i32 = @intCast(s.experts);
+    var out: Stats = .{ .pairs = s.rows * (s.slots - 1) };
+    for (0..s.rows) |r| {
+        const row = picks[r * s.slots ..][0..s.slots];
+        if (row[s.slots - 1] != expert_count) return error.BadRouteReceipt;
+        for (row[0 .. s.slots - 1], 0..) |id, j| {
+            if (id < 0 or id >= expert_count) return error.BadRouteReceipt;
+            for (row[0..j]) |old| if (old == id) return error.BadRouteReceipt;
+            counts[@intCast(id)] += 1;
+        }
+    }
+    for (counts[0..s.experts]) |n| if (n > 0) {
+        out.unique += 1;
+        out.hist[n] += 1;
+    };
+    return out;
+}
+
+const Record = struct { meta: Meta, shape: Shape, offset: usize };
+
+pub const Trace = struct {
+    device: cuda.DeviceBuffer,
+    host: [capacity]i32 = undefined,
+    records: [max_layers]Record = undefined,
+    results: [max_layers]Stats = undefined,
+    n: usize = 0,
+    used: usize = 0,
+    epoch: u64 = 0,
+    completed: u64 = 0,
+    dropped: u64 = 0,
+    active: bool = false,
+    invalid: bool = false,
+    emit: bool = true,
+
+    pub fn init(d: *const cuda.Driver) !*Trace {
+        const v = try std.heap.page_allocator.create(Trace);
+        errdefer std.heap.page_allocator.destroy(v);
+        v.* = .{ .device = try cuda.DeviceBuffer.alloc(d, capacity * @sizeOf(i32)) };
+        return v;
+    }
+
+    /// The owner has drained its stream before releasing any profiler or model buffers.
+    pub fn deinit(v: *Trace) void {
+        v.device.free();
+        std.heap.page_allocator.destroy(v);
+    }
+
+    pub fn begin(v: *Trace) void {
+        v.abort();
+        v.epoch +%= 1;
+        v.n = 0;
+        v.used = 0;
+        v.invalid = false;
+        v.active = true;
+    }
+
+    pub fn abort(v: *Trace) void {
+        if (v.active and v.n > 0) v.dropped += 1;
+        v.active = false;
+        v.invalid = true;
+    }
+
+    /// One asynchronous copy on the producing stream; no allocation, host transfer, event, or wait per layer.
+    pub fn record(v: *Trace, stream: cuda.Stream, meta: Meta, shape: Shape, picks: u64) !void {
+        if (!v.active or v.invalid) return;
+        if (!valid(shape) or v.n == max_layers or meta.context_min > meta.context_max or meta.streams == 0) {
+            v.invalid = true;
+            return;
+        }
+        for (v.records[0..v.n]) |r| if (r.meta.rank == meta.rank and r.meta.layer == meta.layer) {
+            v.invalid = true;
+            return;
+        };
+        const count = shape.rows * shape.slots;
+        if (count > capacity - v.used) {
+            v.invalid = true;
+            return;
+        }
+        v.device.copyFrom(v.used * 4, picks, count * 4, stream.handle) catch |err| {
+            v.invalid = true;
+            return err;
+        };
+        v.records[v.n] = .{ .meta = meta, .shape = shape, .offset = v.used };
+        v.n += 1;
+        v.used += count;
+    }
+
+    /// Call only after the forward's existing successful completion wait; a single D2H reads every layer's snapshot.
+    pub fn finish(v: *Trace, label: []const u8) void {
+        if (!v.active) return;
+        v.active = false;
+        if (v.n == 0 and !v.invalid) return;
+        if (v.invalid) return v.discard("invalid_or_overflow");
+        v.device.download(0, std.mem.sliceAsBytes(v.host[0..v.used])) catch return v.discard("readback_failed");
+        // Validate the entire call before emitting any layer, so a partial receipt cannot look complete.
+        for (v.records[0..v.n], v.results[0..v.n]) |r, *out| {
+            out.* = summarize(r.shape, v.host[r.offset..][0 .. r.shape.rows * r.shape.slots]) catch
+                return v.discard("malformed_picks");
+        }
+        v.completed += 1;
+        if (!v.emit) return;
+        for (v.records[0..v.n], v.results[0..v.n]) |r, out| {
+            var buf: [1024]u8 = undefined;
+            var w: std.Io.Writer = .fixed(&buf);
+            w.print("glm route {{\"call\":{d},\"label\":\"{s}\",\"rank\":{d},\"layer\":{d},", .{
+                v.epoch, label, r.meta.rank, r.meta.layer,
+            }) catch continue;
+            w.print("\"rows\":{d},\"streams\":{d},\"context_min\":{d},\"context_max\":{d},", .{
+                r.shape.rows, r.meta.streams, r.meta.context_min, r.meta.context_max,
+            }) catch continue;
+            w.print("\"unique\":{d},\"pairs\":{d},\"pair_hist\":[", .{ out.unique, out.pairs }) catch continue;
+            for (out.hist, 0..) |n, i| w.print("{s}{d}", .{ if (i == 0) "" else ",", n }) catch break;
+            w.writeAll("]}") catch continue;
+            std.log.info("{s}", .{w.buffered()});
+        }
+    }
+
+    fn discard(v: *Trace, reason: []const u8) void {
+        v.dropped += 1;
+        if (v.emit) std.log.warn("glm route discarded call={d} reason={s}", .{ v.epoch, reason });
+    }
+};
+
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_GLM_ROUTE_PROF") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+test {
+    _ = @import("cuda_route_prof_test.zig");
+}
