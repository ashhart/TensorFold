diff --git a/zig/src/core/lanes/observer_test.zig b/zig/src/core/lanes/observer_test.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/lanes/observer_test.zig
@@ -0,0 +1,79 @@
+//! Optional round begin/end hooks do not change generated tokens or the legacy done-only observer.
+const std = @import("std");
+const be = @import("backend.zig");
+const Engine = @import("engine.zig").Engine;
+const Stream = @import("stream.zig").Stream;
+const fake = @import("fake.zig");
+const tests = @import("engine_test.zig");
+const a = std.testing.allocator;
+
+const Seen = struct {
+    starts: usize = 0,
+    ends: usize = 0,
+    open: bool = false,
+    bad: bool = false,
+    fn begin(ptr: *anyopaque) void {
+        const s: *Seen = @ptrCast(@alignCast(ptr));
+        s.bad = s.bad or s.open;
+        s.open = true;
+        s.starts += 1;
+    }
+    fn done(ptr: *anyopaque, _: []const []const u32) void {
+        const s: *Seen = @ptrCast(@alignCast(ptr));
+        s.bad = s.bad or !s.open;
+        s.open = false;
+        s.ends += 1;
+    }
+};
+
+test "optional round begin observes complete solo and shared rounds without changing tokens" {
+    for ([_]usize{ 1, 2 }) |n| {
+        var expected: [2][40]u32 = undefined;
+        var expected_len: [2]usize = undefined;
+        for ([_]bool{ false, true }) |enabled| {
+            var cfg = try tests.model();
+            defer cfg.deinit(a);
+            var target: fake.Fake = .{ .gpa = a };
+            defer target.deinit();
+            var clock: fake.FixedClock = .{};
+            var seen: Seen = .{};
+            var backend = target.backend();
+            if (enabled) backend.round_observer = .{ .ptr = &seen, .done = Seen.done, .begin = Seen.begin };
+            var engine = Engine.init(a, &cfg, backend, clock.clock());
+            defer engine.deinit();
+            var streams: [2]Stream = undefined;
+            var made: usize = 0;
+            defer for (streams[0..made]) |*s| s.deinit(a);
+            for (streams[0..n], 0..) |*s, i| {
+                s.* = try Stream.init(a, .{ .id = if (i == 0) "a" else "b", .prompt = if (i == 0) &tests.p1 else &tests.p2,
+                    .max_new = 40, .eos = &.{96}, .drafts = true });
+                made += 1;
+                try engine.addStream(s);
+            }
+            while (engine.activeCount() > 0) try engine.step();
+            for (streams[0..n], 0..) |*s, i| {
+                const out = s.emitted();
+                if (enabled) {
+                    try std.testing.expectEqualSlices(u32, expected[i][0..expected_len[i]], out);
+                } else {
+                    expected_len[i] = out.len;
+                    @memcpy(expected[i][0..out.len], out);
+                }
+            }
+            try std.testing.expect(!seen.bad and !seen.open);
+            try std.testing.expectEqual(seen.starts, seen.ends);
+            try std.testing.expect(if (enabled) seen.starts > 0 else seen.starts == 0);
+        }
+    }
+}
+
+test "legacy done-only observer has a default-null begin callback" {
+    var seen: Seen = .{ .open = true };
+    const backend: be.Backend = .{ .ptr = undefined, .vtable = undefined,
+        .round_observer = .{ .ptr = &seen, .done = Seen.done } };
+    backend.observing();
+    backend.observed(&.{&.{0}});
+    try std.testing.expectEqual(@as(usize, 0), seen.starts);
+    try std.testing.expectEqual(@as(usize, 1), seen.ends);
+    try std.testing.expect(!seen.bad);
+}
