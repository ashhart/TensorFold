diff --git a/zig/src/families/glm/cuda_round_trace.zig b/zig/src/families/glm/cuda_round_trace.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/families/glm/cuda_round_trace.zig
@@ -0,0 +1,187 @@
+//! Opt-in host call timing; no CUDA API, device readback or extra synchronization is used here.
+const std = @import("std");
+
+pub const Phase = enum { verify_call, draw_call, draft_call, keep_call, commit_call };
+const phases = @typeInfo(Phase).@"enum".field_names.len;
+const max_buckets = 128;
+
+pub const Meta = struct {
+    streams: usize = 0,
+    rows: usize = 0,
+    context_min: u64 = std.math.maxInt(u64),
+    context_max: u64 = 0,
+    initial: bool = false,
+};
+
+const Bucket = struct {
+    streams: usize = 0,
+    rows: usize = 0,
+    band: u8 = 0,
+    initial: bool = false,
+    calls: u64 = 0,
+    kept: u64 = 0,
+    next_drafts: u64 = 0,
+    context_min: u64 = std.math.maxInt(u64),
+    context_max: u64 = 0,
+    wall_ns: i96 = 0,
+    min_ns: i96 = std.math.maxInt(i96),
+    max_ns: i96 = 0,
+    phase_ns: [phases]i96 = @splat(0),
+};
+
+pub fn wanted() bool {
+    const value = std.c.getenv("TF_GLM_ROUND_TRACE") orelse return false;
+    return std.mem.eql(u8, std.mem.span(value), "1");
+}
+
+fn band(context: u64) u8 {
+    return if (context <= 16384) 0 else if (context <= 65536) 1 else if (context <= 262144) 2 else 3;
+}
+
+fn millis(ns: i96, count: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / (1e6 * @as(f64, @floatFromInt(count)));
+}
+
+pub const Trace = struct {
+    io: std.Io,
+    active: bool = false,
+    since: i96 = 0,
+    meta: Meta = .{},
+    phase_ns: [phases]i96 = @splat(0),
+    next_drafts: u64 = 0,
+    buckets: [max_buckets]Bucket = @splat(.{}),
+    used: usize = 0,
+    dropped: u64 = 0,
+    aborted: u64 = 0,
+
+    pub fn create(a: std.mem.Allocator, io: std.Io, enabled: bool) !?*Trace {
+        if (!enabled) return null;
+        const t = try a.create(Trace);
+        t.* = .{ .io = io };
+        return t;
+    }
+
+    pub fn now(t: *const Trace) i96 {
+        return std.Io.Clock.awake.now(t.io).toNanoseconds();
+    }
+
+    pub fn begin(t: *Trace) void {
+        t.beginAt(t.now());
+    }
+
+    pub fn beginAt(t: *Trace, ns: i96) void {
+        if (t.active) t.aborted += 1;
+        t.active = true;
+        t.since = ns;
+        t.meta = .{};
+        t.phase_ns = @splat(0);
+        t.next_drafts = 0;
+    }
+
+    pub fn add(t: *Trace, phase: Phase, since: i96) void {
+        t.addAt(phase, since, t.now());
+    }
+
+    pub fn addAt(t: *Trace, phase: Phase, since: i96, until: i96) void {
+        if (t.active and until >= since) t.phase_ns[@backingInt(phase)] += until - since;
+    }
+
+    pub fn finish(t: *Trace, paths: []const []const u32) void {
+        var kept: u64 = 0;
+        for (paths) |path| kept += path.len;
+        t.finishAt(t.now(), kept);
+    }
+
+    pub fn finishAt(t: *Trace, ns: i96, kept: u64) void {
+        if (!t.active) return;
+        t.active = false;
+        if (ns < t.since or t.meta.rows == 0 or t.meta.streams == 0) {
+            t.aborted += 1;
+            return;
+        }
+        const m = t.meta;
+        var found: ?*Bucket = null;
+        for (t.buckets[0..t.used]) |*b| {
+            if (b.streams == m.streams and b.rows == m.rows and b.band == band(m.context_max) and
+                b.initial == m.initial)
+            {
+                found = b;
+                break;
+            }
+        }
+        const b = found orelse new: {
+            if (t.used == max_buckets) {
+                t.dropped += 1;
+                return;
+            }
+            const b = &t.buckets[t.used];
+            t.used += 1;
+            b.* = .{ .streams = m.streams, .rows = m.rows, .band = band(m.context_max), .initial = m.initial };
+            break :new b;
+        };
+        const elapsed = ns - t.since;
+        b.calls += 1;
+        b.kept += kept;
+        b.next_drafts += t.next_drafts;
+        b.wall_ns += elapsed;
+        b.min_ns = @min(b.min_ns, elapsed);
+        b.max_ns = @max(b.max_ns, elapsed);
+        b.context_min = @min(b.context_min, m.context_min);
+        b.context_max = @max(b.context_max, m.context_max);
+        for (&b.phase_ns, t.phase_ns) |*out, value| out.* += value;
+    }
+
+    /// Flush only after streams release, outside measured rounds; nested call spans are labelled explicitly.
+    pub fn flush(t: *Trace) void {
+        if (t.active) {
+            t.aborted += 1;
+            t.active = false;
+        }
+        for (t.buckets[0..t.used]) |b| {
+            const p = b.phase_ns;
+            const other = b.wall_ns - p[@backingInt(Phase.verify_call)] -
+                p[@backingInt(Phase.draft_call)] - p[@backingInt(Phase.keep_call)];
+            std.log.info("glm round host: streams={d} rows={d} context={d}..{d} initial={} calls={d} kept={d} next_drafts={d} wall_ms={d:.4} min_ms={d:.4} max_ms={d:.4} verify_call_ms={d:.4} draw_nested_ms={d:.4} draft_call_ms={d:.4} keep_call_ms={d:.4} commit_nested_ms={d:.4} other_ms={d:.4}", .{
+                b.streams, b.rows, b.context_min, b.context_max, b.initial, b.calls, b.kept, b.next_drafts,
+                millis(b.wall_ns, b.calls), millis(b.min_ns, 1), millis(b.max_ns, 1),
+                millis(p[0], b.calls), millis(p[1], b.calls), millis(p[2], b.calls),
+                millis(p[3], b.calls), millis(p[4], b.calls), millis(other, b.calls),
+            });
+        }
+        if (t.used > 0 or t.dropped > 0 or t.aborted > 0)
+            std.log.info("glm round host end: buckets={d} dropped={d} aborted={d}; host calls include async waits, nested spans are not additive GPU times", .{ t.used, t.dropped, t.aborted });
+        t.used = 0;
+        t.dropped = 0;
+        t.aborted = 0;
+    }
+};
+
+test "GLM round host: disabled trace allocates nothing" {
+    var fail = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 0 });
+    try std.testing.expect((try Trace.create(fail.allocator(), std.testing.io, false)) == null);
+    try std.testing.expectEqual(@as(usize, 0), fail.alloc_index);
+}
+
+test "GLM round host: widths and startup remain separate with nested accounting" {
+    var t: Trace = .{ .io = std.testing.io };
+    for (0..3) |i| {
+        t.beginAt(100);
+        t.meta = .{ .streams = 1, .rows = if (i == 2) 3 else 2,
+            .context_min = 8192, .context_max = 8192, .initial = i == 0 };
+        t.addAt(.verify_call, 110, 160);
+        t.addAt(.draw_call, 140, 160);
+        t.addAt(.draft_call, 170, 190);
+        t.next_drafts = 7;
+        t.finishAt(200, 2);
+    }
+    try std.testing.expectEqual(@as(usize, 3), t.used);
+    try std.testing.expectEqual(@as(i96, 100), t.buckets[0].wall_ns);
+    try std.testing.expectEqual(@as(i96, 50), t.buckets[0].phase_ns[0]);
+    try std.testing.expectEqual(@as(i96, 20), t.buckets[0].phase_ns[1]);
+    try std.testing.expectEqual(@as(u64, 2), t.buckets[0].kept);
+    t.beginAt(300);
+    t.beginAt(400);
+    try std.testing.expectEqual(@as(u64, 1), t.aborted);
+    t.finishAt(500, 1);
+    try std.testing.expectEqual(@as(u64, 2), t.aborted);
+}
