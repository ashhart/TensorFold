+//! Host routing references and virtual device copies: bounded snapshots never wait or read back per layer.
+const std = @import("std");
+const cuda = @import("cuda");
+const route = @import("cuda_route_prof.zig");
+const t = std.testing;
+
+test "GLM route receipt excludes shared slots and counts cross-row expert reuse" {
+    const s: route.Shape = .{ .rows = 3, .slots = 3, .experts = 5 };
+    const v = try route.summarize(s, &.{ 0, 1, 5, 1, 2, 5, 1, 4, 5 });
+    try t.expectEqual(@as(usize, 4), v.unique);
+    try t.expectEqual(@as(usize, 6), v.pairs);
+    try t.expectEqual(@as(usize, 3), v.hist[1]);
+    try t.expectEqual(@as(usize, 1), v.hist[3]);
+    var pairs: usize = 0;
+    for (v.hist, 0..) |n, i| pairs += n * i;
+    try t.expectEqual(v.pairs, pairs);
+}
+
+test "GLM route receipt covers all admitted row counts and disjoint versus fully reused experts" {
+    var picks: [route.max_rows * 9]i32 = undefined;
+    for (1..route.max_rows + 1) |rows| for ([_]bool{ false, true }) |reuse| {
+        for (0..rows) |r| {
+            for (0..8) |k| picks[r * 9 + k] = @intCast(if (reuse) k else r * 8 + k);
+            picks[r * 9 + 8] = 288;
+        }
+        const v = try route.summarize(.{ .rows = rows, .slots = 9, .experts = 288 }, picks[0 .. rows * 9]);
+        try t.expectEqual(@as(usize, if (reuse) 8 else rows * 8), v.unique);
+        try t.expectEqual(rows * 8, v.pairs);
+        try t.expectEqual(v.unique, v.hist[if (reuse) rows else 1]);
+    };
+}
+
+test "GLM route receipt rejects duplicate out-of-range and malformed shared picks" {
+    const s: route.Shape = .{ .rows = 1, .slots = 3, .experts = 3 };
+    for ([_][3]i32{ .{ 0, 0, 3 }, .{ -1, 1, 3 }, .{ 0, 3, 3 }, .{ 0, 1, 2 } }) |p| {
+        try t.expectError(error.BadRouteReceipt, route.summarize(s, &p));
+    }
+    try t.expectError(error.BadRouteReceipt, route.summarize(s, &.{ 0, 1 }));
+    try t.expectError(error.BadRouteReceipt, route.summarize(.{ .rows = 0, .slots = 3, .experts = 3 }, &.{}));
+    try t.expectError(error.BadRouteReceipt, route.summarize(.{ .rows = 33, .slots = 3, .experts = 3 }, &.{}));
+}
+
+const Fake = struct {
+    var memory: [route.max_layers * route.max_rows * route.max_slots * 4]u8 align(256) = undefined;
+    var live: usize = 0;
+    var copies: usize = 0;
+    var reads: usize = 0;
+    var fail_alloc: bool = false;
+    var fail_copy: bool = false;
+    var fail_read: bool = false;
+
+    fn driver() cuda.Driver {
+        live = 0;
+        copies = 0;
+        reads = 0;
+        fail_alloc = false;
+        fail_copy = false;
+        fail_read = false;
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemcpyDtoDAsync_v2 = copy;
+        d.api.cuMemcpyDtoH_v2 = read;
+        return d;
+    }
+    fn alloc(p: *u64, n: usize) callconv(.c) c_int {
+        if (fail_alloc or n > memory.len) return cuda.abi.error_not_ready;
+        live += 1;
+        p.* = @intFromPtr(&memory);
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        live -= 1;
+        return 0;
+    }
+    fn copy(dst: u64, src: u64, n: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        if (fail_copy) return cuda.abi.error_not_ready;
+        copies += 1;
+        @memcpy(@as([*]u8, @ptrFromInt(dst))[0..n], @as([*]const u8, @ptrFromInt(src))[0..n]);
+        return 0;
+    }
+    fn read(dst: ?*anyopaque, src: u64, n: usize) callconv(.c) c_int {
+        reads += 1;
+        if (fail_read) return cuda.abi.error_not_ready;
+        @memcpy(@as([*]u8, @ptrCast(dst.?))[0..n], @as([*]const u8, @ptrFromInt(src))[0..n]);
+        return 0;
+    }
+};
+
+const meta: route.Meta = .{ .rank = 1, .layer = 3, .context_min = 32768, .context_max = 32768 };
+const shape: route.Shape = .{ .rows = 2, .slots = 3, .experts = 4 };
+
+test "GLM route trace snapshots scratch before reuse and performs one readback after all layers" {
+    var d = Fake.driver();
+    const v = try route.Trace.init(&d);
+    defer v.deinit();
+    v.emit = false;
+    const stream: cuda.Stream = .{ .d = &d, .handle = @ptrFromInt(1) };
+    var p = [_]i32{ 0, 1, 4, 1, 2, 4 };
+    v.begin();
+    try v.record(stream, meta, shape, @intFromPtr(&p));
+    p = .{ 0, 1, 4, 2, 3, 4 };
+    var next = meta;
+    next.layer = 4;
+    try v.record(stream, next, shape, @intFromPtr(&p));
+    try t.expectEqual(@as(usize, 2), Fake.copies);
+    try t.expectEqual(@as(usize, 0), Fake.reads);
+    @memset(&p, -1);
+    v.finish("verify 2 rows");
+    try t.expectEqual(@as(usize, 1), Fake.reads);
+    try t.expectEqual(@as(usize, 3), v.results[0].unique);
+    try t.expectEqual(@as(usize, 4), v.results[1].unique);
+    try t.expectEqual(@as(u64, 1), v.completed);
+    v.finish("verify 2 rows");
+    try t.expectEqual(@as(usize, 1), Fake.reads);
+}
+
+test "GLM route trace abort duplicate overflow and copy failures discard the complete call" {
+    var d = Fake.driver();
+    const v = try route.Trace.init(&d);
+    defer v.deinit();
+    v.emit = false;
+    const stream: cuda.Stream = .{ .d = &d, .handle = @ptrFromInt(1) };
+    const p = [_]i32{ 0, 1, 4, 1, 2, 4 };
+    for (0..5) |kind| {
+        v.begin();
+        Fake.fail_copy = false;
+        Fake.fail_read = false;
+        try v.record(stream, meta, shape, @intFromPtr(&p));
+        switch (kind) {
+            0 => v.abort(),
+            1 => try v.record(stream, meta, shape, @intFromPtr(&p)),
+            2 => v.n = route.max_layers,
+            3 => Fake.fail_copy = true,
+            else => Fake.fail_read = true,
+        }
+        if (kind == 2 or kind == 3) {
+            var next = meta;
+            next.layer = 4;
+            if (kind == 3) {
+                try t.expectError(error.NotReady, v.record(stream, next, shape, @intFromPtr(&p)));
+            } else try v.record(stream, next, shape, @intFromPtr(&p));
+        }
+        v.finish("host fixture");
+        try t.expectEqual(@as(u64, 0), v.completed);
+    }
+    try t.expectEqual(@as(u64, 5), v.dropped);
+    try t.expectEqual(@as(usize, 1), Fake.reads);
+}
+
+test "GLM route trace frees its only device allocation and unwinds a failed allocation" {
+    var d = Fake.driver();
+    Fake.fail_alloc = true;
+    try t.expectError(error.NotReady, route.Trace.init(&d));
+    try t.expectEqual(@as(usize, 0), Fake.live);
+    Fake.fail_alloc = false;
+    const v = try route.Trace.init(&d);
+    try t.expectEqual(@as(usize, 1), Fake.live);
+    v.deinit();
+    try t.expectEqual(@as(usize, 0), Fake.live);
+}
