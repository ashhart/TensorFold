+++ b/zig/src/families/glm/cuda_kda_o_split_test.zig
@@ -0,0 +1,176 @@
+//! KDA O transport dispatch: record the real launch path without a GPU or changing any projection arithmetic.
+const std = @import("std");
+const cuda = @import("cuda");
+const kda = @import("cuda_kda_block.zig");
+const glue = @import("cuda_glue.zig");
+const mm = @import("cuda_mm.zig");
+
+const Capture = struct {
+    const Call = struct {
+        id: usize, gx: u32, gz: u32, threads: u32, shared: u32, cluster: u32,
+        x: u64 = 0, out: u64 = 0, part: u64 = 0, rows: u64 = 0, n: u64 = 0,
+        k: u64 = 0, sk: u64 = 0, ldx: u64 = 0, total: u64 = 0, scale_bits: u32 = 0,
+    };
+    var calls: [4]Call = undefined;
+    var count: usize = 0;
+
+    fn arg(args: ?[*]?*anyopaque, i: usize, wide: bool) u64 {
+        const p: [*]const u8 = @ptrCast(args.?[i].?);
+        return if (wide) std.mem.readInt(u64, p[0..8], .little) else std.mem.readInt(u32, p[0..4], .little);
+    }
+
+    fn record(f: cuda.abi.Function, gx: u32, gz: u32, threads: u32, shared: u32, cluster: u32, args: ?[*]?*anyopaque) void {
+        var c: Call = .{ .id = @intFromPtr(f), .gx = gx, .gz = gz, .threads = threads,
+            .shared = shared, .cluster = cluster };
+        if (c.id == 29 or c.id == 30) {
+            c.part = arg(args, 0, true);
+            c.out = arg(args, 1, true);
+            c.total = arg(args, 2, true);
+            c.sk = arg(args, 3, false);
+            c.scale_bits = @intCast(arg(args, 4, false));
+        } else {
+            c.x = arg(args, 0, true);
+            c.scale_bits = @intCast(arg(args, 3, false));
+            c.out = arg(args, 4, true);
+            c.part = arg(args, 5, true);
+            c.rows = arg(args, 6, false);
+            c.n = arg(args, 7, false);
+            c.k = arg(args, 8, false);
+            c.sk = arg(args, 9, false);
+            c.ldx = arg(args, 11, false);
+        }
+        calls[count] = c;
+        count += 1;
+    }
+
+    fn launch(f: cuda.abi.Function, gx: c_uint, _: c_uint, gz: c_uint, bx: c_uint, _: c_uint, _: c_uint,
+        shared: c_uint, _: cuda.abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+        record(f, gx, gz, bx, shared, 0, args);
+        return cuda.abi.success;
+    }
+
+    fn extended(c: *const cuda.abi.LaunchConfig, f: cuda.abi.Function, args: ?[*]?*anyopaque,
+        _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+        var cluster: u32 = 0;
+        for (0..c.num_attrs) |i| if (c.attrs.?[i].id == .cluster_dimension) {
+            cluster = c.attrs.?[i].value.cluster_dim.z;
+        };
+        record(f, c.grid_x, c.grid_z, c.block_x, c.shared_bytes, cluster, args);
+        return cuda.abi.success;
+    }
+};
+
+fn function(d: *const cuda.Driver, id: usize) cuda.Function {
+    return .{ .d = d, .handle = @ptrFromInt(id) };
+}
+
+fn layer() kda.Layer {
+    return .{ .proj = .{ .bf16 = 0 }, .fb = 0, .gb = 0,
+        .o = .{ .mxfp8 = cuda.mxfp8.weight(0x200000000, 0x300000000, 4096, 4096) },
+        .conv_w = 0, .a_log = 0, .dt_bias = 0, .norm_w = 0, .eps = 1e-6, .lower = -5,
+        .heads = 32, .dims = 4096 };
+}
+
+test "KDA O split uses original four slices and FP32 reduce, only for decode MXFP8 O rows 1-16" {
+    var d: cuda.Driver = undefined;
+    d.api.cuLaunchKernel = Capture.launch;
+    d.api.cuLaunchKernelEx = Capture.extended;
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    var lane: cuda.qmmf.Lane = .{ .mod = undefined, .fns = undefined,
+        .f32_fns = @splat(@splat(function(&d, 21))), .mxfp8_strided = undefined,
+        .reduce = .{ function(&d, 29), function(&d, 30) }, .clusters = true };
+    lane.f32_fns[2][0] = function(&d, 20);
+    var kernels: mm.Kernels = .{ .by_rows = undefined, .prompt = undefined, .reduce = undefined,
+        .reduce_strided = undefined, .pdl = false, .packed_rows = undefined, .tile = undefined,
+        .tile_packed = undefined, .kda_o_split = true };
+    var set: glue.Set = .{ .glue = undefined, .mm = &kernels, .linear = .{ .lane = &lane } };
+    var scratch: kda.Scratch = .{ .p = 0, .ka = 0, .kg = 0, .mm_part = 0x800000000,
+        .saves = undefined, .wide = undefined };
+    scratch.saves.out = 0x500000000;
+    var l = layer();
+    l.o.mxfp8.scale = 0.75;
+    const scale_bits: u32 = @bitCast(l.o.mxfp8.scale);
+    const dest: u64 = 0x900000000;
+    for (1..17) |rows| {
+        Capture.count = 0;
+        try kda.fill(set, stream, l, scratch, 3, 3 + rows, dest);
+        try std.testing.expectEqual(@as(usize, 2), Capture.count);
+        const a = Capture.calls[0];
+        const b = Capture.calls[1];
+        try std.testing.expectEqual(@as(usize, 20), a.id);
+        try std.testing.expectEqual(@as(u32, 0), a.cluster);
+        try std.testing.expectEqual(@as(u32, 64), a.gx);
+        try std.testing.expectEqual(@as(u32, 4), a.gz);
+        try std.testing.expectEqual(@as(u32, 128), a.threads);
+        try std.testing.expectEqual(@as(u32, 25088), a.shared);
+        try std.testing.expectEqual(scratch.saves.out + 3 * 4096 * 2, a.x);
+        try std.testing.expectEqual(scratch.mm_part, a.part);
+        try std.testing.expectEqual(dest, a.out);
+        try std.testing.expectEqual(@as(u64, rows), a.rows);
+        try std.testing.expectEqual(@as(u64, 4096), a.n);
+        try std.testing.expectEqual(@as(u64, 4096), a.k);
+        try std.testing.expectEqual(@as(u64, 4096), a.ldx);
+        try std.testing.expectEqual(@as(u64, 4), a.sk);
+        try std.testing.expectEqual(scale_bits, a.scale_bits);
+        try std.testing.expectEqual(@as(usize, 30), b.id);
+        try std.testing.expectEqual(scratch.mm_part, b.part);
+        try std.testing.expectEqual(dest, b.out);
+        try std.testing.expectEqual(@as(u64, rows * 4096), b.total);
+        try std.testing.expectEqual(@as(u64, 4), b.sk);
+        try std.testing.expectEqual(scale_bits, b.scale_bits);
+        try std.testing.expect(lane.clusters);
+    }
+    for ([_]usize{ 1, 8, 16, 17 }) |rows| for ([_]bool{ false, true }) |prompt| {
+        set.prompt = prompt;
+        for ([_]bool{ false, true }) |enabled| {
+            kernels.kda_o_split = enabled;
+            Capture.count = 0;
+            try kda.fill(set, stream, l, scratch, 0, rows, dest);
+            const selected = enabled and !prompt and rows <= 16;
+            try std.testing.expectEqual(@as(usize, if (selected) 2 else 1), Capture.count);
+            try std.testing.expectEqual(@as(u32, if (selected) 0 else 4), Capture.calls[0].cluster);
+            try std.testing.expectEqual(scale_bits, Capture.calls[0].scale_bits);
+            if (selected) {
+                try std.testing.expectEqual(@as(usize, 30), Capture.calls[1].id);
+                try std.testing.expectEqual(scale_bits, Capture.calls[1].scale_bits);
+            }
+        }
+    };
+    set.prompt = false;
+    kernels.kda_o_split = true;
+    try std.testing.expect(!kda.usesSplitOutput(set, l, 0));
+    set.mm = null;
+    try std.testing.expect(!kda.usesSplitOutput(set, l, 1));
+    set.mm = &kernels;
+    set.linear.lane = null;
+    try std.testing.expect(!kda.usesSplitOutput(set, l, 1));
+    set.linear.lane = &lane;
+    lane.clusters = false;
+    try std.testing.expect(!kda.usesSplitOutput(set, l, 1));
+    lane.clusters = true;
+    var other = l;
+    other.o = .{ .bf16 = 0 };
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other.o = .{ .fp8g = cuda.fp8.weight(0, 0, 4096, 4096) };
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.o.mxfp8.npad += 128;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.o.mxfp8.n = 8192;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.o.mxfp8.k = 8192;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.o.mxfp8.mode = .fp8;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.heads = 31;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    other = l;
+    other.dims = 8192;
+    try std.testing.expect(!kda.usesSplitOutput(set, other, 1));
+    scratch.mm_part = 0;
+    try std.testing.expectError(error.MissingLanePart, kda.fill(set, stream, l, scratch, 0, 1, dest));
+}
