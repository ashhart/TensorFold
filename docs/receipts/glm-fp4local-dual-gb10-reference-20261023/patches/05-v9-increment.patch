+/// This local decode experiment is off unless explicitly selected; malformed values refuse startup.
+pub fn kdaOSplit(value: ?[]const u8) error{InvalidKdaOSplit}!bool {
+    const v = value orelse return false;
+    if (std.mem.eql(u8, v, "0")) return false;
+    if (std.mem.eql(u8, v, "1")) return true;
+    return error.InvalidKdaOSplit;
+}
+
+test "KDA O split transport defaults off and accepts only literal 0 or 1" {
+    try std.testing.expect(!try kdaOSplit(null));
+    try std.testing.expect(!try kdaOSplit("0"));
+    try std.testing.expect(try kdaOSplit("1"));
+    for ([_][]const u8{ "", "true", "false", "2", " 1", "1 " }) |v|
+        try std.testing.expectError(error.InvalidKdaOSplit, kdaOSplit(v));
+}
 
