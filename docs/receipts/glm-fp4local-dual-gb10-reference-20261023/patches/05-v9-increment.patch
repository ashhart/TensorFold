+/// KDA O only: keep SK=4 and its ordered FP32 sum; use existing scratch instead of a cluster exchange.
+pub fn usesSplitOutput(set: glue.Set, l: Layer, rows: usize) bool {
+    if (set.prompt or rows == 0 or rows > 16 or set.mm == null or !set.mm.?.kda_o_split or
+        set.linear.lane == null or !set.linear.lane.?.clusters or l.dims != 4096 or l.heads * kda.dk != 4096)
+        return false;
+    return switch (l.o) {
+        .mxfp8 => |w| w.mode == .mxfp8 and w.n == 4096 and w.k == 4096 and w.npad == 4096 and
+            cuda.qmmf.splitK(w.n, w.k) == 4,
+        else => false,
+    };
 }
 
