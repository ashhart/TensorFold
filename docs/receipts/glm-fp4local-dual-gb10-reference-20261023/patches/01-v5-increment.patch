diff --git a/zig/kernels/cuda/glm_a4_prompt.cuh b/zig/kernels/cuda/glm_a4_prompt.cuh
new file mode 100644
--- /dev/null
+++ b/zig/kernels/cuda/glm_a4_prompt.cuh
@@ -0,0 +1,153 @@
+// GLM A4 prompt experts reading the existing A16 compact pack; no second resident weight representation.
+#pragma once
+#include <cuda_bf16.h>
+#include <stdint.h>
+#include "mma4.cuh"
+#include "nvfp4q.cuh"
+
+#if defined(__CUDA_ARCH_FEAT_SM120_ALL) || defined(__CUDA_ARCH_FEAT_SM121_ALL)
+extern "C" __device__ __constant__ uint32_t tf_glm_a4_native_mma = 1;
+#endif
+
+namespace glm_a4 {
+// Extract eight consecutive codes from the A16 pack's two four-input fragments, without dequantizing weights.
+__device__ __forceinline__ uint32_t word8(const uint32_t* block, int j, int g, int t) {
+    uint32_t result = 0;
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        const uint32_t w = __ldg(block + (g * 4 + (t & 1) * 2 + h) * 4 + j);
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            const int shift = 4 * (2 * (t >> 1) + q / 2 + 4 * (q & 1));
+            result |= ((w >> shift) & 15u) << (4 * (4 * h + q));
+        }
+    }
+    return result;
+}
+
+__device__ __forceinline__ uint32_t scale2(const uint32_t* block, int j, int g) {
+    const uint8_t* s = reinterpret_cast<const uint8_t*>(block + 128);
+    const int i = (((g / 2) * 2) * 4 + j) * 2 + (g & 1);
+    return static_cast<uint32_t>(s[i]) | (static_cast<uint32_t>(s[i + 8]) << 8);
+}
+
+__device__ __forceinline__ float bf(float v) { return __bfloat162float(__float2bfloat16_rn(v)); }
+
+__device__ __forceinline__ float swiglu(float gate, float up, float limit) {
+    gate = bf(gate);
+    up = bf(up);
+    if (limit > 0.0f) {
+        gate = fminf(gate, limit);
+        up = fminf(fmaxf(up, -limit), limit);
+    }
+    return bf(gate / (1.0f + expf(-gate))) * up;
+}
+
+// One CTA: at most 64 routed pairs; N-warps reuse quantized rows with each projection's own input scale.
+template<int PARTS, int NW = 2>
+__device__ __forceinline__ void prompt(const __nv_bfloat16* x, int ldx, int slots, const uint32_t* weights,
+                                      const float* globals, const float* inputs, int K, int N, const int* items,
+                                      const int* counts, const int* members, __nv_bfloat16* out, float limit, int skip) {
+    __shared__ uint32_t codes[PARTS][64][8];
+    __shared__ __align__(4) uint8_t scales[PARTS][64][4];
+    constexpr int NC = NW * 32, THREADS = NW * 64;
+    const int nt = (N + NC - 1) / NC, item = blockIdx.x / nt, ct = blockIdx.x % nt;
+    if (item >= __ldg(counts)) return;
+    const int e = __ldg(items + item * 3), first = __ldg(items + item * 3 + 1);
+    const int count = __ldg(items + item * 3 + 2);
+    if (e == skip) return;
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int wm = warp / NW, wn = warp % NW, g = lane >> 2, t = lane & 3;
+    const int n0 = ct * NC + wn * 32, KG = K / 32;
+    float acc[PARTS][2][4][4] = {};
+    float input[PARTS], alpha[PARTS];
+#pragma unroll
+    for (int m = 0; m < PARTS; ++m) {
+        input[m] = __ldg(inputs + e * 3 + (PARTS == 2 ? m : 2));
+        alpha[m] = __ldg(globals + e * PARTS + m) * input[m];
+    }
+    for (int kg = 0; kg < K / 64; ++kg) {
+        for (int q = tid; q < 64 * 4; q += THREADS) {
+            const int row = q / 4, block = q % 4;
+            float values[16] = {}, amax = 0.0f;
+            if (row < count) {
+                const int pair = __ldg(members + first + row);
+                const int xr = slots ? pair / slots : pair;
+#pragma unroll
+                for (int j = 0; j < 16; ++j) {
+                    values[j] = __bfloat162float(x[static_cast<size_t>(xr) * ldx + kg * 64 + block * 16 + j]);
+                    amax = fmaxf(amax, fabsf(values[j]));
+                }
+            }
+#pragma unroll
+            for (int m = 0; m < PARTS; ++m) {
+                const auto sc = nvfp4q::block_scale(amax, __fdiv_rn(1.0f, input[m]));
+                uint32_t lo = 0, hi = 0;
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    lo |= nvfp4q::e2m1(values[j] * sc.mul) << (4 * j);
+                    hi |= nvfp4q::e2m1(values[j + 8] * sc.mul) << (4 * j);
+                }
+                codes[m][row][2 * block] = lo;
+                codes[m][row][2 * block + 1] = hi;
+                scales[m][row][block] = static_cast<uint8_t>(sc.sf8);
+            }
+        }
+        __syncthreads();
+        if (n0 < N) {
+#pragma unroll
+            for (int m = 0; m < PARTS; ++m) {
+                const size_t base = ((static_cast<size_t>(e) * (N / 32) + n0 / 32) * KG + kg * 2) * PARTS * 144;
+                const uint32_t* w0 = weights + base + m * 144;
+                const uint32_t* w1 = w0 + PARTS * 144;
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    const uint32_t b0 = word8(w0, j, g, t), b1 = word8(w1, j, g, t);
+                    const uint32_t sb = scale2(w0, j, g) | (scale2(w1, j, g) << 16);
+#pragma unroll
+                    for (int r = 0; r < 2; ++r) {
+                        const int row = wm * 32 + r * 16 + g;
+                        const uint32_t a[4] = {codes[m][row][t], codes[m][row + 8][t],
+                                                codes[m][row][t + 4], codes[m][row + 8][t + 4]};
+                        const uint32_t sa = *reinterpret_cast<const uint32_t*>(scales[m][row + (t & 1) * 8]);
+                        mma4::mma_fp4(acc[m][r][j], a, b0, b1, sa, sb);
+                    }
+                }
+            }
+        }
+        __syncthreads();
+    }
+    if (n0 >= N) return;
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int row = wm * 32 + r * 16 + g + h * 8;
+            if (row >= count) continue;
+            const size_t dest = static_cast<size_t>(__ldg(members + first + row)) * N;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                float v0 = acc[0][r][j][2 * h] * alpha[0];
+                float v1 = acc[0][r][j][2 * h + 1] * alpha[0];
+                if constexpr (PARTS == 2) {
+                    v0 = swiglu(v0, acc[1][r][j][2 * h] * alpha[1], limit);
+                    v1 = swiglu(v1, acc[1][r][j][2 * h + 1] * alpha[1], limit);
+                }
+                const int col = n0 + j * 8 + 2 * t;
+                *reinterpret_cast<__nv_bfloat162*>(out + dest + col) = __floats2bfloat162_rn(v0, v1);
+            }
+        }
+    }
+}
+} // namespace glm_a4
+
+#define GLM_A4_ENTRY(NAME, PARTS, NW) \
+extern "C" __global__ void __launch_bounds__(NW * 64) NAME(const __nv_bfloat16* x, int ldx, int slots, \
+ const uint32_t* weights, const float* globals, const float* inputs, int K, int N, const int* items, \
+ const int* counts, const int* members, __nv_bfloat16* out, float limit, int skip) { \
+ glm_a4::prompt<PARTS, NW>(x, ldx, slots, weights, globals, inputs, K, N, items, counts, members, out, limit, skip); }
+GLM_A4_ENTRY(tf_glm_a4_prompt_up, 2, 2)
+GLM_A4_ENTRY(tf_glm_a4_prompt_down, 1, 2)
+GLM_A4_ENTRY(tf_glm_a4_prompt_up_n128, 2, 4)
+GLM_A4_ENTRY(tf_glm_a4_prompt_down_n128, 1, 4)
+#undef GLM_A4_ENTRY
