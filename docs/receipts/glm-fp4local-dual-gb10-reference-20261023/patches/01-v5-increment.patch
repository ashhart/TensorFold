@@ -0,0 +1,314 @@
+//! The wider GLM A4 N tile is a bit-preserving replacement, not a new quantization/reference claim.
+//! Independent finite FP64 cases also live in tests/test_a4.py; gate 4 uses exactly representable dyadic sums.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const check_ = @import("check.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+const experts = 4;
+const slots = 4;
+
+fn depth(s: c.Shape) usize {
+    return s.k / 64 + 64;
+}
+
+pub fn spec(up: bool) c.Spec {
+    return .{
+        .name = if (up) "cuda glm A4 up N128" else "cuda glm A4 down N128",
+        .accum = .f32,
+        .depth = depth,
+        .ops = if (up) 8 else 1,
+        .mids = if (up) 3 else 0,
+        .out = .bf16,
+        .replaces = if (up) "tf_glm_a4_prompt_up N64" else "tf_glm_a4_prompt_down N64",
+        .nan = .{ .stated = "bitwise equal to N64 for NaN and infinite globals and BF16 inputs" },
+        .tiles = .{ .{ .size = 64 / slots }, .{ .size = 128, .step = 32, .min = 32 },
+            .{ .size = 64, .step = 64, .min = 64 } },
+        .served = if (up) &.{ .{ .rows = 17, .n = 768, .k = 4096 },
+            .{ .rows = 65, .n = 1024, .k = 4096 } } else &.{ .{ .rows = 17, .n = 4096, .k = 768 },
+            .{ .rows = 65, .n = 4096, .k = 1024 } },
+    };
+}
+
+pub const Prompt = struct {
+    rig: rig_.Rig,
+    up: bool,
+    candidate: cuda.Function,
+    baseline: cuda.Function,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = undefined,
+    ptrs: [8]u64 = @splat(0), // x, compact weights, globals, input scales, items, counts, members, output
+    base: u64 = 0,
+    nitems: usize = 0,
+    stress_terms: []f64 = &.{}, // [N][K] independent products, shared across identically filled rows/experts
+
+    pub fn init(rig: rig_.Rig, up: bool, mod: cuda.Module) !Prompt {
+        return .{ .rig = rig, .up = up, .arena = .init(rig.gpu.gpa),
+            .candidate = try mod.function(if (up) "tf_glm_a4_prompt_up_n128" else "tf_glm_a4_prompt_down_n128"),
+            .baseline = try mod.function(if (up) "tf_glm_a4_prompt_up" else "tf_glm_a4_prompt_down") };
+    }
+
+    pub fn deinit(self: *Prompt) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Prompt) g.Kernel {
+        return .{ .spec = spec(self.up), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Prompt);
+
+    pub fn count(self: *Prompt) usize {
+        return self.shape.rows * slots * self.shape.n;
+    }
+
+    pub fn prepare(self: *Prompt, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.n % 32 != 0 or shape.k == 0 or shape.k % 64 != 0)
+            return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        self.stress_terms = &.{};
+        self.shape = shape;
+        const a = self.arena.allocator();
+        const parts: usize = if (self.up) 2 else 1;
+        const pairs = shape.rows * slots;
+        const xrows = if (self.up) shape.rows else pairs;
+        const x = try a.alloc(u16, xrows * (shape.k + 16));
+        const w = try a.alloc(u32, experts * (shape.n / 32) * (shape.k / 32) * parts * 144);
+        const globals = try a.alloc(f32, experts * parts);
+        const input = try a.alloc(f32, experts * 3);
+        const members = try a.alloc(i32, pairs);
+        var items: std.ArrayList(i32) = .empty;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        for (x, 0..) |*v, i| v.* = c.toBf16(if (i < shape.k) 0 else (rng.float(f32) - 0.5) * 12);
+        rng.bytes(std.mem.sliceAsBytes(w));
+        // Independently random E2M1 codes and finite power-of-two E4M3 block scales in the existing pack.
+        var block: usize = 0;
+        while (block < w.len) : (block += 144) {
+            const scales = std.mem.sliceAsBytes(w[block + 128 .. block + 144]);
+            for (scales) |*v| v.* = 0x18 + 8 * rng.uintLessThan(u8, 6);
+        }
+        for (globals) |*v| v.* = 0.005 + rng.float(f32) * 0.025;
+        for (input, 0..) |*v, i| v.* = 0.125 * @as(f32, @floatFromInt(i % 7 + 1));
+        if (fill == .stress) try self.stress(a, rng, x, w, globals, input);
+        if (fill == .nonfinite) {
+            globals[parts] = std.math.nan(f32);
+            globals[2 * parts] = std.math.inf(f32);
+            globals[3 * parts] = -std.math.inf(f32);
+            const row = if (xrows > 1) shape.k + 16 else 0;
+            x[row + 2] = c.toBf16(std.math.nan(f32));
+            x[row + 3] = c.toBf16(std.math.inf(f32));
+        }
+        var nmembers: usize = 0;
+        // Include a skipped shared expert and deliberately uneven routing, tails and extra inactive CTAs.
+        for (0..experts + 1) |e| {
+            var start = nmembers;
+            for (0..pairs) |p| {
+                const pick = if (fill != .stress and p % 11 == 0) experts else (p / 3) % experts;
+                if (pick != e) continue;
+                members[nmembers] = @intCast(p);
+                nmembers += 1;
+                if (nmembers - start == 64) {
+                    try items.appendSlice(a, &.{ @intCast(e), @intCast(start), 64 });
+                    start = nmembers;
+                }
+            }
+            if (nmembers > start) try items.appendSlice(a, &.{ @intCast(e), @intCast(start), @intCast(nmembers - start) });
+        }
+        self.nitems = items.items.len / 3;
+        const count_: i32 = @intCast(self.nitems);
+        const r = &self.rig;
+        self.ptrs = .{ try r.input(std.mem.sliceAsBytes(x)), try r.input(std.mem.sliceAsBytes(w)),
+            try r.input(std.mem.sliceAsBytes(globals)), try r.input(std.mem.sliceAsBytes(input)),
+            try r.input(std.mem.sliceAsBytes(items.items)), try r.input(std.mem.asBytes(&count_)),
+            try r.input(std.mem.sliceAsBytes(members)), try r.output(self.count() * 2) };
+        self.base = try r.scratch(self.count() * 2);
+        return true;
+    }
+
+    fn launch(self: *Prompt, wide: bool) !void {
+        const p = self.ptrs;
+        const dest = if (wide) p[7] else self.base;
+        const buf: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = dest, .len = self.count() * 2 };
+        try buf.fill8(0xff, self.rig.s.handle);
+        const n = self.shape.n;
+        const tile: usize = if (wide) 128 else 64;
+        var args: cuda.Args = .{};
+        args.add(p[0]);
+        args.add(@as(i32, @intCast(self.shape.k + 16)));
+        args.add(@as(i32, if (self.up) slots else 0));
+        inline for (.{ p[1], p[2], p[3] }) |v| args.add(v);
+        args.add(@as(i32, @intCast(self.shape.k)));
+        args.add(@as(i32, @intCast(n)));
+        inline for (.{ p[4], p[5], p[6], dest }) |v| args.add(v);
+        args.add(@as(f32, 10));
+        args.add(@as(i32, experts));
+        try cuda.launch.launch(if (wide) self.candidate else self.baseline,
+            .{ .grid = .{ .x = @intCast((self.nitems + 3) * ((n + tile - 1) / tile)) },
+                .block = .{ .x = @intCast(tile * 2) } }, self.rig.s, &args);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn run(self: *Prompt) !void {
+        try self.launch(true);
+    }
+
+    pub fn replaced(self: *Prompt) ![]const u8 {
+        try self.launch(false);
+        return self.rig.bytes(self.base, self.count() * 2);
+    }
+
+    pub fn check(self: *Prompt, _: g.Gate) !?[]const u8 {
+        const got = try self.rig.outputBytes();
+        const base = try self.replaced();
+        if (!std.mem.eql(u8, got, base)) return "N128 bytes differ from unchanged N64 baseline";
+        return null;
+    }
+
+    // Half-integer E2M1 codes in the A16 compact schema; this does not call the device packer.
+    fn put(self: *Prompt, w: []u32, e: usize, m: usize, n: usize, k: usize, code: u8) void {
+        const parts: usize = if (self.up) 2 else 1;
+        const base = (((e * (self.shape.n / 32) + n / 32) * (self.shape.k / 32) + k / 32) * parts + m) * 144;
+        const j = (n % 32) / 8;
+        const group = n % 8;
+        const t = (k % 16) / 4;
+        const h = (k % 32) / 16;
+        const q = k % 4;
+        const shift: u5 = @intCast(4 * (2 * h + q / 2 + 4 * (q % 2)));
+        const at = base + (group * 4 + t) * 4 + j;
+        w[at] = (w[at] & ~(@as(u32, 15) << shift)) | (@as(u32, code) << shift);
+    }
+
+    /// Mirror large positive/negative integer products, leaving -128. Every FP32 partial is < 2^24.
+    /// Input max 96 quantizes exactly with scale 16; all weight block scales are 8, globals 1/256.
+    /// Up's gate has one product 256, hence gate=1; its up sum=-128, hence up=-0.5, with no clipping.
+    fn stress(self: *Prompt, a: std.mem.Allocator, rng: std.Random, x: []u16, w: []u32,
+        globals: []f32, input: []f32) !void
+    {
+        const k = self.shape.k;
+        const n = self.shape.n;
+        const half = k / 2;
+        const xrows = if (self.up) self.shape.rows else self.shape.rows * slots;
+        @memset(x, c.toBf16(96));
+        for (0..xrows) |row| x[row * (k + 16)] = c.toBf16(64);
+        @memset(w, 0);
+        var block: usize = 0;
+        while (block < w.len) : (block += 144) @memset(std.mem.sliceAsBytes(w[block + 128 .. block + 144]), 0x50);
+        @memset(globals, 1.0 / 256.0);
+        @memset(input, 1);
+        self.stress_terms = try a.alloc(f64, n * k);
+        const part: usize = if (self.up) 1 else 0;
+        for (0..n) |col| {
+            for (0..half) |i| {
+                const code: u8 = if (i == 0) 1 else 6 + rng.uintLessThan(u8, 2);
+                const value: f64 = if (code == 1) 4 else if (code == 6) 32 else 48;
+                self.stress_terms[col * k + i] = (if (i == 0) @as(f64, 64) else 96) * value;
+                self.stress_terms[col * k + half + i] = -96 * value;
+                for (0..experts) |e| {
+                    self.put(w, e, part, col, i, code);
+                    self.put(w, e, part, col, half + i, code | 8);
+                }
+            }
+            if (self.up) for (0..experts) |e| self.put(w, e, 0, col, 0, 1);
+        }
+    }
+
+    fn bf(v: f64) f64 {
+        return c.fromBf16(c.toBf16(@floatCast(v)));
+    }
+
+    /// The actual BF16 boundaries and CUDA fmin/fmax NaN handling, including the final BF16 store.
+    fn finish(self: *Prompt, sum: f64) f64 {
+        const scaled: f64 = @as(f32, @floatCast(sum * (1.0 / 256.0)));
+        if (!self.up) return bf(scaled);
+        var up = bf(scaled);
+        if (std.math.isNan(up)) up = -10;
+        up = std.math.clamp(up, -10, 10);
+        const gate_silu = bf(1.0 / (1.0 + @exp(-@as(f64, 1))));
+        return bf(gate_silu * up);
+    }
+
+    pub fn reference(self: *Prompt, want: []f64, mag: []f64) !void {
+        if (self.stress_terms.len == 0) return error.BitPreservingReplacementOnly;
+        const n = self.shape.n;
+        const k = self.shape.k;
+        for (0..n) |col| {
+            var sum: f64 = 0;
+            var magnitude: f64 = 0;
+            for (self.stress_terms[col * k ..][0..k]) |v| {
+                sum += v;
+                magnitude += @abs(v);
+            }
+            for (0..self.shape.rows * slots) |row| {
+                want[row * n + col] = self.finish(sum);
+                mag[row * n + col] = magnitude;
+            }
+        }
+    }
+
+    pub fn simulate(self: *Prompt, acc: c.Accum, order: g.Order, out: []f64) !void {
+        if (self.stress_terms.len == 0) return error.NotStressInputs;
+        const n = self.shape.n;
+        const k = self.shape.k;
+        for (0..n) |col| {
+            const sum = core.contract.rows.sumIn(acc, order, self.stress_terms[col * k ..][0..k]);
+            for (0..self.shape.rows * slots) |row| out[row * n + col] = self.finish(sum);
+        }
+    }
+
+    /// Gate 4's integer partials and 1/256 alpha are exact; final BF16 boundaries are in the reference.
+    /// silu(1)=0.73105858 rounds to 0.73046875, far from either BF16 midpoint; the product is dyadic.
+    pub fn bounds(self: *Prompt, _: []const f64, _: []const f64, allow: []f64) !void {
+        if (self.stress_terms.len == 0) return error.NotStressInputs;
+        @memset(allow, 0);
+    }
+};
+
+/// Focused gates 1-5 for the same registrations, without loading unrelated families or their controls.
+pub fn run(gpu: check_.Gpu) !void {
+    if (try gpu.ctx.capability() != 121) return error.GlmA4RequiresSm121;
+    if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.nvfp4_experts);
+    defer mod.unload();
+    var up = try Prompt.init(.{ .gpu = gpu, .s = s }, true, mod);
+    defer up.deinit();
+    var down = try Prompt.init(.{ .gpu = gpu, .s = s }, false, mod);
+    defer down.deinit();
+    const kernels = [_]g.Kernel{ up.kernel(), down.kernel() };
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, &kernels, 0x6b63, &tally);
+    const limits = core.contract.limits;
+    var problems: usize = 0;
+    var count_: usize = 0;
+    for (core.contract.registry.all_cuda) |r| {
+        if (!std.mem.startsWith(u8, r.launch.name, "glm_a4 ")) continue;
+        count_ += 1;
+        const symbol = try gpu.gpa.dupeSentinel(u8, r.launch.symbol, 0);
+        defer gpu.gpa.free(symbol);
+        const f = try mod.function(symbol);
+        const got: limits.Usage = .{ .regs = @intCast(try f.attribute(.num_regs)),
+            .static = @intCast(try f.attribute(.shared_size_bytes)),
+            .bound = @intCast(try f.attribute(.max_threads_per_block)),
+            .local = @intCast(try f.attribute(.local_size_bytes)) };
+        var errors: std.ArrayList(u8) = .empty;
+        defer errors.deinit(gpu.gpa);
+        problems += try limits.cuda(r.launch, got, limits.sms[4], &errors, gpu.gpa);
+        const current = std.meta.eql(got, r.usage[4]);
+        if (!current) problems += 1;
+        std.debug.print("{s} limits {s}: regs={d} shared={d} bound={d} local={d} (record {s})\n",
+            .{ if (current and errors.items.len == 0) "PASS" else "FAIL", r.launch.name,
+                got.regs, got.static, got.bound, got.local, if (current) "current" else "stale" });
+        if (errors.items.len > 0) std.debug.print("{s}", .{errors.items});
+    }
+    if (count_ != 4) problems += 1;
+    std.debug.print("A4 candidate: {d} pass, {d} fail, {d} known; {d} limit problems\n",
+        .{ tally.passed, tally.failed, tally.known, problems });
+    try check_.expect(tally.problems() + problems == 0,
+        "A4 candidate failed: {d} kernels, {d} physical limits", .{ tally.failed, problems });
+}
