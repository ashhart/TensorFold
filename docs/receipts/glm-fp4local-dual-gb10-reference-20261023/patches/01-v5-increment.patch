+//! GLM-only A4 prompt launch, sharing the existing compact A16 weight pack.
+const std = @import("std");
+const ex = @import("experts.zig");
+const cuda_module = @import("module.zig");
+const launch = @import("launch.zig");
+const Stream = @import("stream.zig").Stream;
+const Plan = @import("grouped.zig").Plan;
+
+pub fn nTile(value: ?[]const u8) !usize {
+    const v = value orelse return 64;
+    if (std.mem.eql(u8, v, "64")) return 64;
+    if (std.mem.eql(u8, v, "128")) return 128;
+    return error.BadGlmA4Tile;
+}
+
+pub fn run(mod: cuda_module.Module, s: Stream, epi: ex.Epi, in: ex.Rows, l: ex.Layer, p: Plan, out: u64, items: usize, skip: i32) !void {
+    if (l.input_scales == 0) return error.MissingA4InputScales;
+    if (l.relu2 or epi == .down_f32 or l.format != .nvfp4) return error.UnsupportedGlmA4;
+    const up = epi == .up;
+    const n = if (up) l.width else l.dims;
+    const k = if (up) l.dims else l.width;
+    if (n % 32 != 0 or k % 64 != 0) return error.UnsupportedGlmA4Shape;
+    if (items == 0) return;
+    const value = if (std.c.getenv("TF_GLM_A4_N_TILE")) |v| std.mem.span(v) else null;
+    const tile = try nTile(value);
+    const name: [:0]const u8 = if (tile == 128)
+        (if (up) "tf_glm_a4_prompt_up_n128" else "tf_glm_a4_prompt_down_n128")
+    else
+        (if (up) "tf_glm_a4_prompt_up" else "tf_glm_a4_prompt_down");
+    const f = try mod.function(name);
+    var a: launch.Args = .{};
+    a.add(in.x);
+    a.add(@as(i32, @intCast(in.stride)));
+    a.add(@as(i32, @intCast(if (up) in.slots else 0)));
+    a.add(if (up) l.up else l.down);
+    a.add(if (up) l.up_scale else l.down_scale);
+    a.add(l.input_scales);
+    a.add(@as(i32, @intCast(k)));
+    a.add(@as(i32, @intCast(n)));
+    for ([_]u64{ p.items, p.counts, p.members, out }) |v| a.add(v);
+    a.add(l.limit);
+    a.add(skip);
+    try launch.launch(f, .{ .grid = .{ .x = @intCast(items * ((n + tile - 1) / tile)) }, .block = .{ .x = @intCast(tile * 2) } }, s, &a);
+}
+
+test "A4 prompt tile choice is explicit and preserves the baseline default" {
+    try std.testing.expectEqual(@as(usize, 64), try nTile(null));
+    try std.testing.expectEqual(@as(usize, 64), try nTile("64"));
+    try std.testing.expectEqual(@as(usize, 128), try nTile("128"));
+    try std.testing.expectError(error.BadGlmA4Tile, nTile("256"));
+    try std.testing.expectError(error.BadGlmA4Tile, nTile(""));
+}
