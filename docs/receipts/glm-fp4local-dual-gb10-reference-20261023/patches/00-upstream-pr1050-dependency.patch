@@ -0,0 +1,166 @@
+//! FP4-Local's float32 norm weights under the contract: rmsnorm_4096_f32w and hc_finish_f32w, each output alone.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const ref = @import("contract_glm_f32w_ref.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const d = ref.d;
+
+/// norm_*: rmsnorm_4096_f32w's rows and their 64-sums; hc_*: hc_finish_f32w's normed rows, 64-sums, post and comb.
+pub const Which = enum { norm_y, norm_sums, hc_y, hc_sums, hc_post, hc_comb };
+
+/// A thread's 16 squares in one fma chain, the warp's butterfly, then 8 warps' partials by butterfly.
+fn normDepth(_: c.Shape) usize {
+    return 16 + 5 + 3;
+}
+
+/// hc_finish's 16 squares in fma and mul-add pairs (23 roundings), then the same butterflies.
+fn hcDepth(_: c.Shape) usize {
+    return 23 + 5 + 3;
+}
+
+/// A thread's 8 outputs in one chain, then 8 threads by xor 4, 2 and 1.
+fn groupDepth(_: c.Shape) usize {
+    return 7 + 3;
+}
+
+/// The 16 K blocks' partials of a logit and of the squares, each one chain.
+fn mixDepth(_: c.Shape) usize {
+    return ref.nb;
+}
+
+const rms_why = "a bf16 output follows the sum of squares as ss^-1/2: a bf16 sum's error is a few output ulps";
+const hc_why = "three bf16 roundings in the bound: fp16 squares overflow to a zero output, 64 bounds; bf16 sums move it ulps";
+const sums_why = "64 terms of at most 8 bits: fp16 holds every partial, so bf16's miss is the one shown";
+const mix_why = "16 integer partials: fp16 holds every one, so bf16's miss is the one shown";
+
+pub fn spec(w: Which) c.Spec {
+    const rows4096: []const c.Shape = &.{ .{ .rows = 1, .n = d, .k = d }, .{ .rows = 70, .n = d, .k = d } };
+    const groups: []const c.Shape = &.{ .{ .rows = 1, .n = 64, .k = 64 }, .{ .rows = 70, .n = 64, .k = 64 } };
+    return switch (w) {
+        .norm_y => .{ .name = "cuda glm tf_glm_rmsnorm_4096_f32w (float32 norm weight)", .accum = .f32, .depth = normDepth, .ops = 8, .mids = 1, .out = .bf16, .served = rows4096, .sums = .{ .bf16 = 0, .why = rms_why } },
+        .norm_sums => .{ .name = "cuda glm tf_glm_rmsnorm_4096_f32w (its 64-sums)", .accum = .f32, .depth = groupDepth, .out = .f32, .served = groups, .sums = .{ .f16 = 0, .why = sums_why } },
+        .hc_y => .{ .name = "cuda glm tf_glm_hc_finish_f32w (normed rows)", .accum = .f32, .depth = hcDepth, .ops = 8, .mids = 3, .out = .bf16, .served = rows4096, .sums = .{ .f16 = 0, .bf16 = 0, .why = hc_why } },
+        .hc_sums => .{ .name = "cuda glm tf_glm_hc_finish_f32w (its 64-sums)", .accum = .f32, .depth = groupDepth, .out = .f32, .served = groups, .sums = .{ .f16 = 0, .why = sums_why } },
+        .hc_post => .{ .name = "cuda glm tf_glm_hc_finish_f32w (post)", .accum = .f32, .depth = mixDepth, .ops = 16, .out = .f32, .served = &.{ .{ .rows = 1, .n = 4, .k = ref.nb }, .{ .rows = 70, .n = 4, .k = ref.nb } }, .sums = .{ .f16 = 0, .why = mix_why } },
+        .hc_comb => .{ .name = "cuda glm tf_glm_hc_finish_f32w (comb, Sinkhorn)", .accum = .f32, .depth = mixDepth, .ops = 256, .out = .f32, .served = &.{ .{ .rows = 1, .n = 16, .k = ref.nb }, .{ .rows = 70, .n = 16, .k = ref.nb } }, .sums = .{ .f16 = 0, .why = mix_why } },
+    };
+}
+
+/// `gamma` rounded to bf16 and back: what a kernel reading a bf16 weight multiplies by; the reference keeps float32.
+fn narrowed(a: std.mem.Allocator, gamma: []const f32) ![]f32 {
+    const out = try a.alloc(f32, gamma.len);
+    for (out, gamma) |*o, v| o.* = @floatCast(ref.bf(v));
+    return out;
+}
+
+pub const F32w = struct {
+    rig: rig_.Rig,
+    which: Which,
+    f: cuda.Function,
+    in: ?ref.In = null,
+    arena: std.heap.ArenaAllocator,
+    ptrs: [9]u64 = @splat(0), // norm: x, gamma, y, xs; hc: x, part, base, scale, gamma, y, xs, post, comb
+    bf16_gamma: bool = false, // gate 3's control: the weight uploaded as bf16 values, as a bf16-weight kernel reads it
+
+    pub fn init(rig: rig_.Rig, which: Which, f: cuda.Function) F32w {
+        return .{ .rig = rig, .which = which, .f = f, .arena = .init(rig.gpu.gpa) };
+    }
+
+    pub fn deinit(self: *F32w) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *F32w) g.Kernel {
+        var declared = spec(self.which);
+        if (self.bf16_gamma) declared.name = "control: a float32 norm weight read as bf16";
+        return .{ .spec = declared, .ctx = self, .vt = &vt, .control = if (self.bf16_gamma) .shapes else null };
+    }
+
+    const vt = g.hooks(F32w);
+
+    fn hc(self: *const F32w) bool {
+        return switch (self.which) {
+            .norm_y, .norm_sums => false,
+            else => true,
+        };
+    }
+
+    /// The inputs (`ref.fill`), the checked output, and the kernel's other outputs as scratch.
+    pub fn prepare(self: *F32w, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        const served = spec(self.which).served[0];
+        if (shape.n != served.n or shape.k != served.k) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const exact = self.which == .norm_sums or self.which == .hc_sums;
+        const in = try ref.fill(self.arena.allocator(), self.hc(), shape.rows, fill, seed, exact);
+        self.in = in;
+        const r = &self.rig;
+        const n = shape.rows;
+        const y = if (self.which == .norm_y or self.which == .hc_y) try r.output(n * d * 2) else try r.scratch(n * d * 2);
+        const xs = if (exact) try r.output(n * (d / 64) * 4) else if (self.hc()) try r.scratch(n * (d / 64) * 4) else 0;
+        const x = try r.input(std.mem.sliceAsBytes(in.x));
+        const gm = try r.input(std.mem.sliceAsBytes(if (self.bf16_gamma) try narrowed(self.arena.allocator(), in.gamma) else in.gamma));
+        if (!self.hc()) {
+            self.ptrs = .{ x, gm, y, xs, 0, 0, 0, 0, 0 };
+            return true;
+        }
+        const part = try r.input(std.mem.sliceAsBytes(in.part));
+        const base = try r.input(std.mem.asBytes(&in.base));
+        const sc = try r.input(std.mem.asBytes(&ref.scale));
+        const post = if (self.which == .hc_post) try r.output(n * 4 * 4) else try r.scratch(n * 4 * 4);
+        const comb = if (self.which == .hc_comb) try r.output(n * 16 * 4) else try r.scratch(n * 16 * 4);
+        self.ptrs = .{ x, part, base, sc, gm, y, xs, post, comb };
+        return true;
+    }
+
+    /// One launch, 256 threads a row: the norm's (x, stride, w, out, stride, xs, eps, sums) or hc_finish's arguments.
+    pub fn run(self: *F32w) !void {
+        const p = self.ptrs;
+        const in = self.in.?;
+        var a: cuda.Args = .{};
+        if (self.hc()) {
+            inline for (p) |v| a.add(v);
+            inline for (.{ in.eps, in.hc_eps, @as(c_int, ref.nb), @as(c_int, ref.iters) }) |v| a.add(v);
+        } else {
+            inline for (.{ p[0], @as(i64, d), p[1], p[2], @as(i64, d), p[3], in.eps, @as(c_int, @intFromBool(p[3] != 0)) }) |v| a.add(v);
+        }
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = @intCast(in.rows) }, .block = .{ .x = 256 } }, self.rig.s, &a);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *F32w) usize {
+        const n = self.in.?.rows;
+        return n * @as(usize, switch (self.which) {
+            .norm_y, .hc_y => d,
+            .norm_sums, .hc_sums => d / 64,
+            .hc_post => 4,
+            .hc_comb => 16,
+        });
+    }
+
+    fn outputs(self: *F32w, m: ref.Sum, want: []f64, mag: []f64) !void {
+        const in = self.in.?;
+        const a = self.arena.allocator();
+        switch (self.which) {
+            .norm_y, .hc_y => try ref.normed(a, in, m, want, mag),
+            .norm_sums, .hc_sums => try ref.sums(a, in, m, want, mag),
+            .hc_post => ref.post(in, m, want, mag),
+            .hc_comb => ref.comb(in, m, want, mag),
+        }
+    }
+
+    pub fn reference(self: *F32w, want: []f64, mag: []f64) !void {
+        return self.outputs(.{}, want, mag);
+    }
+
+    pub fn simulate(self: *F32w, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const mag = try self.arena.allocator().alloc(f64, out.len);
+        return self.outputs(.{ .acc = acc, .order = order }, out, mag);
+    }
+};
diff --git a/zig/tests/cuda/contract_glm_f32w_ref.zig b/zig/tests/cuda/contract_glm_f32w_ref.zig
new file mode 100644
index 00000000..2ffcdb1a
--- /dev/null
+++ b/zig/tests/cuda/contract_glm_f32w_ref.zig
@@ -0,0 +1,261 @@
+//! FP4-Local's float32 norm weight kernels in float64 (rmsnorm_4096_f32w, hc_finish_f32w): the inputs and references.
+const std = @import("std");
+const core = @import("core");
+
+const contract = core.contract;
+const c = contract.spec;
+const Order = contract.gates.Order;
+const Fill = contract.gates.Fill;
+const sumIn = contract.rows.sumIn;
+
+pub const d = 4096;
+pub const s = 4;
+pub const nb = 16; // glue.hc_blocks
+pub const iters = 20;
+pub const scale = [3]f32{ 0.7, 0.9, 1.1 };
+
+/// What a call reads: x bf16 [rows][d] (norm) or [rows][s][d] (hc), the float32 weight, hc's partials and logits' base.
+pub const In = struct {
+    hc: bool,
+    rows: usize,
+    x: []u16,
+    gamma: []f32,
+    part: []f32, // [rows][nb][32]: 24 dots, then the K block's sum of squares
+    base: [24]f32,
+    eps: f32,
+    hc_eps: f32,
+};
+
+/// A row's sums: exact in float64, or as an accumulator in an order would add them (gate 4's simulation).
+pub const Sum = struct {
+    acc: ?c.Accum = null,
+    order: Order = .sequential,
+
+    pub fn of(m: Sum, t: []const f64) f64 {
+        if (m.acc) |a| return sumIn(a, m.order, t);
+        var v: f64 = 0;
+        for (t) |x| v += x;
+        return v;
+    }
+};
+
+pub fn bf(v: f64) f64 {
+    return c.fromBf16(c.toBf16(@floatCast(v)));
+}
+
+/// fmaxf: a NaN operand gives the other one.
+fn fmax(a: f64, b: f64) f64 {
+    return if (std.math.isNan(a)) b else if (std.math.isNan(b)) a else @max(a, b);
+}
+
+fn sigmoid(v: f64) f64 {
+    return 1 / (@exp(0 - v) + 1);
+}
+
+/// Inputs for a fill (stress: integer terms); `exact`: rows whose norm is x itself, so the 64-sums' reference is exact.
+pub fn fill(a: std.mem.Allocator, hc: bool, rows: usize, mode: Fill, seed: u64, exact: bool) !In {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rng = prng.random();
+    const x = try a.alloc(u16, rows * d * @as(usize, if (hc) s else 1));
+    const gamma = try a.alloc(f32, d);
+    const part = try a.alloc(f32, if (hc) rows * nb * 32 else 0);
+    var in: In = .{ .hc = hc, .rows = rows, .x = x, .gamma = gamma, .part = part, .base = undefined, .eps = 1e-6, .hc_eps = 1e-6 };
+    const stress = mode == .stress;
+    for (gamma) |*g| g.* = if (exact) 1 else 0.5 + rng.float(f32);
+    for (&in.base) |*b| b.* = (rng.float(f32) * 2 - 1) * 0.5;
+    for (part, 0..) |*p, i| p.* = if (i % 32 == 24) // stress logits under 30, where fp32's exp keeps every entry
+        (if (stress) @floatFromInt(1024 + rng.uintLessThan(u32, 1024)) else 200 + rng.float(f32) * 200)
+    else if (stress) @as(f32, @floatFromInt(rng.uintLessThan(u32, 5))) - 2 else rng.float(f32) * 2 - 1;
+    if (exact or (hc and stress)) { // signed permutations of one row; eps 1 - mean square; hc's c = stream 0 / 2
+        const row = try a.alloc(f64, d);
+        defer a.free(row);
+        for (row, 0..) |*v, i| v.* = if (stress)
+            @as(f64, @floatFromInt(rng.uintLessThan(u32, 64))) - 31
+        else
+            bf((rng.float(f64) * 2 - 1) * (if (i % 64 == 7) @as(f64, 20) else 1));
+        var ss: f64 = 0;
+        for (row) |v| ss += v * v;
+        if (exact) in.eps = @floatCast(1 - ss / d);
+        if (hc) { // pre 0.5: zero dots, base and hc_eps; squares that keep the logits' rms finite under that eps
+            in.hc_eps = 0;
+            for (in.base[0..4]) |*b| b.* = 0;
+            const sq: f32 = @ceil((@abs(in.eps) + 1) * s * d / nb);
+            for (0..rows) |r| for (0..nb) |b| {
+                for (0..4) |k| part[(r * nb + b) * 32 + k] = 0;
+                if (exact) part[(r * nb + b) * 32 + 24] = sq;
+            };
+        }
+        const order = try a.alloc(usize, d);
+        defer a.free(order);
+        for (0..rows) |r| {
+            for (order, 0..) |*o, i| o.* = i;
+            rng.shuffle(usize, order);
+            for (0..d) |i| {
+                const v = row[order[i]] * @as(f64, if (rng.boolean()) -1 else 1);
+                if (hc) {
+                    x[(r * s) * d + i] = c.toBf16(@floatCast(2 * v));
+                    for (1..s) |k| x[(r * s + k) * d + i] = 0;
+                } else x[r * d + i] = c.toBf16(@floatCast(v));
+            }
+        }
+    } else for (x, 0..) |*v, i| {
+        v.* = c.toBf16(if (stress) @floatFromInt(@as(i32, @intCast(rng.uintLessThan(u32, 65))) - 32) else (rng.float(f32) * 2 - 1) * (if (i % 64 == 7) @as(f32, 20) else 1));
+    }
+    if (mode == .nonfinite) plant(&in);
+    return in;
+}
+
+/// NaN and both infinities in rows 0 to 3: x (the norms' outputs), and hc's dots for post (4, 5) and comb (8, 9).
+fn plant(in: *In) void {
+    const nan = c.toBf16(std.math.nan(f32));
+    const inf = c.toBf16(std.math.inf(f32));
+    const ninf = c.toBf16(-std.math.inf(f32));
+    const w: usize = if (in.hc) s * d else d;
+    const at = [_][2]usize{ .{ 0, d / 3 }, .{ 1, d / 2 }, .{ 2, d - 1 }, .{ 3, 0 } };
+    const put = [_]u16{ nan, inf, ninf, inf };
+    for (at, put) |p, v| if (p[0] < in.rows) {
+        in.x[p[0] * w + p[1]] = v;
+    };
+    if (!in.hc) return;
+    const dots = [_][3]usize{ .{ 0, 3, 4 }, .{ 1, 5, 5 }, .{ 2, 0, 8 }, .{ 3, 15, 9 } };
+    const vals = [_]f32{ std.math.nan(f32), std.math.inf(f32), -std.math.inf(f32), std.math.nan(f32) };
+    for (dots, vals) |p, v| if (p[0] < in.rows) {
+        in.part[(p[0] * nb + p[1]) * 32 + p[2]] = v;
+    };
+}
+
+fn xv(in: In, i: usize) f64 {
+    return c.fromBf16(in.x[i]);
+}
+
+/// A row's hc logits: the 24 mixing sums times rinv of the squares' sum, and each one's |terms| times that rinv.
+fn mixRow(in: In, r: usize, m: Sum, mixn: *[24]f64, mass: *[24]f64) void {
+    var t: [nb]f64 = undefined;
+    for (0..nb) |b| t[b] = in.part[(r * nb + b) * 32 + 24];
+    const rinv = 1 / @sqrt(in.eps + m.of(&t) / (s * d));
+    for (0..24) |k| {
+        var abs: f64 = 0;
+        for (0..nb) |b| {
+            t[b] = in.part[(r * nb + b) * 32 + k];
+            abs += @abs(t[b]);
+        }
+        mixn[k] = m.of(&t) * rinv;
+        mass[k] = abs * rinv;
+    }
+}
+
+/// rmsnorm_4096_f32w's outputs [rows][d] or hc_finish_f32w's normed rows, unrounded; `mag` each one's sums' terms.
+pub fn normed(a: std.mem.Allocator, in: In, m: Sum, want: []f64, mag: []f64) !void {
+    const cv = try a.alloc(f64, d);
+    defer a.free(cv);
+    const cm = try a.alloc(f64, d); // the |terms| of each c: hc's collapse and its logits' sums
+    defer a.free(cm);
+    const sq = try a.alloc(f64, d);
+    defer a.free(sq);
+    for (0..in.rows) |r| {
+        if (in.hc) {
+            var mixn: [24]f64 = undefined;
+            var mass: [24]f64 = undefined;
+            mixRow(in, r, m, &mixn, &mass);
+            var pre: [s]f64 = undefined;
+            var dpre: [s]f64 = undefined; // pre's sensitivity to its logit's sum: sigmoid' <= 1/4, rinv's own error 1/2
+            for (0..s) |k| {
+                pre[k] = in.hc_eps + sigmoid(mixn[k] * scale[0] + in.base[k]);
+                dpre[k] = 0.25 * scale[0] * 1.5 * mass[k];
+            }
+            for (cv, cm, 0..) |*o, *om, i| {
+                var t: [s]f64 = undefined;
+                om.* = 0;
+                for (0..s) |k| {
+                    const xk = xv(in, (r * s + k) * d + i);
+                    t[k] = pre[k] * xk;
+                    om.* += @abs(t[k]) + @abs(xk) * dpre[k];
+                }
+                o.* = m.of(&t);
+            }
+        } else for (cv, cm, 0..) |*o, *om, i| {
+            o.* = xv(in, r * d + i);
+            om.* = 0;
+        }
+        for (sq, cv) |*q, v| q.* = v * v;
+        const rinv = 1 / @sqrt(in.eps + m.of(sq) / d);
+        for (want[r * d ..][0..d], mag[r * d ..][0..d], cv, cm, in.gamma) |*w, *g, v, om, gm| {
+            w.* = gm * rinv * v;
+            g.* = gm * rinv * om + @abs(w.*) / 2; // y ~ ss^-1/2
+        }
+    }
+}
+
+/// Each 64 outputs' sum, the outputs rounded as the kernel does, bf16(gamma bf16(rinv c)), from `fill`'s exact rows.
+pub fn sums(a: std.mem.Allocator, in: In, m: Sum, want: []f64, mag: []f64) !void {
+    const row = try a.alloc(f64, d);
+    defer a.free(row);
+    for (0..in.rows) |r| {
+        var sq: f64 = 0;
+        for (row, 0..) |*v, i| {
+            v.* = if (in.hc) bf(0.5 * xv(in, (r * s) * d + i)) else xv(in, r * d + i);
+            sq += v.* * v.*;
+        }
+        const rinv = 1 / @sqrt(in.eps + sq / d);
+        for (row, in.gamma) |*o, gm| o.* = bf(gm * bf(rinv * o.*));
+        for (0..d / 64) |g| {
+            const t = row[g * 64 ..][0..64];
+            var abs: f64 = 0;
+            for (t) |v| abs += @abs(v);
+            want[r * (d / 64) + g] = m.of(t);
+            mag[r * (d / 64) + g] = abs;
+        }
+    }
+}
+
+/// hc_finish_f32w's post: 2 sigmoid of the logits 4 to 7; `mag` the logits' sums' terms through sigmoid' (1/4).
+pub fn post(in: In, m: Sum, want: []f64, mag: []f64) void {
+    for (0..in.rows) |r| {
+        var mixn: [24]f64 = undefined;
+        var mass: [24]f64 = undefined;
+        mixRow(in, r, m, &mixn, &mass);
+        for (0..4) |k| {
+            want[r * 4 + k] = 2 * sigmoid(mixn[4 + k] * scale[1] + in.base[4 + k]);
+            mag[r * 4 + k] = 0.5 * scale[1] * 1.5 * mass[4 + k] + @abs(want[r * 4 + k]);
+        }
+    }
+}
+
+/// hc_finish_f32w's comb: rows' softmax of the 4x4 logits plus hc_eps, then Sinkhorn's column and row normalizations.
+pub fn comb(in: In, m: Sum, want: []f64, mag: []f64) void {
+    for (0..in.rows) |r| {
+        var mixn: [24]f64 = undefined;
+        var mass: [24]f64 = undefined;
+        mixRow(in, r, m, &mixn, &mass);
+        var cm: [16]f64 = undefined;
+        var most: f64 = 0;
+        for (0..16) |i| most = @max(most, mass[8 + i]);
+        for (0..4) |i| {
+            var cl: [4]f64 = undefined;
+            var top: f64 = std.math.nan(f64);
+            for (0..4) |j| {
+                cl[j] = mixn[8 + 4 * i + j] * scale[2] + in.base[8 + 4 * i + j];
+                top = fmax(top, cl[j]);
+            }
+            var e: [4]f64 = undefined;
+            for (&e, cl) |*o, v| o.* = @exp(v - top);
+            const sum = (e[0] + e[1]) + (e[2] + e[3]);
+            for (0..4) |j| cm[4 * i + j] = in.hc_eps + e[j] / sum;
+        }
+        normalize(&cm, in.hc_eps, .col);
+        for (1..iters) |_| {
+            normalize(&cm, in.hc_eps, .row);
+            normalize(&cm, in.hc_eps, .col);
+        }
+        for (0..16) |i| {
+            want[r * 16 + i] = cm[i];
+            mag[r * 16 + i] = @abs(cm[i]) * 2 * scale[2] * 1.5 * most; // a logit's error moves each entry twice it
+        }
+    }
+}
+
+fn normalize(cm: *[16]f64, eps: f64, by: enum { row, col }) void {
+    var tot: [4]f64 = @splat(0);
+    for (0..16) |idx| tot[if (by == .row) idx / 4 else idx % 4] += cm[idx];
+    for (0..16) |idx| cm[idx] /= eps + tot[if (by == .row) idx / 4 else idx % 4];
+}
