--- /dev/null
+++ b/zig/glm_low8_host.zig
@@ -0,0 +1,149 @@
+//! Actual narrow expert dispatch and launch ABI, recorded on the CPU; no device arithmetic is simulated.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm");
+const t = std.testing;
+const Low8 = cuda.experts.Nvfp4Experts.Low8;
+
+const Mock = struct {
+    var lookups: usize = 0;
+    var occupancies: usize = 0;
+    var launches: usize = 0;
+    var fail_occupancy: usize = 0;
+    var fail_launch: bool = false;
+    var tag: usize = 0;
+    var cfg: [7]u32 = undefined;
+    var args: [14]u64 = undefined;
+
+    fn reset() void {
+        lookups = 0;
+        occupancies = 0;
+        launches = 0;
+        fail_occupancy = 0;
+        fail_launch = false;
+    }
+    fn function(out: *cuda.abi.Function, _: cuda.abi.Module, name: [*:0]const u8) callconv(.c) cuda.abi.Result {
+        for (Low8.symbols, 0..) |symbol, i| if (std.mem.eql(u8, std.mem.span(name), symbol)) {
+            lookups += 1;
+            out.* = @ptrFromInt(i + 1);
+            return 0;
+        };
+        unreachable; // a typo in the production symbol list must not silently pass this recorder
+    }
+    fn occupancy(out: *c_int, function_: cuda.abi.Function, threads: c_int, shared: usize) callconv(.c) cuda.abi.Result {
+        std.debug.assert(threads == 128 and shared == 0);
+        occupancies += 1;
+        if (fail_occupancy == occupancies) return cuda.abi.error_not_ready;
+        out.* = @intCast(@intFromPtr(function_) + 1);
+        return 0;
+    }
+    fn read(comptime T: type, values: ?[*]?*anyopaque, i: usize) T {
+        return @as(*const T, @ptrCast(@alignCast(values.?[i].?))).*;
+    }
+    fn launch(function_: cuda.abi.Function, gx: c_uint, gy: c_uint, gz: c_uint,
+        bx: c_uint, by: c_uint, bz: c_uint, shared: c_uint, stream: cuda.abi.Stream,
+        values: ?[*]?*anyopaque, extra: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result
+    {
+        std.debug.assert(stream == null and extra == null);
+        launches += 1;
+        tag = @intFromPtr(function_);
+        cfg = .{ gx, gy, gz, bx, by, bz, shared };
+        for (0..14) |i| args[i] = switch (i) {
+            0, 3, 4, 7, 8, 9, 10 => read(u64, values, i),
+            else => read(u32, values, i),
+        };
+        return if (fail_launch) cuda.abi.error_not_ready else 0;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuModuleGetFunction = function;
+        d.api.cuOccupancyMaxActiveBlocksPerMultiprocessor = occupancy;
+        d.api.cuLaunchKernel = launch;
+        return d;
+    }
+};
+
+fn layer() cuda.experts.Layer {
+    return .{ .format = .nvfp4, .up = 100, .down = 200, .up_scale = 300, .down_scale = 400,
+        .width = 1024, .dims = 4096, .experts = 289, .limit = 10 };
+}
+const plan: cuda.grouped.Plan = .{ .items = 500, .counts = 600, .members = 700, .rank = 800, .hist = 900 };
+
+test "GLM low8: flag defaults off, validates values and confines the served width" {
+    try t.expect(!try glm.experts.low8Flag(null));
+    try t.expect(!try glm.experts.low8Flag("0"));
+    try t.expect(try glm.experts.low8Flag("1"));
+    for ([_][]const u8{ "", "true", "2", "-1", " 1" }) |v|
+        try t.expectError(error.BadExpertLow8, glm.experts.low8Flag(v));
+    for (0..34) |rows| {
+        try t.expect(!glm.experts.useLow8(false, false, rows));
+        try t.expect(!glm.experts.useLow8(true, true, rows));
+        try t.expectEqual(rows > 0 and rows <= 8, glm.experts.useLow8(true, false, rows));
+    }
+}
+
+test "GLM low8: independent symbols and occupancy require four-warps geometry" {
+    Mock.reset();
+    var d = Mock.driver();
+    const mod: cuda.Module = .{ .d = &d, .handle = null };
+    try t.expectError(error.Low8RequiresFourWarps, Low8.resolve(mod, 48, 1));
+    try t.expectEqual(@as(usize, 0), Mock.lookups);
+    const low = try Low8.resolve(mod, 48, 4);
+    try t.expectEqual(@as(usize, 4), Mock.lookups);
+    try t.expectEqual(@as(usize, 4), Mock.occupancies);
+    try t.expectEqualSlices(usize, &.{ 96, 144, 192, 240 }, &low.resident);
+    try t.expectEqualStrings("_ZN16tf_nvfp4_experts24nvfp4_expert_low8_kernelILi2ELi2ELi4EEEvPK13__nv_bfloat16iiPK5uint4PKfiiPKiSA_SA_Pvifi", Low8.symbols[0]);
+    Mock.reset();
+    Mock.fail_occupancy = 2;
+    try t.expectError(error.NotReady, Low8.resolve(mod, 48, 4));
+    try t.expectEqual(@as(usize, 2), Mock.lookups);
+    try t.expectEqual(@as(usize, 0), Mock.launches);
+}
+
+test "GLM low8: launch ABI preserves input, scales, skip, clamp and independent grid" {
+    Mock.reset();
+    var d = Mock.driver();
+    const low = try Low8.resolve(.{ .d = &d, .handle = null }, 48, 4);
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    const in: cuda.experts.Rows = .{ .x = 1000, .stride = 4096, .slots = 9 };
+    for ([_]cuda.experts.Epi{ .up, .down_f32, .down_bf16 }, 0..) |epi, i| {
+        try low.run(s, epi, in, layer(), plan, 1100, 100, 288);
+        try t.expectEqual(i + 1, Mock.tag);
+        try t.expectEqual([7]u32{ @intCast(low.resident[i]), 1, 1, 128, 1, 1, 0 }, Mock.cfg);
+        try t.expectEqualSlices(u64, &.{ 1000, 4096, if (i == 0) 9 else 0,
+            if (i == 0) 100 else 200, if (i == 0) 300 else 400,
+            if (i == 0) 128 else 32, if (i == 0) 32 else 128,
+            500, 600, 700, 1100, if (i == 0) 1024 else 4096,
+            if (i == 0) @as(u32, @bitCast(@as(f32, 10))) else 0, 288 }, &Mock.args);
+    }
+    const before = Mock.launches;
+    try low.run(s, @as(cuda.experts.Epi, .up), in, layer(), plan, 1100, 0, -1);
+    try t.expectEqual(before, Mock.launches);
+    Mock.fail_launch = true;
+    try t.expectError(error.NotReady, low.run(s, @as(cuda.experts.Epi, .up), in, layer(), plan, 1100, 1, -1));
+    try t.expectEqual([7]u32{ 8, 1, 1, 128, 1, 1, 0 }, Mock.cfg);
+    try t.expectEqual(@as(u64, 0xffffffff), Mock.args[13]);
+}
+
+test "GLM low8: actual family selects narrow only when loaded and leaves prompts and wide rows old" {
+    Mock.reset();
+    var d = Mock.driver();
+    var ks: glm.experts.Kernels = undefined;
+    ks.nvfp4 = .{ .mod = .{ .d = &d, .handle = null }, .fns = undefined, .resident = @splat(333),
+        .prompt_fns = undefined, .warps = 4 };
+    for (&ks.nvfp4.fns, 0..) |*fn_, i| fn_.* = .{ .d = &d, .handle = @ptrFromInt(10 + i) };
+    for (&ks.nvfp4.prompt_fns, 0..) |*fn_, i| fn_.* = .{ .d = &d, .handle = @ptrFromInt(20 + i) };
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    var p: glm.experts.Plan = .{ .route = plan, .slots = 9, .experts = 289, .prompt = false };
+    try glm.experts.run(&ks, s, .gate_up, layer(), p, 1000, 4096, 2, 1100, 288);
+    try t.expectEqual(@as(usize, 10), Mock.tag);
+    ks.nvfp4.low8 = try Low8.resolve(ks.nvfp4.mod, 48, 4);
+    for ([_]usize{ 1, 2, 8, 9, 16, 32 }) |rows| {
+        try glm.experts.run(&ks, s, .gate_up, layer(), p, 1000, 4096, rows, 1100, 288);
+        try t.expectEqual(@as(usize, if (rows <= 8) 1 else 10), Mock.tag);
+        p.prompt = true;
+        try glm.experts.run(&ks, s, .gate_up, layer(), p, 1000, 4096, rows, 1100, 288);
+        try t.expectEqual(@as(usize, 21), Mock.tag);
+        p.prompt = false;
+    }
+}
