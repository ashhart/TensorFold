     return g.decode(stream, epi, in, l, plan.route, out, maxItems(pairs, plan.experts, tile), skip);
+}
+
+pub fn low8Flag(value: ?[]const u8) !bool {
+    const v = value orelse return false;
+    if (std.mem.eql(u8, v, "0")) return false;
+    if (std.mem.eql(u8, v, "1")) return true;
+    return error.BadExpertLow8;
+}
+
+pub fn useLow8(enabled: bool, prompt: bool, rows: usize) bool {
+    return enabled and !prompt and rows > 0 and rows <= 8;
 }
 
 test "plan sizes as the Python family's" {
