+const PackedLayout = struct {
+    vocab: usize,
+    rows: usize,
+    half: usize,
+
+    fn init(vocab: usize, rows: usize, spans: []const Span) ?PackedLayout {
+        if (rows == 0 or vocab == 0 or vocab % 2 != 0 or spans.len != 2) return null;
+        const h = vocab / 2;
+        if (spans[0].lo != 0 or spans[0].hi != h or spans[1].lo != h or spans[1].hi != vocab) return null;
+        return .{ .vocab = vocab, .rows = rows, .half = h };
+    }
+
+    fn shardBytes(p: PackedLayout) usize {
+        return p.rows * p.half * 2;
+    }
+
+    fn copyAt(p: PackedLayout, row: usize, rank: usize) struct { dst: usize, src: usize, bytes: usize } {
+        std.debug.assert(row < p.rows and rank < 2);
+        return .{ .dst = (row * p.vocab + rank * p.half) * 2, .src = (rank * p.rows + row) * p.half * 2, .bytes = p.half * 2 };
+    }
+};
