diff --git a/zig/tests/cuda/glm_sample_gather.zig b/zig/tests/cuda/glm_sample_gather.zig
new file mode 100644
--- /dev/null
+++ b/zig/tests/cuda/glm_sample_gather.zig
@@ -0,0 +1,134 @@
+//! TP2 sampled-window transport: baseline broadcasts vs one all-gather, exact logits and tf_draw outputs.
+//! Both ranks: NCCL_COMM_ID=<rank0-ip>:<port> tf-cuda-test glm-sample-gather <rank> [roce]
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+
+const V = 154880;
+const H = V / 2;
+const capacity = 32;
+const max_rows = capacity + 1; // prompt-logprob gather has its own buffer beyond the sampler's capacity
+const guard = 32; // u16s, so the actual logits retain 16-byte alignment
+const cap_bytes = 4 * 1024 * 1024;
+const spans = [_]glm.shard.Span{ .{ .lo = 0, .hi = H }, .{ .lo = H, .hi = V } };
+
+pub fn run(gpu: check.Gpu, rank: usize, use_roce: bool) !void {
+    try check.expect(rank < 2, "glm-sample-gather needs rank0 or rank1", .{});
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var group = try cuda.tp_group.Group.open(rank, 2);
+    defer group.close();
+    if (use_roce) {
+        try group.openRoce(gpu.gpa, gpu.io, gpu.d, stream, cap_bytes);
+        try check.expect(group.fast != null, "requested RoCE did not come up", .{});
+    }
+    const exchange: glm.forward.Exchange = .{ .nccl = .{ .lib = &group.lib, .comm = group.comm, .group = &group } };
+    const nccl_only: glm.forward.Exchange = .{ .nccl = .{ .lib = &group.lib, .comm = group.comm } };
+    var baseline = try glm.sampler.Sampler.initWithGather(gpu.d, V, capacity, false);
+    defer baseline.deinit();
+    var batched = try glm.sampler.Sampler.initWithGather(gpu.d, V, capacity, true);
+    defer batched.deinit();
+    try check.expect(baseline.ranked == null and batched.ranked.?.len == capacity * V * 2, "OFF allocates no scratch; ON counts exactly rows*vocab*2 bytes", .{});
+
+    const a = gpu.gpa;
+    const input = try a.alloc(u16, max_rows * H + 2 * guard);
+    defer a.free(input);
+    const source_after = try a.alloc(u16, input.len);
+    defer a.free(source_after);
+    const expected = try a.alloc(u16, max_rows * V);
+    defer a.free(expected);
+    const got = try a.alloc(u16, max_rows * V);
+    defer a.free(got);
+    var local = try cuda.DeviceBuffer.alloc(gpu.d, input.len * 2);
+    defer local.free();
+    var bigger = try cuda.DeviceBuffer.alloc(gpu.d, max_rows * V * 2);
+    defer bigger.free();
+    const mine = [_]glm.sampler.Local{.{ .rank = rank, .logits = local.ptr + guard * 2 }};
+
+    const words = (V + 31) / 32;
+    const mask = try a.alloc(u32, capacity * words);
+    defer a.free(mask);
+    for (mask, 0..) |*w, i| w.* = if ((i / words) % 2 == 0) 0x55555555 else 0xaaaaaaaa;
+    var bits = try cuda.DeviceBuffer.alloc(gpu.d, mask.len * 4);
+    defer bits.free();
+    try bits.uploadAsync(0, std.mem.sliceAsBytes(mask), stream.handle);
+    const rules = [_]glm.sampler.Rule{
+        glm.sampler.rule(.{ .seed = 7, .temperature = 1.0, .top_p = 0.95, .top_k = 20 }),
+        glm.sampler.rule(.{ .seed = 0xabcdef012345, .temperature = 0.6, .top_p = 0.8, .top_k = 0 }),
+        glm.sampler.rule(.{ .seed = 99, .temperature = 1.3, .top_p = 1.0, .top_k = 1 }),
+    };
+    var want_tokens: [capacity]u32 = undefined;
+    var got_tokens: [capacity]u32 = undefined;
+    var want_prob: [capacity]u32 = undefined;
+    var got_prob: [capacity]u32 = undefined;
+    var cases: usize = 0;
+
+    for ([_]usize{ 1, 2, 3, 4, 5, 6, 7, 8, 32 }) |rows| {
+        if (group.fast) |fast| try check.expect(fast.fits(rows * H * 2) == (rows != 32), "rows{d}: safe4MiB RoCE/NCCL selection", .{rows});
+        for (0..4) |fixture| {
+            fill(input, expected, rows, rank, fixture);
+            try local.uploadAsync(0, std.mem.sliceAsBytes(input), stream.handle);
+            for (rules, 0..) |rule, ri| {
+                const first: u64 = 32769 + ri * 127; // preserve absolute-position keyed RNG, beyond32K
+                try baseline.draw(stream, exchange, &spans, &mine, rows, first, rule, &want_tokens);
+                try batched.draw(stream, exchange, &spans, &mine, rows, first, rule, &got_tokens);
+                try group.check();
+                try check.sameBytes("sampled IDs", std.mem.sliceAsBytes(got_tokens[0..rows]), std.mem.sliceAsBytes(want_tokens[0..rows]));
+                try baseline.prob.download(0, std.mem.sliceAsBytes(want_prob[0..rows]));
+                try batched.prob.download(0, std.mem.sliceAsBytes(got_prob[0..rows]));
+                try check.sameBytes("sampled probability bits", std.mem.sliceAsBytes(got_prob[0..rows]), std.mem.sliceAsBytes(want_prob[0..rows]));
+                if (ri == 0) {
+                    try baseline.rowsRead(rows, got);
+                    try check.sameBytes("baseline full logits", std.mem.sliceAsBytes(got[0 .. rows * V]), std.mem.sliceAsBytes(expected[0 .. rows * V]));
+                    try batched.rowsRead(rows, got);
+                    try check.sameBytes("packed full logits", std.mem.sliceAsBytes(got[0 .. rows * V]), std.mem.sliceAsBytes(expected[0 .. rows * V]));
+                }
+                cases += 1;
+            }
+            // Existing grammar path still uses gather+mask+drawFull. Exact full rows are also safe to mask.
+            try baseline.mask(stream, rows, bits.ptr, words);
+            try batched.mask(stream, rows, bits.ptr, words);
+            try baseline.drawFull(stream, rows, 17, rules[0], &want_tokens);
+            try batched.drawFull(stream, rows, 17, rules[0], &got_tokens);
+            try check.sameBytes("grammar masked sampled IDs", std.mem.sliceAsBytes(got_tokens[0..rows]), std.mem.sliceAsBytes(want_tokens[0..rows]));
+
+            // No Group attached: the same packed transport must work with plain NCCL too.
+            if (fixture == 0) {
+                try baseline.draw(stream, nccl_only, &spans, &mine, rows, 5, rules[0], &want_tokens);
+                try batched.draw(stream, nccl_only, &spans, &mine, rows, 5, rules[0], &got_tokens);
+                try check.sameBytes("raw NCCL sampled IDs", std.mem.sliceAsBytes(got_tokens[0..rows]), std.mem.sliceAsBytes(want_tokens[0..rows]));
+            }
+            try local.download(0, std.mem.sliceAsBytes(source_after));
+            try check.sameBytes("input and guard bytes unchanged", std.mem.sliceAsBytes(source_after), std.mem.sliceAsBytes(input));
+        }
+    }
+
+    // Public gather remains baseline even with the option ON: grammar and prompt logprobs can use
+    // their own output buffers, including rows beyond the scratch capacity. Do not silently truncate.
+    fill(input, expected, max_rows, rank, 0);
+    try local.uploadAsync(0, std.mem.sliceAsBytes(input), stream.handle);
+    try batched.gather(stream, exchange, &spans, &mine, max_rows, bigger.ptr);
+    try stream.synchronize();
+    try group.check();
+    try bigger.download(0, std.mem.sliceAsBytes(got));
+    try check.sameBytes("over-capacity public gather unchanged", std.mem.sliceAsBytes(got), std.mem.sliceAsBytes(expected));
+    check.pass("glm-sample-gather rank{d}: {d} exact sampled draws; V154880 rows1..8,32; NCCL{s}; grammar, source guards and >capacity gather", .{ rank, cases, if (use_roce) "+RoCE4MiB fallback" else "" });
+}
+
+fn fill(input: []u16, expected: []u16, rows: usize, rank: usize, fixture: usize) void {
+    @memset(input, 0x5a5a);
+    @memset(expected, 0);
+    for (0..rows) |row| for (0..V) |col| {
+        const value: f32 = switch (fixture) {
+            0 => @as(f32, @floatFromInt(@as(i32, @intCast((col * 97 + row * 103) % 4093)) - 2046)) / 256.0,
+            1 => if ((col + row) % 97 == 0) 2.0 else 0.0, // equal maxima on both ranks
+            2 => if (col == (row * 7919 + H - 1) % V) 1000.0 else -1000.0,
+            else => if ((col + row) % 2 == 0) 0.0 else -0.0,
+        };
+        const raw: u32 = @bitCast(value);
+        const bf: u16 = @truncate((raw +% 0x7fff +% ((raw >> 16) & 1)) >> 16);
+        expected[row * V + col] = bf;
+        if (col >= rank * H and col < (rank + 1) * H) input[guard + row * H + col - rank * H] = bf;
+    };
+}
