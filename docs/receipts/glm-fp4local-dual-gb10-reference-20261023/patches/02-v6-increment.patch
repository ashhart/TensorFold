diff --git a/zig/tests/cuda/contract_glm_moe_tail.zig b/zig/tests/cuda/contract_glm_moe_tail.zig
new file mode 100644
--- /dev/null
+++ b/zig/tests/cuda/contract_glm_moe_tail.zig
@@ -0,0 +1,204 @@
+//! Decode-only FP32 shared-slot copy/combine fusion: fixed slot FMA order, no precision or prompt-path change.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const check_ = @import("check.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+
+fn depth(s: c.Shape) usize {
+    return s.k;
+}
+
+const shapes: [32]c.Shape = blk: {
+    var s: [32]c.Shape = undefined;
+    for (&s, 0..) |*v, i| v.* = .{ .rows = i + 1, .n = 4096, .k = 9 };
+    break :blk s;
+};
+
+pub fn spec() c.Spec {
+    return .{ .name = "cuda glm tf_glm_combine_shared (decode FP32 shared tail)", .accum = .f32,
+        .depth = depth, .out = .f32, .replaces = "tf_glm_put_slot(fp32) + tf_glm_combine(fp32)",
+        .tiles = .{ .{}, .{ .size = 1024, .step = 8, .min = 8 }, .{} }, .served = &shapes };
+}
+
+pub const Tail = struct {
+    rig: rig_.Rig,
+    candidate: cuda.Function,
+    baseline: cuda.Function,
+    put_slot: cuda.Function,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = undefined,
+    y: []f32 = &.{},
+    shared: []f32 = &.{},
+    wts: []f32 = &.{},
+    ptrs: [6]u64 = @splat(0), // y, shared, wts, output, baseline slots, baseline output
+    stress: bool = false,
+
+    pub fn init(rig: rig_.Rig, mod: cuda.Module, ops: cuda.Module) !Tail {
+        return .{ .rig = rig, .arena = .init(rig.gpu.gpa),
+            .candidate = try mod.function("tf_glm_combine_shared"),
+            .baseline = try mod.function("tf_glm_combine"), .put_slot = try ops.function("tf_glm_put_slot") };
+    }
+
+    pub fn deinit(self: *Tail) void {
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Tail) g.Kernel {
+        return .{ .spec = spec(), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Tail);
+
+    pub fn count(self: *Tail) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    pub fn prepare(self: *Tail, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 32 or shape.n == 0 or shape.n % 8 != 0 or shape.k != 9)
+            return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        self.shape = shape;
+        self.stress = fill == .stress;
+        self.y = try a.alloc(f32, shape.rows * shape.k * shape.n);
+        self.shared = try a.alloc(f32, self.count());
+        self.wts = try a.alloc(f32, shape.rows * shape.k);
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        for (self.y) |*v| v.* = rng.float(f32) * 4 - 2;
+        for (self.shared) |*v| v.* = rng.float(f32) * 4 - 2;
+        for (self.wts) |*v| v.* = rng.float(f32) * 2 - 1; // shared need not weigh exactly 1 in this contract
+        if (fill == .stress) {
+            @memset(self.wts, 1);
+            // Four large positives, their negatives with an integer delta, then a small shared value.
+            // Every FP32 sum is exact; FP16 overflows and BF16 misses even in pairwise/strided orders.
+            for (0..shape.rows) |r| for (0..shape.n) |col| {
+                for (0..4) |slot| {
+                    const v: f32 = @floatFromInt(262144 + rng.uintLessThan(u32, 512));
+                    self.y[(r * 9 + slot) * shape.n + col] = v;
+                    self.y[(r * 9 + slot + 4) * shape.n + col] = -v + 17;
+                }
+                self.shared[r * shape.n + col] = 3;
+            };
+        }
+        if (fill == .nonfinite) {
+            self.y[0] = std.math.nan(f32);
+            self.y[1] = std.math.inf(f32);
+            self.y[2] = -std.math.inf(f32);
+            self.shared[3] = std.math.nan(f32);
+            self.shared[4] = std.math.inf(f32);
+            self.shared[5] = -std.math.inf(f32);
+            self.y[6] = std.math.inf(f32);
+            self.shared[6] = -std.math.inf(f32);
+            // Same-sign positive weights make the opposite infinities in column 6 cancel to NaN.
+            self.wts[0] = 1;
+            self.wts[8] = 1;
+            if (shape.rows > 1) self.wts[9 + 8] = std.math.nan(f32);
+        }
+        // A poisoned last slot detects accidental stale reads and is an immutable input to the fused kernel.
+        for (0..shape.rows) |r| @memset(self.y[(r * shape.k + shape.k - 1) * shape.n ..][0..shape.n],
+            std.math.nan(f32));
+        self.ptrs = .{ try self.rig.input(std.mem.sliceAsBytes(self.y)),
+            try self.rig.input(std.mem.sliceAsBytes(self.shared)), try self.rig.input(std.mem.sliceAsBytes(self.wts)),
+            try self.rig.output(self.count() * 4), try self.rig.scratch(self.y.len * 4),
+            try self.rig.scratch(self.count() * 4) };
+        return true;
+    }
+
+    pub fn run(self: *Tail) !void {
+        const p = self.ptrs;
+        var args: cuda.Args = .{};
+        inline for (.{ p[0], p[1], p[2], p[3], @as(i64, @intCast(self.shape.n)),
+            @as(c_int, @intCast(self.shape.k)) }) |v| args.add(v);
+        try self.launch(self.candidate, &args);
+        try self.rig.s.synchronize();
+    }
+
+    fn launch(self: *Tail, f: cuda.Function, args: *cuda.Args) !void {
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(self.shape.rows),
+            .y = @intCast((self.shape.n + 1023) / 1024) }, .block = .{ .x = 128 } }, self.rig.s, args);
+    }
+
+    pub fn replaced(self: *Tail) ![]const u8 {
+        const p = self.ptrs;
+        const s = self.shape;
+        try (cuda.DeviceBuffer{ .d = self.rig.gpu.d, .ptr = p[4], .len = self.y.len * 4 })
+            .copyFrom(0, p[0], self.y.len * 4, self.rig.s.handle);
+        var a: cuda.Args = .{};
+        inline for (.{ p[1], p[4], @as(c_int, @intCast(s.rows)), @as(c_int, @intCast(s.n)),
+            @as(c_int, @intCast(s.k)), @as(c_int, @intCast(s.k - 1)), @as(c_int, 0) }) |v| a.add(v);
+        try cuda.launch.launch(self.put_slot, .{ .grid = .{ .x = @intCast((self.count() + 255) / 256) },
+            .block = .{ .x = 256 } }, self.rig.s, &a);
+        var b: cuda.Args = .{};
+        inline for (.{ p[4], @as(c_int, 1), p[2], p[5], @as(i64, @intCast(s.n)),
+            @as(c_int, @intCast(s.k)) }) |v| b.add(v);
+        try self.launch(self.baseline, &b);
+        return self.rig.bytes(p[5], self.count() * 4);
+    }
+
+    fn terms(self: *Tail, out: usize, t: *[9]f64) void {
+        const r = out / self.shape.n;
+        const col = out % self.shape.n;
+        for (t, 0..) |*v, slot| {
+            const y: f64 = if (slot == 8) self.shared[out] else self.y[(r * 9 + slot) * self.shape.n + col];
+            v.* = y * @as(f64, self.wts[r * 9 + slot]);
+        }
+    }
+
+    pub fn reference(self: *Tail, want: []f64, mag: []f64) !void {
+        var t: [9]f64 = undefined;
+        for (want, mag, 0..) |*w, *m, i| {
+            self.terms(i, &t);
+            w.* = 0;
+            m.* = 0;
+            for (t) |v| {
+                w.* += v;
+                m.* += @abs(v);
+            }
+        }
+    }
+
+    pub fn simulate(self: *Tail, acc: c.Accum, order: g.Order, out: []f64) !void {
+        var t: [9]f64 = undefined;
+        for (out, 0..) |*v, i| {
+            self.terms(i, &t);
+            v.* = core.contract.rows.sumIn(acc, order, &t);
+        }
+    }
+
+    pub fn bounds(self: *Tail, _: []const f64, _: []const f64, allow: []f64) !void {
+        if (!self.stress) return error.NotStressInputs;
+        @memset(allow, 0);
+    }
+};
+
+/// Focused local run. Frozen-fatbin cross-build equality, signed zero and subranges live in test_moe_tail.py.
+pub fn run(gpu: check_.Gpu) !void {
+    if (try gpu.ctx.capability() != 121) return error.GlmMoeTailRequiresSm121;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer mod.unload();
+    var ops = try cuda.Module.load(gpu.d, cuda.kernels.glm_ops);
+    defer ops.unload();
+    var tail = try Tail.init(.{ .gpu = gpu, .s = s }, mod, ops);
+    defer tail.deinit();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, &.{tail.kernel()}, 0x6b63, &tally);
+    const f = tail.candidate;
+    const regs = try f.attribute(.num_regs);
+    const smem = try f.attribute(.shared_size_bytes);
+    const bound = try f.attribute(.max_threads_per_block);
+    const local = try f.attribute(.local_size_bytes);
+    std.debug.print("moe tail resource receipt: regs={d} static={d} max_threads={d} local={d}\n",
+        .{ regs, smem, bound, local });
+    try check_.expect(bound >= 128 and smem == 0 and local == 0, "moe tail unexpected resources", .{});
+    std.debug.print("MOE TAIL focused: {d} pass, {d} fail; standalone run does not exercise planted controls\n",
+        .{ tally.passed, tally.failed });
+    try check_.expect(tally.problems() == 0, "moe tail gates failed", .{});
+}
