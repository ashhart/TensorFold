@@ -0,0 +1,224 @@
+//! KDA direct-output projections: unchanged dot products, strided stores and explicit padding guards.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const core = @import("core");
+const Rig = @import("contract_rig.zig").Rig;
+const check_ = @import("check.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Dense = core.contract.dense.Dense;
+
+pub const Kind = enum { mxfp8, bf16 };
+
+/// Local gate run; frozen-v5 equality, zeros and full rows 1-8 coverage also live in bench_kda_direct.py.
+pub fn run(gpu: check_.Gpu) !void {
+    const cap = try gpu.ctx.capability();
+    if (cap != 121) return error.KdaDirectRequiresSm121;
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var lane = try cuda.qmmf.Lane.load(gpu.d, cap / 10);
+    defer lane.unload();
+    var mm_mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_mm);
+    defer mm_mod.unload();
+    const mm = try glm.mm.Kernels.load(mm_mod);
+    var ops = try cuda.Module.load(gpu.d, cuda.kernels.glm_ops);
+    defer ops.unload();
+    const copy_rows = try ops.function("tf_glm_copy_rows");
+    var mx: Product = .{ .rig = .{ .gpu = gpu, .s = stream }, .kind = .mxfp8,
+        .lane = &lane, .mm = &mm, .copy_rows = copy_rows };
+    defer mx.deinit();
+    var bf: Product = .{ .rig = .{ .gpu = gpu, .s = stream }, .kind = .bf16,
+        .lane = &lane, .mm = &mm, .copy_rows = copy_rows };
+    defer bf.deinit();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, &.{ mx.kernel(), bf.kernel() }, 0x6b6461, &tally);
+    try receipt("qmmf_mxfp8_stride16", lane.mxfp8_strided[0], 128, cuda.qmmf.sharedBytes(.mxfp8, 16));
+    try receipt("qmmf_mxfp8_stride32", lane.mxfp8_strided[1], 128, cuda.qmmf.sharedBytes(.mxfp8, 32));
+    try receipt("glm_mm_reduce_stride", mm.reduce_strided, 256, 0);
+    std.debug.print("KDA DIRECT focused: {d} pass, {d} fail; standalone run does not exercise planted controls\n",
+        .{ tally.passed, tally.failed });
+    try check_.expect(tally.problems() == 0, "KDA direct gates failed", .{});
+}
+
+fn receipt(name: []const u8, f: cuda.Function, threads: u32, dynamic: u32) !void {
+    const regs = try f.attribute(.num_regs);
+    const shared = try f.attribute(.shared_size_bytes);
+    const bound = try f.attribute(.max_threads_per_block);
+    const local = try f.attribute(.local_size_bytes);
+    const active = try f.occupancy(threads, dynamic);
+    std.debug.print("KDA resource receipt {s}: regs={d} static={d} dynamic={d} max_threads={d} local={d} blocks/SM={d}\n",
+        .{ name, regs, shared, dynamic, bound, local, active });
+    try check_.expect(bound >= @as(c_int, @intCast(threads)) and active > 0,
+        "KDA direct invalid launch resources: {s}", .{name});
+}
+
+fn depth(s: c.Shape) usize {
+    return s.k / 16 + 32;
+}
+
+pub fn spec(kind: Kind) c.Spec {
+    return .{
+        .name = if (kind == .mxfp8) "cuda KDA direct MXFP8 output" else "cuda KDA direct BF16 split-K output",
+        .accum = .f32,
+        .depth = depth,
+        .out = .bf16,
+        .replaces = if (kind == .mxfp8) "qmmf MXFP8 contiguous output" else "glm_mm contiguous slice reduction",
+        .nan = .{ .stated = "bitwise equal to the contiguous projection for NaN and infinite BF16 inputs" },
+        .tiles = .{ .{ .size = 16 }, .{ .size = 64, .step = 8, .min = 8 }, .{ .size = 64, .step = 64, .min = 64 } },
+        .served = if (kind == .mxfp8) &.{ .{ .rows = 1, .n = 12288, .k = 4096 },
+            .{ .rows = 8, .n = 12288, .k = 4096 }, .{ .rows = 17, .n = 12288, .k = 4096 },
+            .{ .rows = 32, .n = 12296, .k = 4096 } } else &.{ .{ .rows = 1, .n = 288, .k = 4096 },
+            .{ .rows = 8, .n = 288, .k = 4096 }, .{ .rows = 17, .n = 288, .k = 4096 },
+            .{ .rows = 32, .n = 296, .k = 4096 } },
+    };
+}
+
+pub const Product = struct {
+    rig: Rig,
+    kind: Kind,
+    lane: *const cuda.qmmf.Lane,
+    mm: *const glm.mm.Kernels,
+    copy_rows: cuda.Function,
+    d: ?Dense = null,
+    weight: cuda.qmmf.Weight = undefined,
+    tiled: glm.mm.Tiled = undefined,
+    x: u64 = 0,
+    part: u64 = 0,
+    out: u64 = 0,
+    base: u64 = 0,
+    strided: u64 = 0,
+    ldy: usize = 0,
+
+    pub fn deinit(self: *Product) void {
+        if (self.d) |d| d.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Product) g.Kernel {
+        return .{ .spec = spec(self.kind), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Product);
+
+    pub fn prepare(self: *Product, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 32 or shape.n == 0 or shape.n % 8 != 0 or
+            shape.k == 0 or shape.k % 64 != 0) return false;
+        if (self.kind == .mxfp8 and cuda.qmmf.splitK(shape.n, shape.k) != 1) return false;
+        if (self.kind == .bf16 and glm.mm.splitK(shape.n, shape.k) == 1) return false;
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.rig.reset();
+        const a = self.rig.gpu.gpa;
+        const d = try Dense.init(a, shape, 1);
+        self.d = d;
+        d.fillX(fill, seed, 16);
+        try self.prepareWeight(shape, fill, seed);
+        self.x = try self.rig.input(std.mem.sliceAsBytes(d.x));
+        self.part = try self.rig.scratch(@max(16, 8 * shape.rows * shape.n * 4));
+        self.out = try self.rig.output(shape.rows * shape.n * 2);
+        self.base = try self.rig.scratch(shape.rows * shape.n * 2);
+        self.ldy = shape.n + if (self.kind == .mxfp8) @as(usize, 288) else 12288;
+        self.strided = try self.rig.scratch((shape.rows * self.ldy + 16) * 2);
+        return true;
+    }
+
+    fn prepareWeight(self: *Product, shape: c.Shape, fill: g.Fill, seed: u64) !void {
+        var arena = std.heap.ArenaAllocator.init(self.rig.gpu.gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const n = shape.n;
+        const k = shape.k;
+        const d = self.d.?;
+        var prng = std.Random.DefaultPrng.init(seed ^ 0x6b6461);
+        const rng = prng.random();
+        if (self.kind == .bf16) {
+            const words = try a.alloc(u16, n * k);
+            for (words) |*v| v.* = c.toBf16(if (fill == .stress)
+                @floatFromInt(1 + rng.uintLessThan(u8, 7)) else rng.float(f32) * 4 - 2);
+            if (fill == .stress) for (0..n) |j| for (k / 2..k) |i| {
+                words[j * k + i] = words[j * k + i - k / 2] | 0x8000;
+            };
+            for (d.w, words) |*v, w| v.* = c.fromBf16(w);
+            const src = try self.rig.input(std.mem.sliceAsBytes(words));
+            const zeros = try a.alloc(u8, n * k * 2);
+            @memset(zeros, 0);
+            const tiled_ptr = try self.rig.input(zeros);
+            try glm.mm.tile(self.mm, self.rig.s, src, tiled_ptr, n, k);
+            try self.rig.s.synchronize();
+            self.tiled = .{ .w = tiled_ptr, .n = n, .k = k };
+            return;
+        }
+        const codes = try a.alloc(u8, n * k);
+        const scales = try a.alloc(u8, n * k / 32);
+        for (scales) |*v| v.* = if (fill == .stress) 127 else 123 + rng.uintLessThan(u8, 8);
+        for (codes) |*v| {
+            v.* = if (fill == .stress) 0x38 + rng.uintLessThan(u8, 24) else rng.uintLessThan(u8, 0x7f);
+            if (fill != .stress and rng.boolean()) v.* |= 0x80;
+        }
+        if (fill == .stress) for (0..n) |j| for (k / 2..k) |i| {
+            codes[j * k + i] = codes[j * k + i - k / 2] | 0x80;
+        };
+        for (0..n) |j| for (0..k) |i| {
+            const scale = std.math.ldexp(@as(f64, 1), @as(i32, scales[j * (k / 32) + i / 32]) - 127);
+            d.w[j * k + i] = core.quant.fp8.e4m3(codes[j * k + i]) * scale;
+        };
+        const npad = cuda.mxfp8.padded(n);
+        const tiled_codes = try a.alloc(u8, npad * k);
+        const packed_scales = try a.alloc(u8, npad * k / 32);
+        cuda.mxfp8.packCodes(tiled_codes, codes, n, k);
+        cuda.mxfp8.packScales(packed_scales, scales, n, k);
+        self.weight = cuda.mxfp8.weight(try self.rig.input(tiled_codes), try self.rig.input(packed_scales), n, k);
+    }
+
+    pub fn count(self: *Product) usize {
+        return self.d.?.outputs();
+    }
+
+    /// Store at an offset inside guarded wider rows, then copy only the logical result for the generic harness.
+    pub fn run(self: *Product) !void {
+        const sh = self.d.?.shape;
+        const bytes = (sh.rows * self.ldy + 16) * 2;
+        try (cuda.DeviceBuffer{ .d = self.rig.gpu.d, .ptr = self.strided, .len = bytes }).fill8(0xa5, self.rig.s.handle);
+        const dest = self.strided + 16;
+        if (self.kind == .mxfp8) {
+            try self.lane.matmulMxfp8Strided(self.rig.s, self.x, sh.k, sh.rows, self.weight, dest, self.ldy);
+        } else try glm.mm.matmulStrided(self.mm, self.rig.s, self.x, sh.k, self.tiled, dest, self.ldy, self.part, sh.rows);
+        var args: cuda.Args = .{};
+        inline for (.{ dest, @as(i64, @intCast(self.ldy * 2)), self.out, @as(i64, @intCast(sh.n * 2)),
+            @as(i32, @intCast(sh.rows)), @as(i32, @intCast(sh.n * 2)) }) |v| args.add(v);
+        try cuda.launch.launch(self.copy_rows, .{ .grid = .{ .x = @intCast((sh.rows * sh.n * 2 + 255) / 256) },
+            .block = .{ .x = 256 } }, self.rig.s, &args);
+        const got = try self.rig.bytes(self.strided, bytes);
+        for (got, 0..) |v, i| {
+            const rel = i -| 16;
+            const payload = i >= 16 and rel / (self.ldy * 2) < sh.rows and rel % (self.ldy * 2) < sh.n * 2;
+            if (!payload) try check_.expect(v == 0xa5, "KDA direct output changed row padding at byte {d}", .{i});
+        }
+    }
+
+    pub fn replaced(self: *Product) ![]const u8 {
+        const sh = self.d.?.shape;
+        if (self.kind == .mxfp8) {
+            try self.lane.matmul(self.rig.s, self.x, sh.k, sh.rows, self.weight, self.base, 0);
+        } else try glm.mm.matmul(self.mm, self.rig.s, self.x, sh.k, self.tiled, self.base, self.part, sh.rows, false, false);
+        return self.rig.bytes(self.base, self.count() * 2);
+    }
+
+    pub fn check(self: *Product, gate: g.Gate) !?[]const u8 {
+        const got = try self.rig.outputBytes();
+        const want = try self.replaced();
+        if (!std.mem.eql(u8, got, want)) return "KDA strided output differs from contiguous baseline";
+        if (gate != .nonfinite) return null;
+        for (0..self.count()) |i| if (c.classOf(c.read(.bf16, got, i)) != .finite) return null;
+        return "non-finite fixture produced no non-finite output";
+    }
+
+    pub fn reference(self: *Product, want: []f64, mag: []f64) !void {
+        return self.d.?.reference(want, mag);
+    }
+
+    pub fn simulate(self: *Product, accumulator: c.Accum, order: g.Order, out: []f64) !void {
+        return self.d.?.simulate(accumulator, order, out);
+    }
+};
