diff --git a/zig/src/families/glm/cuda_decode_detail.zig b/zig/src/families/glm/cuda_decode_detail.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/families/glm/cuda_decode_detail.zig
@@ -0,0 +1,112 @@
+//! Optional nested decode intervals. Labels overlap; they are not a partition.
+const std = @import("std");
+const cuda = @import("cuda");
+pub const Stage = enum { kda_project, kda_copy, kda_chain, kda_output, moe_slot, moe_combine, sample_gather, sample_draw };
+const count = std.enums.values(Stage).len;
+const capacity = 512;
+
+pub const Trace = struct {
+    events: [capacity * 2]cuda.Event,
+    stages: [capacity]Stage = undefined,
+    closed: [capacity]bool = @splat(false),
+    n: usize = 0,
+    overflow: bool = false,
+    active: bool = false,
+    invalid: bool = false,
+    epoch: u64 = 0,
+    totals: [count]f64 = @splat(0),
+    calls: usize = 0,
+
+    pub fn init(d: *const cuda.Driver) !*Trace {
+        const t = try std.heap.page_allocator.create(Trace);
+        errdefer std.heap.page_allocator.destroy(t);
+        t.* = .{ .events = undefined };
+        var made: usize = 0;
+        errdefer for (t.events[0..made]) |*e| e.deinit();
+        for (&t.events) |*e| {
+            e.* = try cuda.Event.init(d, true);
+            made += 1;
+        }
+        return t;
+    }
+    pub fn deinit(t: *Trace) void {
+        for (&t.events) |*e| e.deinit();
+        std.heap.page_allocator.destroy(t);
+    }
+    pub fn begin(t: *Trace) void {
+        t.epoch +%= 1;
+        t.n = 0;
+        t.active = true;
+        t.invalid = false;
+        t.overflow = false;
+        t.closed = @splat(false);
+    }
+    pub fn span(t: *Trace, s: cuda.Stream, stage: Stage) Scope {
+        if (!t.active or t.invalid) return .{};
+        if (t.n == capacity) {
+            t.overflow = true;
+            t.invalid = true;
+            return .{};
+        }
+        const i = t.n;
+        t.events[i * 2].record(s) catch {
+            t.invalid = true;
+            return .{};
+        };
+        t.stages[i] = stage;
+        t.n += 1;
+        return .{ .trace = t, .index = i, .stream = s, .epoch = t.epoch };
+    }
+
+    /// Discard a failed call, preserving only earlier complete calls' aggregate. Late scopes cannot reopen it.
+    pub fn abort(t: *Trace) void {
+        t.active = false;
+        t.invalid = true;
+    }
+    /// Caller has already synchronized its final coarse event on this stream.
+    pub fn finish(t: *Trace, label: []const u8, every: u64) void {
+        if (!t.active) return;
+        t.active = false;
+        if (t.n == 0) return;
+        if (t.invalid or t.overflow) return;
+        var call: [count]f64 = @splat(0);
+        for (0..t.n) |i| {
+            if (!t.closed[i]) return;
+            const ms = cuda.Event.elapsedMs(t.events[i * 2], t.events[i * 2 + 1]) catch return;
+            if (!std.math.isFinite(ms) or ms < 0) return;
+            call[@intFromEnum(t.stages[i])] += ms;
+        }
+        for (&t.totals, call) |*total, ms| total.* += ms;
+        t.calls += 1;
+        if (t.calls < every) return;
+        var buf: [640]u8 = undefined;
+        var w: std.Io.Writer = .fixed(&buf);
+        w.print("glm detail {s} ({d} calls, nested ms/call):", .{ label, t.calls }) catch {};
+        inline for (std.enums.values(Stage)) |stage| {
+            const ms = t.totals[@intFromEnum(stage)];
+            if (ms > 0) w.print(" {s} {d:.3}", .{ @tagName(stage), ms / @as(f64, @floatFromInt(t.calls)) }) catch {};
+        }
+        std.log.info("{s}", .{w.buffered()});
+        t.totals = @splat(0);
+        t.calls = 0;
+    }
+};
+pub const Scope = struct {
+    trace: ?*Trace = null,
+    index: usize = 0,
+    stream: cuda.Stream = undefined,
+    epoch: u64 = 0,
+    pub fn end(v: Scope) void {
+        const t = v.trace orelse return;
+        if (!t.active or t.epoch != v.epoch or t.closed[v.index]) return;
+        t.events[v.index * 2 + 1].record(v.stream) catch {
+            t.invalid = true;
+            return;
+        };
+        t.closed[v.index] = true;
+    }
+};
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_GLM_DETAIL_PROF") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
diff --git a/zig/src/families/glm/cuda_decode_detail_test.zig b/zig/src/families/glm/cuda_decode_detail_test.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/families/glm/cuda_decode_detail_test.zig
@@ -0,0 +1,217 @@
+//! Host-only virtual event clocks: complete-call accounting, failure unwind and stale-scope protection.
+const std = @import("std");
+const cuda = @import("cuda");
+const detail = @import("cuda_decode_detail.zig");
+const prof = @import("cuda_prof.zig");
+const t = std.testing;
+
+const Fake = struct {
+    var made: usize = 0;
+    var live: usize = 0;
+    var fail_create: usize = std.math.maxInt(usize);
+    var records: usize = 0;
+    var fail_record: usize = std.math.maxInt(usize);
+    var syncs: usize = 0;
+    var elapsed_calls: usize = 0;
+    var times: [4096]f32 = undefined;
+    var clock: f32 = 0;
+    var bad: enum { none, not_ready, nan, negative } = .none;
+
+    fn reset() void {
+        made = 0;
+        live = 0;
+        fail_create = std.math.maxInt(usize);
+        records = 0;
+        fail_record = std.math.maxInt(usize);
+        syncs = 0;
+        elapsed_calls = 0;
+        clock = 0;
+        bad = .none;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuEventCreate = create;
+        d.api.cuEventDestroy_v2 = destroy;
+        d.api.cuEventRecord = record;
+        d.api.cuEventElapsedTime = elapsed;
+        d.api.cuEventSynchronize = sync;
+        return d;
+    }
+    fn create(out: *cuda.abi.Event, _: c_uint) callconv(.c) c_int {
+        // NOT_READY avoids test-runner error logs while exercising the same failed-create unwind.
+        if (made == fail_create) return cuda.abi.error_not_ready;
+        made += 1;
+        live += 1;
+        out.* = @ptrFromInt(made);
+        return 0;
+    }
+    fn destroy(_: cuda.abi.Event) callconv(.c) c_int {
+        live -= 1;
+        return 0;
+    }
+    fn record(e: cuda.abi.Event, _: cuda.abi.Stream) callconv(.c) c_int {
+        const at = records;
+        records += 1;
+        if (at == fail_record) return cuda.abi.error_not_ready;
+        times[@intFromPtr(e)] = clock;
+        return 0;
+    }
+    fn elapsed(out: *f32, a: cuda.abi.Event, b: cuda.abi.Event) callconv(.c) c_int {
+        elapsed_calls += 1;
+        if (bad == .not_ready) return cuda.abi.error_not_ready;
+        out.* = switch (bad) {
+            .nan => std.math.nan(f32),
+            .negative => -1,
+            else => times[@intFromPtr(b)] - times[@intFromPtr(a)],
+        };
+        return 0;
+    }
+    fn sync(_: cuda.abi.Event) callconv(.c) c_int {
+        syncs += 1;
+        return 0;
+    }
+};
+
+fn stream(d: *const cuda.Driver) cuda.Stream {
+    return .{ .d = d, .handle = @ptrFromInt(1) };
+}
+
+test "GLM decode detail: nested durations aggregate once; event reuse does not allocate or synchronize" {
+    Fake.reset();
+    var d = Fake.driver();
+    const tr = try detail.Trace.init(&d);
+    defer tr.deinit();
+    try t.expectEqual(@as(usize, 1024), Fake.live);
+    tr.begin();
+    Fake.clock = 10;
+    const outer = tr.span(stream(&d), .kda_project);
