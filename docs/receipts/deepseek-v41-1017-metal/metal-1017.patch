+++ b/zig/src/families/deepseek_v41_metal/prepared.zig
@@ -0,0 +1,135 @@
+//! Share the original affine activation preparation within a short routed window.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const row = @import("../../core/row_projection.zig");
+const c = @import("config.zig");
+const Buffer = mtl.Buffer;
+
+pub const max_slots = (1 + c.draft_block) * c.topk;
+pub const sum_bytes = max_slots * c.hidden / 16 * 4;
+pub const term_bytes = max_slots * c.hidden * 4;
+
+pub const Kernels = struct {
+    packed_inputs: bool,
+    up: bool,
+    down: bool,
+    sums: mtl.Pipeline,
+    pack2: ?mtl.Pipeline = null,
+    q2: mtl.Pipeline,
+    q3: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !?Kernels {
+        if (std.c.getenv("DS_SKIP") != null) return null;
+        const option = std.mem.span(std.c.getenv("TF_BENCH_DS_PREPARED") orelse return null);
+        const packed_inputs = std.mem.eql(u8, option, "packed");
+        if (!packed_inputs and !std.mem.eql(u8, option, "sums")) return error.InvalidPreparedExpertMode;
+        const phase: []const u8 = if (std.c.getenv("TF_BENCH_DS_PREPARED_PHASE")) |v| std.mem.span(v) else "both";
+        const both = std.mem.eql(u8, phase, "both");
+        const up = both or std.mem.eql(u8, phase, "up");
+        const down = both or std.mem.eql(u8, phase, "down");
+        if (!up and !down) return error.InvalidPreparedExpertPhase;
+        const source = sources.core_row_projection ++ "\n" ++ @embedFile("prepared.metal");
+        const lib = try mtl.Library.fromSource(device, source, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const sums = try mtl.Pipeline.init(device, lib, "tf_prep_sums", false);
+        errdefer sums.deinit();
+        const pack2 = if (packed_inputs) try mtl.Pipeline.init(device, lib, "tf_prep_pack2", false) else null;
+        errdefer if (pack2) |p| p.deinit();
+        const q2 = try mtl.Pipeline.init(device, lib, if (packed_inputs) "tf_packed_q2" else "tf_prep_q2", false);
+        errdefer q2.deinit();
+        const q3 = try mtl.Pipeline.init(device, lib, "tf_prep_q3", false);
+        return .{ .packed_inputs = packed_inputs, .up = up, .down = down, .sums = sums, .pack2 = pack2, .q2 = q2, .q3 = q3 };
+    }
+
+    pub fn deinit(p: Kernels) void {
+        p.sums.deinit();
+        if (p.pack2) |tf| tf.deinit();
+        p.q2.deinit();
+        p.q3.deinit();
+    }
+
+    pub fn prepare(p: Kernels, enc: mtl.ComputeEncoder, wt: row.Weights, input: Buffer, sums: Buffer, terms: Buffer, rows: usize) void {
+        std.debug.assert(rows <= max_slots and wt.k <= c.hidden);
+        enc.setPipeline(if (wt.bits == 2) p.pack2 orelse p.sums else p.sums);
+        enc.setBuffer(input, 0, 0);
+        enc.setBuffer(sums, 0, 1);
+        enc.setBuffer(terms, 0, 2);
+        const k: u32 = @intCast(wt.k);
+        enc.setBytes(std.mem.asBytes(&k), 3);
+        enc.dispatchThreads(mtl.Size.of(wt.k / 16, rows, 1), mtl.Size.of(32, 1, 1));
+    }
+
+    pub fn choice(p: Kernels, kernels: *const row.Pipelines, wt: row.Experts, slots: usize) ?row.Call {
+        if (wt.one.sum != .f32 or wt.one.bits < 2 or wt.one.bits > 3) return null;
+        const k = wt.one.k;
+        if (k != c.hidden and k != c.moe_inter) return null;
+        var call = row.callIndexed(kernels, wt, slots, false) catch return null;
+        call.pipeline = if (wt.one.bits == 2) p.q2 else p.q3;
+        return call;
+    }
+};
+
+fn bind(enc: mtl.ComputeEncoder, call: row.Call, wt: row.Weights, input: Buffer, ids: Buffer, out: Buffer) void {
+    enc.setPipeline(call.pipeline);
+    enc.setBuffer(input, 0, 0);
+    enc.setBuffer(wt.w, wt.w_off, 1);
+    enc.setBuffer(wt.scales, wt.s_off, 2);
+    enc.setBuffer(wt.biases, wt.b_off, 3);
+    enc.setBytes(std.mem.asBytes(&call.dims), 4);
+    enc.setBuffer(out, 0, 5);
+    enc.setBuffer(ids, 0, 6);
+}
+
+pub fn project(enc: mtl.ComputeEncoder, call: row.Call, wt: row.Weights, input: Buffer, ids: Buffer, out: Buffer, sums: Buffer, terms: Buffer) void {
+    bind(enc, call, wt, input, ids, out);
+    enc.setBuffer(sums, 0, 7);
+    enc.setBuffer(terms, 0, 8);
+    enc.dispatchGroups(mtl.Size.of(call.groups, call.slots, 1), mtl.Size.of(call.threads, 1, 1));
+}
+
+pub fn check(p: Kernels, kernels: *const row.Pipelines, device: mtl.Device, queue: mtl.Queue, wt: row.Experts, rows: usize) !usize {
+    const slots = rows * c.topk;
+    const call = p.choice(kernels, wt, slots) orelse return 0;
+    const original = try row.callIndexed(kernels, wt, slots, false);
+    const values = slots * wt.one.n;
+    const input_rows = slots / wt.repeat;
+    const inputs = input_rows * wt.one.k;
+    const opts = mtl.ResourceOptions.shared;
+    const x = try device.buffer(inputs * 2, opts);
+    defer x.deinit();
+    const ids = try device.buffer(slots * 4, opts);
+    defer ids.deinit();
+    const sums = try device.buffer(sum_bytes, opts);
+    defer sums.deinit();
+    const terms = try device.buffer(term_bytes, opts);
+    defer terms.deinit();
+    const expected = try device.buffer(values * 2, opts);
+    defer expected.deinit();
+    const actual = try device.buffer(values * 2, opts);
+    defer actual.deinit();
+    for (x.slice(u16, inputs), 0..) |*v, index| {
+        const normal: f32 = @floatFromInt(@as(i32, @intCast((index * 173 + 37) % 197)) - 98);
+        const scale: f32 = if (index % 97 < 12) 512 else 64;
+        v.* = @truncate(@as(u32, @bitCast(normal / scale)) >> 16);
+    }
+    for (ids.slice(u32, slots), 0..) |*id, i| id.* = @intCast((13 * i + 5) % wt.experts);
+    ids.slice(u32, slots)[slots - 1] = @intCast(wt.experts);
+    @memset(actual.slice(u16, values), 0xffff);
+    const cb = queue.commandBuffer();
+    const enc = cb.compute(.concurrent);
+    bind(enc, original, wt.one, x, ids, expected);
+    enc.dispatchGroups(mtl.Size.of(original.groups, slots, 1), mtl.Size.of(original.threads, 1, 1));
+    p.prepare(enc, wt.one, x, sums, terms, input_rows);
+    enc.barrier();
+    project(enc, call, wt.one, x, ids, actual, sums, terms);
+    enc.end();
+    cb.commit();
+    cb.wait();
+    if (cb.failure()) |why| {
+        std.log.err("prepared expert check: {s}", .{why});
+        return error.PreparedExpertGpuFailed;
+    }
+    if (!std.mem.eql(u16, expected.slice(u16, values), actual.slice(u16, values))) return error.PreparedExpertDiffers;
+    return values;
+}
