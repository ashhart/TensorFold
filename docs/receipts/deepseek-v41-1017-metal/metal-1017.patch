@@ -0,0 +1,74 @@
+template <bool PACK>
+[[kernel]] void tf_prep_affine(const device bfloat* input [[buffer(0)]],
+                               device float* sums [[buffer(1)]],
+                               device float* terms [[buffer(2)]],
+                               constant uint& k [[buffer(3)]],
+                               uint2 pos [[thread_position_in_grid]]) {
+  float values[16];
+  const device bfloat* x = input + size_t(pos.y) * k + pos.x * 16;
+  sums[size_t(pos.y) * (k / 16) + pos.x] = tf_rp_load16<2, false>(x, values);
+  if (PACK) {
+    const uint stride = (k + 511) / 512 * 512;
+    device float* tile = terms + size_t(pos.y) * stride + (pos.x / 32) * 512 + pos.x % 32;
+    for (int j = 0; j < 16; ++j) tile[j * 32] = values[j];
+  }
+}
+
+template <int BITS, bool PACK>
+[[kernel]] void tf_prep_indexed(const device bfloat* input [[buffer(0)]],
+                                const device uint8_t* weights [[buffer(1)]],
+                                const device bfloat* scales [[buffer(2)]],
+                                const device bfloat* biases [[buffer(3)]],
+                                constant int* dims [[buffer(4)]],
+                                device bfloat* output [[buffer(5)]],
+                                const device uint* ids [[buffer(6)]],
+                                const device float* sums [[buffer(7)]],
+                                const device float* terms [[buffer(8)]],
+                                uint3 block [[threadgroup_position_in_grid]],
+                                uint sg [[simdgroup_index_in_threadgroup]],
+                                uint lane [[thread_index_in_simdgroup]]) {
+  const int k = dims[0], n = dims[1], gs = dims[2], repeat = dims[5];
+  constexpr int cols = 4;
+  const int col = (int(block.x) * 2 + int(sg)) * cols;
+  const uint slot = block.y, expert = ids[slot];
+  device bfloat* y = output + size_t(slot) * n + col;
+  if (expert >= uint(dims[4])) {
+    if (lane < cols) y[lane] = bfloat(0.0f);
+    return;
+  }
+  const uint row = slot / repeat;
+  const int weight_bytes = k * BITS / 8;
+  const int groups = k / gs;
+  const size_t offset = size_t(expert) * n + col;
+  const device uint8_t* w = weights + offset * weight_bytes + lane * (16 * BITS / 8);
+  const device bfloat* s = scales + offset * groups + lane / (gs / 16);
+  const device bfloat* b = biases + offset * groups + lane / (gs / 16);
+  const device bfloat* x = input + size_t(row) * k + lane * 16;
+  const device float* x_sums = sums + size_t(row) * (k / 16) + lane;
+  const device float* x_terms = terms + size_t(row) * ((k + 511) / 512 * 512) + lane;
+  float acc[cols] = {};
+  for (int base = 0; base + int(lane) * 16 < k; base += 512) {
+    float activation[1][16];
+    if (PACK) {
+      for (int j = 0; j < 16; ++j) activation[0][j] = x_terms[base + j * 32];
+    } else {
+      (void)tf_rp_load16<BITS, false>(x + base, activation[0]);
+    }
+    const float sum[1] = {x_sums[base / 16]};
+    for (int j = 0; j < cols; ++j)
+      tf_rp_qdot16<1, BITS>(w + j * weight_bytes, activation, float(s[j * groups]), float(b[j * groups]), sum, &acc[j]);
+    w += 512 * BITS / 8;
+    s += 512 / gs;
+    b += 512 / gs;
+  }
+  for (int j = 0; j < cols; ++j) {
+    const float v = simd_sum(acc[j]);
+    if (lane == 0) y[j] = bfloat(v);
+  }
+}
+
+template [[host_name("tf_prep_sums")]] [[kernel]] decltype(tf_prep_affine<false>) tf_prep_affine<false>;
+template [[host_name("tf_prep_pack2")]] [[kernel]] decltype(tf_prep_affine<true>) tf_prep_affine<true>;
+template [[host_name("tf_prep_q2")]] [[kernel]] decltype(tf_prep_indexed<2, false>) tf_prep_indexed<2, false>;
+template [[host_name("tf_prep_q3")]] [[kernel]] decltype(tf_prep_indexed<3, false>) tf_prep_indexed<3, false>;
+template [[host_name("tf_packed_q2")]] [[kernel]] decltype(tf_prep_indexed<2, true>) tf_prep_indexed<2, true>;
