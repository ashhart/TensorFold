new file mode 100644
index 0000000000000000000000000000000000000000..a3acbc58245e3fe292f352e0cd1daf95c6847b21
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/expert_groups.zig
@@ -0,0 +1,125 @@
+//! Compact the already-selected MoE slots for short verification windows.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const row = @import("../../core/row_projection.zig");
+const c = @import("config.zig");
+const Buffer = mtl.Buffer;
+
+pub const max_slots = (1 + c.draft_block) * c.topk;
+pub const plan_bytes = max_slots * 32;
+pub const dispatch_bytes = 32;
+const column_group = row.columns * row.groups;
+
+pub const Kernels = struct {
+    limit: u32,
+    plan: mtl.Pipeline,
+    q2: mtl.Pipeline,
+    q3: mtl.Pipeline,
+
+    pub fn load(device: mtl.Device) !?Kernels {
+        if (!device.tensorUnits() or std.c.getenv("DS_SKIP") != null) return null;
+        const selected = std.c.getenv("TF_BENCH_DS_EXPERT_GROUP") orelse return null;
+        const limit = try std.fmt.parseInt(u32, std.mem.span(selected), 10);
+        if (limit != 3 and limit != 6) return error.InvalidExpertGroupLimit;
+        const source = sources.core_row_projection ++ "\n" ++ @embedFile("expert_groups.metal");
+        const lib = try mtl.Library.fromSource(device, source, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const plan = try mtl.Pipeline.init(device, lib, "tf_expert_group_plan", false);
+        errdefer plan.deinit();
+        const q2 = try mtl.Pipeline.init(device, lib, if (limit == 3) "tf_expert_group_q2_m3" else "tf_expert_group_q2_m6", false);
+        errdefer q2.deinit();
+        const q3 = try mtl.Pipeline.init(device, lib, if (limit == 3) "tf_expert_group_q3_m3" else "tf_expert_group_q3_m6", false);
+        return .{ .limit = limit, .plan = plan, .q2 = q2, .q3 = q3 };
+    }
+
+    pub fn deinit(p: Kernels) void {
+        p.plan.deinit();
+        p.q2.deinit();
+        p.q3.deinit();
+    }
+
+    pub fn schedule(p: Kernels, enc: mtl.ComputeEncoder, ids: Buffer, plan: Buffer, dispatch: Buffer, slots: usize) void {
+        std.debug.assert(slots > 0 and slots <= max_slots);
+        const args = [4]u32{ @intCast(slots), p.limit, c.moe_inter / column_group, c.hidden / column_group };
+        enc.setPipeline(p.plan);
+        enc.setBuffer(ids, 0, 0);
+        enc.setBuffer(plan, 0, 1);
+        enc.setBuffer(dispatch, 0, 2);
+        enc.setBytes(std.mem.asBytes(&args), 3);
+        enc.dispatchGroups(mtl.Size.of(1, 1, 1), mtl.Size.of(64, 1, 1));
+    }
+
+    pub fn choice(p: Kernels, base: *const row.Pipelines, wt: row.Experts, slots: usize) ?row.Call {
+        if (wt.one.sum != .f32 or (wt.one.bits != 2 and wt.one.bits != 3)) return null;
+        if (wt.one.n != c.moe_inter and wt.one.n != c.hidden) return null;
+        var call = row.callIndexed(base, wt, slots, false) catch return null;
+        call.pipeline = if (wt.one.bits == 2) p.q2 else p.q3;
+        return call;
+    }
+};
+
+pub fn project(enc: mtl.ComputeEncoder, call: row.Call, wt: row.Weights, input: Buffer, plan: Buffer, dispatch: Buffer, output: Buffer) void {
+    bind(enc, call, wt, input, plan, output);
+    enc.dispatchIndirect(dispatch, if (wt.n == c.hidden) 16 else 0, mtl.Size.of(call.threads, 1, 1));
+}
+
+fn bind(enc: mtl.ComputeEncoder, call: row.Call, wt: row.Weights, input: Buffer, indices: Buffer, output: Buffer) void {
+    enc.setPipeline(call.pipeline);
+    enc.setBuffer(input, 0, 0);
+    enc.setBuffer(wt.w, wt.w_off, 1);
+    enc.setBuffer(wt.scales, wt.s_off, 2);
+    enc.setBuffer(wt.biases, wt.b_off, 3);
+    enc.setBytes(std.mem.asBytes(&call.dims), 4);
+    enc.setBuffer(output, 0, 5);
+    enc.setBuffer(indices, 0, 6);
+}
+
+pub fn check(p: Kernels, base: *const row.Pipelines, device: mtl.Device, queue: mtl.Queue, wt: row.Experts, rows: usize) !usize {
+    const slots = rows * c.topk;
+    const grouped = p.choice(base, wt, slots) orelse return 0;
+    const original = try row.callIndexed(base, wt, slots, false);
+    const values = slots * wt.one.n;
+    const inputs = slots / wt.repeat * wt.one.k;
+    const opts = mtl.ResourceOptions.shared;
+    const x = try device.buffer(inputs * 2, opts);
+    defer x.deinit();
+    const ids = try device.buffer(slots * 4, opts);
+    defer ids.deinit();
+    const plan = try device.buffer(plan_bytes, opts);
+    defer plan.deinit();
+    const dispatch = try device.buffer(dispatch_bytes, opts);
+    defer dispatch.deinit();
+    const expected = try device.buffer(values * 2, opts);
+    defer expected.deinit();
+    const actual = try device.buffer(values * 2, opts);
+    defer actual.deinit();
+    for (x.slice(u16, inputs), 0..) |*v, i| {
+        const number: f32 = @floatFromInt(@as(i32, @intCast((i * 163 + 11) % 139)) - 69);
+        v.* = @truncate(@as(u32, @bitCast(number / 64)) >> 16);
+    }
+    const periods = [_]usize{ 6, 1, 2, 3, 4, 5 };
+    for (ids.slice(u32, slots), 0..) |*v, i| {
+        const lane = i % c.topk;
+        v.* = @intCast(lane * 8 + i / c.topk / periods[lane]);
+    }
+    // Exercise the reference's zero-output handling too.
+    ids.slice(u32, slots)[slots - 1] = @intCast(wt.experts);
+    @memset(actual.slice(u16, values), 0xffff);
+    const cb = queue.commandBuffer();
+    const enc = cb.compute(.concurrent);
+    bind(enc, original, wt.one, x, ids, expected);
+    enc.dispatchGroups(mtl.Size.of(original.groups, slots, 1), mtl.Size.of(original.threads, 1, 1));
+    p.schedule(enc, ids, plan, dispatch, slots);
+    enc.barrier();
+    project(enc, grouped, wt.one, x, plan, dispatch, actual);
+    enc.end();
+    cb.commit();
+    cb.wait();
+    if (cb.failure()) |message| {
+        std.log.err("DeepSeek grouped projection check: {s}", .{message});
+        return error.ExpertGroupCheckFailed;
+    }
+    if (!std.mem.eql(u16, expected.slice(u16, values), actual.slice(u16, values))) return error.ExpertGroupOutputDiffers;
+    return values;
+}
