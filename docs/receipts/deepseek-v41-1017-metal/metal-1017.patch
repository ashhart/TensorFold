new file mode 100644
index 0000000000000000000000000000000000000000..37f3fbdd9a05d430721c70d5311619ea71ca45d5
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/expert_groups.metal
@@ -0,0 +1,96 @@
+struct ExpertGroup {
+  uint expert;
+  uint count;
+  uint slots[6];
+};
+
+// The two indirect grids share the same expert groups, with different output widths.
+[[kernel]] void tf_expert_group_plan(const device uint* ids [[buffer(0)]],
+                                     device ExpertGroup* plan [[buffer(1)]],
+                                     device uint4* dispatch [[buffer(2)]],
+                                     constant uint4& args [[buffer(3)]],
+                                     uint slot [[thread_position_in_threadgroup]],
+                                     uint sg [[simdgroup_index_in_threadgroup]],
+                                     uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup uint picks[36];
+  threadgroup uint warp_sizes[2];
+  uint prior = 0, expert = 0;
+  if (slot < args.x) {
+    expert = ids[slot];
+    picks[slot] = expert;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (slot < args.x)
+    for (uint i = 0; i < slot; ++i) prior += uint(picks[i] == expert);
+
+  const uint emit = uint(slot < args.x && prior % args.y == 0);
+  const uint offset = simd_prefix_exclusive_sum(emit);
+  const uint warp_size = simd_sum(emit);
+  if (lane == 0) warp_sizes[sg] = warp_size;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (slot == 0) {
+    const uint groups = warp_sizes[0] + warp_sizes[1];
+    dispatch[0] = uint4(args.z, groups, 1, 0);
+    dispatch[1] = uint4(args.w, groups, 1, 0);
+  }
+  if (emit == 0) return;
+  ExpertGroup group;
+  group.expert = expert;
+  group.count = 0;
+  for (uint i = slot; i < args.x && group.count < args.y; ++i)
+    if (picks[i] == expert) group.slots[group.count++] = i;
+  for (uint i = group.count; i < 6; ++i) group.slots[i] = 0;
+  plan[(sg == 0 ? 0 : warp_sizes[0]) + offset] = group;
+}
+
+template <int BITS, int ROWS>
+static void tf_expert_group_rows(const device bfloat* input, const device uint8_t* weights,
+                                 const device bfloat* scales, const device bfloat* biases,
+                                 device bfloat* output, thread const ExpertGroup& group,
+                                 constant int* dims, int col, uint lane) {
+  constexpr int columns = 4;
+  const int k = dims[0], n = dims[1], gs = dims[2];
+  TfRpRows<ROWS> inputs;
+  for (int i = 0; i < ROWS; ++i) inputs.x[i] = input + size_t(group.slots[i] / dims[5]) * k;
+  const size_t at = size_t(group.expert) * n + col;
+  float acc[ROWS][columns];
+  tf_rp_rows_at<columns, ROWS, BITS, false>(
+      weights + at * (k * BITS / 8), scales + at * (k / gs), biases + at * (k / gs),
+      inputs, k, gs, lane, acc);
+  if (lane == 0)
+    for (int r = 0; r < ROWS; ++r)
+      for (int j = 0; j < columns; ++j) output[size_t(group.slots[r]) * n + col + j] = bfloat(acc[r][j]);
+}
+
+template <int BITS, int LIMIT>
+[[kernel]] void tf_expert_group_projection(const device bfloat* input [[buffer(0)]],
+                                           const device uint8_t* weights [[buffer(1)]],
+                                           const device bfloat* scales [[buffer(2)]],
+                                           const device bfloat* biases [[buffer(3)]],
+                                           constant int* dims [[buffer(4)]],
+                                           device bfloat* output [[buffer(5)]],
+                                           const device ExpertGroup* plan [[buffer(6)]],
+                                           uint3 block [[threadgroup_position_in_grid]],
+                                           uint sg [[simdgroup_index_in_threadgroup]],
+                                           uint lane [[thread_index_in_simdgroup]]) {
+  const int col = (int(block.x) * 2 + int(sg)) * 4;
+  const ExpertGroup group = plan[block.y];
+  if (group.expert >= uint(dims[4])) {
+    if (lane < 4)
+      for (uint r = 0; r < group.count; ++r) output[size_t(group.slots[r]) * dims[1] + col + lane] = bfloat(0.0f);
+    return;
+  }
+  switch (group.count) {
+    case 1: tf_expert_group_rows<BITS, 1>(input, weights, scales, biases, output, group, dims, col, lane); break;
+    case 2: tf_expert_group_rows<BITS, 2>(input, weights, scales, biases, output, group, dims, col, lane); break;
+    case 3: tf_expert_group_rows<BITS, 3>(input, weights, scales, biases, output, group, dims, col, lane); break;
+    case 4: if (LIMIT >= 4) tf_expert_group_rows<BITS, 4>(input, weights, scales, biases, output, group, dims, col, lane); break;
+    case 5: if (LIMIT >= 5) tf_expert_group_rows<BITS, 5>(input, weights, scales, biases, output, group, dims, col, lane); break;
+    case 6: if (LIMIT >= 6) tf_expert_group_rows<BITS, 6>(input, weights, scales, biases, output, group, dims, col, lane); break;
+  }
+}
+
+template [[host_name("tf_expert_group_q2_m3")]] [[kernel]] decltype(tf_expert_group_projection<2, 3>) tf_expert_group_projection<2, 3>;
+template [[host_name("tf_expert_group_q3_m3")]] [[kernel]] decltype(tf_expert_group_projection<3, 3>) tf_expert_group_projection<3, 3>;
+template [[host_name("tf_expert_group_q2_m6")]] [[kernel]] decltype(tf_expert_group_projection<2, 6>) tf_expert_group_projection<2, 6>;
+template [[host_name("tf_expert_group_q3_m6")]] [[kernel]] decltype(tf_expert_group_projection<3, 6>) tf_expert_group_projection<3, 6>;
