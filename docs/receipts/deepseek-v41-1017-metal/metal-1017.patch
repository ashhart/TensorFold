diff --git a/zig/src/families/deepseek_v41_metal/route_pair.metal b/zig/src/families/deepseek_v41_metal/route_pair.metal
new file mode 100644
index 0000000000000000000000000000000000000000..c23313f343528b6e19df33b31ee5881d48b86d02
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/route_pair.metal
@@ -0,0 +1,137 @@
+// Pair only slots that already chose the same existing expert. Store back to the original slots.
+[[kernel]] void tf_pair_expert_slots(const device uint* ids [[buffer(0)]],
+                                    device int* mates [[buffer(1)]],
+                                    constant uint& slots [[buffer(2)]],
+                                    uint slot [[thread_position_in_grid]]) {
+  const uint expert = ids[slot];
+  uint ordinal = 0;
+  for (uint i = 0; i < slot; ++i) ordinal += uint(ids[i] == expert);
+  if (ordinal & 1) {
+    mates[slot] = -1;
+    return;
+  }
+  for (uint i = slot + 1; i < slots; ++i) {
+    if (ids[i] == expert) {
+      mates[slot] = int(i);
+      return;
+    }
+  }
+  mates[slot] = int(slot);
+}
+
+// For a small rectangular grid, derive each tile's partners from the actual
+// router IDs. The masks follow slot order so scatters keep their original slots.
+static int tf_take_route(thread uint& lo, thread uint& hi, int missing) {
+  if (lo != 0) {
+    const int slot = int(ctz(lo));
+    lo &= lo - 1;
+    return slot;
+  }
+  if (hi != 0) {
+    const int slot = 32 + int(ctz(hi));
+    hi &= hi - 1;
+    return slot;
+  }
+  return missing;
+}
+
+template <int CAP>
+static int2 tf_route_peers(const device uint* ids, int slots, uint lane, int slot) {
+  const uint expert = ids[slot];
+  uint lo = simd_or(int(lane) < slots && ids[lane] == expert ? 1u << lane : 0u);
+  uint hi = slots > 32 ? simd_or(int(lane + 32) < slots && ids[lane + 32] == expert ? 1u << lane : 0u) : 0u;
+  const uint before = (1u << uint(slot & 31)) - 1;
+  const bool low_slot = slot < 32;
+  const uint rank = low_slot ? popcount(lo & before) : popcount(lo) + popcount(hi & before);
+  const uint group = CAP == 0 ? 1 : CAP;
+  if (rank % group != 0) return int2(-1);
+  const uint own = 1u << uint(slot & 31);
+  lo = low_slot ? lo & ~before & ~own : 0;
+  if (!low_slot) hi &= ~before & ~own;
+  const int second = tf_take_route(lo, hi, slot);
+  const int third = CAP == 3 ? tf_take_route(lo, hi, slot) : slot;
+  return int2(second, third);
+}
+
+template <int BITS, int INLINE_CAP = 0, int FIXED_K = 0, int FIXED_N = 0>
+[[kernel]] void tf_row_projection_pair(
+    const device bfloat* X [[buffer(0)]],
+    const device uint32_t* W [[buffer(1)]],
+    const device bfloat* S [[buffer(2)]],
+    const device bfloat* B [[buffer(3)]],
+    constant int* dims [[buffer(4)]],
+    device bfloat* OUT [[buffer(5)]],
+    const device uint* ids [[buffer(6)]],
+    const device int* mates [[buffer(7)]],
+    uint sg [[simdgroup_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint3 block [[threadgroup_position_in_grid]]) {
+  const int slot = int(block.y);
+  int2 others;
+  if (INLINE_CAP == 0) others = int2(mates[slot], slot);
+  else others = tf_route_peers<INLINE_CAP>(ids, dims[3], lane, slot);
+  const int mate = others.x, third = others.y;
+  if (mate < 0) return;
+  constexpr bool fixed = FIXED_K != 0;
+  const int K = fixed ? FIXED_K : dims[0], N = fixed ? FIXED_N : dims[1];
+  const int GS = fixed ? 64 : dims[2], repeat = fixed ? (FIXED_K == 5120 ? 6 : 1) : dims[5];
+  const int columns = 4, row0 = (int(block.x) * 2 + int(sg)) * columns;
+  const uint expert = ids[slot];
+  device bfloat* y0 = OUT + size_t(slot) * N + row0;
+  device bfloat* y1 = OUT + size_t(mate) * N + row0;
+  if (expert >= uint(dims[4])) {
+    if (lane < uint(columns)) {
+      y0[lane] = bfloat(0.0f);
+      if (mate != slot) y1[lane] = bfloat(0.0f);
+      if (INLINE_CAP == 3 && third != slot) OUT[size_t(third) * N + row0 + lane] = bfloat(0.0f);
+    }
+    return;
+  }
+  const size_t at = size_t(expert) * N + row0;
+  const device uint8_t* wr = (const device uint8_t*)W + at * (K * BITS / 8);
+  const device bfloat* sr = S + at * (K / GS);
+  const device bfloat* br = B + at * (K / GS);
+  const device bfloat* x0 = X + size_t(slot / repeat) * K;
+  if (INLINE_CAP == 3 && third != slot) {
+    device bfloat* y2 = OUT + size_t(third) * N + row0;
+    TfRpRows<3> inputs = { x0, X + size_t(mate / repeat) * K, X + size_t(third / repeat) * K };
+    float acc[3][columns];
+    tf_rp_rows_at<columns, 3, BITS, false, fixed>(wr, sr, br, inputs, K, GS, lane, acc);
+    if (lane == 0) for (int j = 0; j < columns; ++j) {
+      y0[j] = bfloat(acc[0][j]);
+      y1[j] = bfloat(acc[1][j]);
+      y2[j] = bfloat(acc[2][j]);
+    }
+  } else if (mate == slot) {
+    float acc[1][columns];
+    tf_rp_rows<columns, 1, BITS, false, fixed>(wr, sr, br, x0, K, GS, lane, acc);
+    if (lane == 0) for (int j = 0; j < columns; ++j) y0[j] = bfloat(acc[0][j]);
+  } else {
+    TfRpRows<2> inputs = { x0, X + size_t(mate / repeat) * K };
+    float acc[2][columns];
+    tf_rp_rows_at<columns, 2, BITS, false, fixed>(wr, sr, br, inputs, K, GS, lane, acc);
+    if (lane == 0) for (int j = 0; j < columns; ++j) {
+      y0[j] = bfloat(acc[0][j]);
+      y1[j] = bfloat(acc[1][j]);
+    }
+  }
+}
+
+template [[host_name("tf_row_projection_pair_q2")]] [[kernel]] decltype(tf_row_projection_pair<2>) tf_row_projection_pair<2>;
+template [[host_name("tf_row_projection_pair_q3")]] [[kernel]] decltype(tf_row_projection_pair<3>) tf_row_projection_pair<3>;
+
+template [[host_name("tf_row_projection_inline2_q2")]] [[kernel]] decltype(tf_row_projection_pair<2, 2>) tf_row_projection_pair<2, 2>;
+
+template [[host_name("tf_row_projection_inline2_q3")]] [[kernel]] decltype(tf_row_projection_pair<3, 2>) tf_row_projection_pair<3, 2>;
+
+template [[host_name("tf_row_projection_inline3_q2")]] [[kernel]] decltype(tf_row_projection_pair<2, 3>) tf_row_projection_pair<2, 3>;
+
+template [[host_name("tf_row_projection_inline3_q3")]] [[kernel]] decltype(tf_row_projection_pair<3, 3>) tf_row_projection_pair<3, 3>;
+
+template [[host_name("tf_row_shape_gate_q2")]] [[kernel]] decltype(tf_row_projection_pair<2, 2, 5120, 2304>) tf_row_projection_pair<2, 2, 5120, 2304>;
+
+template [[host_name("tf_row_shape_down_q2")]] [[kernel]] decltype(tf_row_projection_pair<2, 2, 2304, 5120>) tf_row_projection_pair<2, 2, 2304, 5120>;
+
+template [[host_name("tf_row_shape_gate_q3")]] [[kernel]] decltype(tf_row_projection_pair<3, 2, 5120, 2304>) tf_row_projection_pair<3, 2, 5120, 2304>;
+
+template [[host_name("tf_row_shape_down_q3")]] [[kernel]] decltype(tf_row_projection_pair<3, 2, 2304, 5120>) tf_row_projection_pair<3, 2, 2304, 5120>;
diff --git a/zig/src/families/deepseek_v41_metal/route_pair.zig b/zig/src/families/deepseek_v41_metal/route_pair.zig
new file mode 100644
index 0000000000000000000000000000000000000000..71e27a11c8f9593a0e6d944c2eb25b29394622ab
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/route_pair.zig
@@ -0,0 +1,144 @@
+//! Match repeated routed experts in decode windows and retain the existing per-row operations.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const row = @import("../../core/row_projection.zig");
+const Buffer = mtl.Buffer;
+
+pub const Kernels = struct {
+    plan: mtl.Pipeline,
+    q2: mtl.Pipeline,
+    q3: mtl.Pipeline,
+    inline_cap: u8 = 0,
+    fixed: ?[4]mtl.Pipeline = null,
+
+    pub fn load(device: mtl.Device) !?Kernels {
+        const raw_cap = std.c.getenv("TF_BENCH_DS_INLINE_EXPERT_CAP");
+        if (!device.tensorUnits() or (raw_cap == null and std.c.getenv("TF_BENCH_DS_ROW_PAIR") == null) or std.c.getenv("DS_SKIP") != null) return null;
+        const inline_cap = if (raw_cap) |value| try std.fmt.parseInt(u8, std.mem.span(value), 10) else 0;
+        if (raw_cap != null and inline_cap != 2 and inline_cap != 3) return error.InvalidInlineExpertCap;
+        const source = sources.core_row_projection ++ "\n" ++ @embedFile("route_pair.metal");
+        const lib = try mtl.Library.fromSource(device, source, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const plan = try mtl.Pipeline.init(device, lib, "tf_pair_expert_slots", false);
+        errdefer plan.deinit();
+        const names: [2][:0]const u8 = switch (inline_cap) {
+            2 => .{ "tf_row_projection_inline2_q2", "tf_row_projection_inline2_q3" },
+            3 => .{ "tf_row_projection_inline3_q2", "tf_row_projection_inline3_q3" },
+            else => .{ "tf_row_projection_pair_q2", "tf_row_projection_pair_q3" },
+        };
+        const q2 = try mtl.Pipeline.init(device, lib, names[0], false);
+        errdefer q2.deinit();
+        const q3 = try mtl.Pipeline.init(device, lib, names[1], false);
+        errdefer q3.deinit();
+        var out: Kernels = .{ .plan = plan, .q2 = q2, .q3 = q3, .inline_cap = inline_cap };
+        if (std.c.getenv("TF_BENCH_DS_ROUTE_SHAPE") != null) {
+            if (inline_cap != 2) return error.RouteShapeNeedsInlineTwo;
+            var fixed: [4]mtl.Pipeline = undefined;
+            var initialized: usize = 0;
+            errdefer for (fixed[0..initialized]) |p| p.deinit();
+            for ([_][:0]const u8{ "tf_row_shape_gate_q2", "tf_row_shape_down_q2", "tf_row_shape_gate_q3", "tf_row_shape_down_q3" }, 0..) |name, i| {
+                fixed[i] = try mtl.Pipeline.init(device, lib, name, false);
+                initialized += 1;
+            }
+            out.fixed = fixed;
+            std.log.info("deepseek_v41 bench: fixed target expert shapes", .{});
+        }
+        return out;
+    }
+
+    pub fn deinit(p: Kernels) void {
+        p.plan.deinit();
+        p.q2.deinit();
+        p.q3.deinit();
+        if (p.fixed) |fixed| for (fixed) |item| item.deinit();
+    }
+
+    pub fn encodePlan(p: Kernels, e: mtl.ComputeEncoder, ids: Buffer, mates: Buffer, slots: usize) void {
+        e.setPipeline(p.plan);
+        e.setBuffer(ids, 0, 0);
+        e.setBuffer(mates, 0, 1);
+        const n: u32 = @intCast(slots);
+        e.setBytes(std.mem.asBytes(&n), 2);
+        e.dispatchThreads(mtl.Size.of(slots, 1, 1), mtl.Size.of(@min(32, slots), 1, 1));
+    }
+
+    pub fn choice(p: Kernels, base: *const row.Pipelines, wt: row.Experts, slots: usize) ?row.Call {
+        if ((p.inline_cap != 0 and slots > 36) or wt.one.sum != .f32 or (wt.one.bits != 2 and wt.one.bits != 3)) return null;
+        var call = row.callIndexed(base, wt, slots, false) catch return null;
+        call.pipeline = if (wt.one.bits == 2) p.q2 else p.q3;
+        if (p.fixed) |fixed| if (fixedIndex(wt)) |index| {
+            call.pipeline = fixed[index];
+        };
+        return call;
+    }
+};
+
+pub fn fixedIndex(wt: row.Experts) ?usize {
+    if (wt.experts != 384 or wt.one.group != 64 or wt.one.w_off % 2 != 0 or
+        wt.one.sum != .f32 or (wt.one.bits != 2 and wt.one.bits != 3)) return null;
+    const bits: usize = if (wt.one.bits == 2) 0 else 2;
+    if (wt.one.k == 5120 and wt.one.n == 2304 and wt.repeat == 6) return bits;
+    if (wt.one.k == 2304 and wt.one.n == 5120 and wt.repeat == 1) return bits + 1;
+    return null;
+}
+
+pub fn encode(e: mtl.ComputeEncoder, call: row.Call, wt: row.Weights, x: Buffer, ids: Buffer, mates: ?Buffer, y: Buffer) void {
+    e.setPipeline(call.pipeline);
+    e.setBuffer(x, 0, 0);
+    e.setBuffer(wt.w, wt.w_off, 1);
+    e.setBuffer(wt.scales, wt.s_off, 2);
+    e.setBuffer(wt.biases, wt.b_off, 3);
+    e.setBytes(std.mem.asBytes(&call.dims), 4);
+    e.setBuffer(y, 0, 5);
+    e.setBuffer(ids, 0, 6);
+    if (mates) |b| e.setBuffer(b, 0, 7);
+    e.dispatchThreads(mtl.Size.of(call.groups * call.threads, call.slots, 1), mtl.Size.of(call.threads, 1, 1));
+}
+
+pub fn check(p: Kernels, base: *const row.Pipelines, dev: mtl.Device, queue: mtl.Queue, wt: row.Experts, rows: usize, topk: usize) !usize {
+    const slots = rows * topk;
+    const test_call = p.choice(base, wt, slots) orelse return 0;
+    const ref_call = try row.callIndexed(base, wt, slots, false);
+    const values = slots * wt.one.n;
+    const inputs = slots / wt.repeat * wt.one.k;
+    const opts = mtl.ResourceOptions.shared;
+    const x = try dev.buffer(inputs * 2, opts);
+    defer x.deinit();
+    const ids = try dev.buffer(slots * 4, opts);
+    defer ids.deinit();
+    const mates = try dev.buffer(slots * 4, opts);
+    defer mates.deinit();
+    const ref = try dev.buffer(values * 2, opts);
+    defer ref.deinit();
+    const result = try dev.buffer(values * 2, opts);
+    defer result.deinit();
+    for (x.slice(u16, inputs), 0..) |*v, i| {
+        const signed: f32 = @floatFromInt(@as(i32, @intCast((i * 739 + 17) % 257)) - 128);
+        v.* = @truncate(@as(u32, @bitCast(signed / 32.0)) >> 16);
+    }
+    for (ids.slice(u32, slots), 0..) |*v, i| {
+        const slot = i % topk;
+        const group = if (slot % 2 == 0) i / topk else 0;
+        v.* = @intCast((slot * 11 + group * 31) % wt.experts);
+    }
+    if (p.inline_cap != 0) {
+        // Include repeated masked slots in both halves of a 36-slot window.
+        ids.slice(u32, slots)[0] = @intCast(wt.experts);
+        ids.slice(u32, slots)[slots - 1] = @intCast(wt.experts);
+    }
+    const cb = queue.commandBuffer();
+    const e = cb.compute(.serial);
+    encode(e, ref_call, wt.one, x, ids, null, ref);
+    if (p.inline_cap == 0) p.encodePlan(e, ids, mates, slots);
+    encode(e, test_call, wt.one, x, ids, if (p.inline_cap == 0) mates else null, result);
+    e.end();
+    cb.commit();
+    cb.wait();
+    if (cb.failure()) |message| {
+        std.log.err("DeepSeek row pairing check: {s}", .{message});
+        return error.ExpertPairCheckFailed;
+    }
+    if (!std.mem.eql(u16, ref.slice(u16, values), result.slice(u16, values))) return error.ExpertPairOutputDiffers;
+    return values;
+}
diff --git a/zig/src/families/deepseek_v41_metal/route_probe.zig b/zig/src/families/deepseek_v41_metal/route_probe.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0796897391db1c0ff6543ef3f4cc845815975886
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/route_probe.zig
@@ -0,0 +1,27 @@
+//! Benchmark-only trace of each verified row and the target router's expert IDs.
+const std = @import("std");
+const mtl = @import("metal");
+const c = @import("config.zig");
+const width = 1 + c.draft_block;
+
+pub fn enabled() bool {
+    return std.c.getenv("TF_BENCH_DS_ROUTE_TRACE") != null;
+}
+
+pub fn emit(position: u64, input: []const u32, output: []const u32, buffer: mtl.Buffer, config: *const c.Config) void {
+    var routes: [c.layers * width * c.topk]u16 = undefined;
+    var bits: [c.layers]u8 = undefined;
+    const raw = buffer.slice(u32, routes.len);
+    for (0..c.layers) |layer| {
+        bits[layer] = config.experts[layer].bits;
+        const start = layer * width * c.topk;
+        for (0..input.len * c.topk) |j| routes[start + j] = @intCast(raw[start + j]);
+        @memset(routes[start + input.len * c.topk ..][0 .. (width - input.len) * c.topk], 0);
+    }
+    const b64 = std.base64.standard.Encoder;
+    var bytes: [b64.calcSize(@sizeOf(@TypeOf(routes)))]u8 = undefined;
+    const picks = b64.encode(&bytes, std.mem.asBytes(&routes));
+    std.debug.print("route-probe pos={d} rows={d} in={any} out={any} bits={any} picks={s}\n", .{
+        position, input.len, input, output, &bits, picks,
+    });
+}
diff --git a/zig/src/families/deepseek_v41_metal/router_live.zig b/zig/src/families/deepseek_v41_metal/router_live.zig
new file mode 100644
index 0000000000000000000000000000000000000000..640f990b9015b967954a18535252f1ae31f89015
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/router_live.zig
@@ -0,0 +1,64 @@
+//! Exact router projection and selection candidates for short verify windows.
+const std = @import("std");
+const mtl = @import("metal");
+const c = @import("config.zig");
+const st = @import("state.zig");
+const wts = @import("weights.zig");
+const probe = @import("router_reduction.zig");
+const Buffer = mtl.Buffer;
+pub const max_rows = 1 + c.draft_block;
+
+pub const Kernels = struct {
+    projections: [max_rows]mtl.Pipeline,
+    selector: ?mtl.Pipeline,
+    audit: ?mtl.Pipeline,
+
+    pub fn load(device: mtl.Device, select: bool, audit: bool) !Kernels {
+        const shader = @embedFile("router_reduction.metal") ++ "\n" ++
+            \\[[kernel]] void tf_router_audit(
+            \\  const device uint* logits [[buffer(0)]], const device uint* ids [[buffer(1)]],
+            \\  const device uint* w [[buffer(2)]], const device uint* old_logits [[buffer(3)]],
+            \\  const device uint* old_ids [[buffer(4)]], const device uint* old_w [[buffer(5)]],
+            \\  device atomic_uint* differs [[buffer(6)]], constant uint& rows [[buffer(7)]],
+            \\  uint t [[thread_position_in_grid]]) {
+            \\    uint mask = logits[t] == old_logits[t] ? 0u : 1u;
+            \\    if (t < rows * 6) {
+            \\      if (ids[t] != old_ids[t]) mask |= 2u;
+            \\      if (w[t] != old_w[t]) mask |= 4u;
+            \\    }
+            \\    if (mask != 0) atomic_fetch_or_explicit(differs, mask, memory_order_relaxed);
+            \\}
+        ;
+        const lib = try mtl.Library.fromSource(device, shader, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        var rows: [max_rows]mtl.Pipeline = undefined;
+        var n: usize = 0;
+        errdefer for (rows[0..n]) |p| p.deinit();
+        for (1..max_rows + 1) |r| {
+            rows[r - 1] = try probe.projection(device, lib, r, if (r == 1) 2 else 1);
+            n += 1;
+        }
+        const selector = if (select) try mtl.Pipeline.init(device, lib, "tf_route_merge", false) else null;
+        errdefer if (selector) |p| p.deinit();
+        const checked = if (audit) try mtl.Pipeline.init(device, lib, "tf_router_audit", false) else null;
+        return .{ .projections = rows, .selector = selector, .audit = checked };
+    }
+
+    pub fn deinit(p: Kernels) void {
+        for (p.projections) |pipe| pipe.deinit();
+        if (p.selector) |pipe| pipe.deinit();
+        if (p.audit) |pipe| pipe.deinit();
+    }
+
+    pub fn issue(p: Kernels, e: mtl.ComputeEncoder, w: wts.Tensor, input: Buffer, output: Buffer, rows: usize) void {
+        probe.encodeProjection(e, p.projections[rows - 1], w, input, output, rows, if (rows == 1) 4 else 2);
+    }
+
+    pub fn compare(p: mtl.Pipeline, e: mtl.ComputeEncoder, s: *st.Scratch, rows: usize) void {
+        e.setPipeline(p);
+        for ([_]Buffer{ s.router, s.route_pick, s.route_weight, s.router_ref_logits, s.router_ref_ids,
+            s.router_ref_weights, s.router_variant_error }, 0..) |buf, i| e.setBuffer(buf, 0, i);
+        e.setValue(@as(u32, @intCast(rows)), 7);
+        e.dispatchThreads(mtl.Size.of(rows * c.experts, 1, 1), mtl.Size.of(256, 1, 1));
+    }
+};
diff --git a/zig/src/families/deepseek_v41_metal/router_reduction.metal b/zig/src/families/deepseek_v41_metal/router_reduction.metal
new file mode 100644
index 0000000000000000000000000000000000000000..55e7aa14605d6a2756c32c205f5c081f67e504e1
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/router_reduction.metal
@@ -0,0 +1,330 @@
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+struct RouteArgs {
+  int experts;
+  int topk;
+  float scale;
+  int trace_layer;
+};
+
+// The better of two (value, id) pairs in ds_route's order: the higher value, the lower id on ties.
+inline bool route_better(float ov, int oi, float v, int id) { return ov > v || (ov == v && oi < id); }
+
+// Routing a threadgroup a row: top-k of sqrt(softplus) + bias (lower id on ties, bias_vl on images), expert order.
+// Each simdgroup takes its own top-k in that order without the threadgroup; simdgroup 0 then takes the top-k of
+// those candidates (nsg * topk <= 96), which are the row's in the same order, so the weights sum in pick order.
+
+// Numeric FP32 ordering expressed as unsigned bits, with both zeros equal.
+inline uint tf_route_order(float value) {
+  uint u = as_type<uint>(value);
+  if ((u & 0x7fffffffu) == 0) u = 0;
+  return (u & 0x80000000u) ? ~u : (u ^ 0x80000000u);
+}
+inline int tf_route_rank(float value, int id) {
+  const uint key = tf_route_order(value);
+  const uint top = simd_max(key);
+  return simd_min(key == top ? id : 0x7fffffff);
+}
+
+[[kernel]] void tf_route_reduce(const device float* LOGITS [[buffer(0)]], const device float* BIAS [[buffer(1)]],
+                         device uint* PICK [[buffer(2)]], device float* WEIGHT [[buffer(3)]],
+                         constant RouteArgs& a [[buffer(4)]], const device int* IMG [[buffer(5)]],
+                         const device float* BIAS_VL [[buffer(6)]], device uint* TRACE [[buffer(7)]], uint r [[threadgroup_position_in_grid]],
+                         uint t [[thread_position_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+                         uint sg [[simdgroup_index_in_threadgroup]], uint nsg [[simdgroups_per_threadgroup]]) {
+  threadgroup uint bad[32];
+  threadgroup float cv[32][16];
+  threadgroup int ci[32][16];
+  threadgroup float cs[32][16];
+  const device float* z = LOGITS + size_t(r) * a.experts;
+  float score = 0.0f, key = -INFINITY;
+  if (int(t) < a.experts) {
+    const float x = z[t];
+    score = precise::sqrt(x > 20.0f ? x : precise::log(1.0f + precise::exp(x)));
+    key = score + (IMG[r] ? BIAS_VL[t] : BIAS[t]);  // an image span's rows steer by their own bias
+  }
+  const int myid = int(t) < a.experts ? int(t) : 0x7fffffff;
+  const bool ordinary = simd_all(isfinite(key));
+  if (lane == 0) bad[sg] = !ordinary;
+  for (int k = 0; k < a.topk; k++) {
+    float v = key;
+    int id = myid;
+    if (ordinary) {
+      id = tf_route_rank(v, id);
+      v = simd_shuffle(v, ushort(id & 31));
+    } else {
+    for (ushort o = 16; o > 0; o >>= 1) {
+      const float ov = simd_shuffle_down(v, o);
+      const int oi = simd_shuffle_down(id, o);
+      if (route_better(ov, oi, v, id)) {
+        v = ov;
+        id = oi;
+      }
+    }
+    }
+    v = simd_broadcast(v, 0);
+    id = simd_broadcast(id, 0);
+    const float s = simd_broadcast(id == myid ? score : 0.0f, ushort(id & 31));
+    if (lane == 0) {
+      cv[sg][k] = v;
+      ci[sg][k] = id;
+      cs[sg][k] = s;
+    }
+    if (id == myid) key = -INFINITY;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (sg != 0) return;
+  const bool all_ordinary = simd_all(lane >= nsg || !bad[lane]);
+  // simdgroup 0: lane l holds candidates l, l + 32 and l + 64
+  const int total = int(nsg) * a.topk;
+  float lv[3], ls[3];
+  int li[3];
+  for (int j = 0; j < 3; j++) {
+    const int c = int(lane) + 32 * j;
+    const bool live = c < total;
+    lv[j] = live ? cv[c / a.topk][c % a.topk] : -INFINITY;
+    li[j] = live ? ci[c / a.topk][c % a.topk] : 0x7fffffff;
+    ls[j] = live ? cs[c / a.topk][c % a.topk] : 0.0f;
+  }
+  int s2[16];
+  float w2[16];
+  for (int k = 0; k < a.topk; k++) {
+    float v = lv[0];
+    int id = li[0];
+    for (int j = 1; j < 3; j++)
+      if (route_better(lv[j], li[j], v, id)) {
+        v = lv[j];
+        id = li[j];
+      }
+    if (all_ordinary) {
+      id = tf_route_rank(v, id);
+    } else {
+    for (ushort o = 16; o > 0; o >>= 1) {
+      const float ov = simd_shuffle_down(v, o);
+      const int oi = simd_shuffle_down(id, o);
+      if (route_better(ov, oi, v, id)) {
+        v = ov;
+        id = oi;
+      }
+    }
+    }
+    id = simd_broadcast(id, 0);
+    float mine = 0.0f;
+    bool has = false;
+    for (int j = 0; j < 3; j++)
+      if (li[j] == id) {
+        mine = ls[j];
+        has = true;
+        lv[j] = -INFINITY;
+        li[j] = 0x7fffffff;
+      }
+    s2[k] = id;
+    w2[k] = simd_broadcast(mine, ushort(simd_min(has ? lane : 32u)));
+  }
+  if (lane == 0) {
+    float sum = 0.0f;
+    for (int k = 0; k < a.topk; k++) sum += w2[k];
+    for (int k = 0; k < a.topk; k++) w2[k] = w2[k] / (sum + 1e-20f) * a.scale;
+    for (int i = 1; i < a.topk; i++)
+      for (int j = i; j > 0 && s2[j - 1] > s2[j]; j--) {
+        const int ts = s2[j];
+        s2[j] = s2[j - 1];
+        s2[j - 1] = ts;
+        const float tw = w2[j];
+        w2[j] = w2[j - 1];
+        w2[j - 1] = tw;
+      }
+    for (int k = 0; k < a.topk; k++) {
+      PICK[r * a.topk + k] = uint(s2[k]);
+      if (a.trace_layer >= 0) TRACE[(a.trace_layer * 6 + r) * a.topk + k] = uint(s2[k]);
+      WEIGHT[r * a.topk + k] = w2[k];
+    }
+  }
+}
+
+
+[[kernel]] void tf_route_merge(const device float* LOGITS [[buffer(0)]], const device float* BIAS [[buffer(1)]],
+                         device uint* PICK [[buffer(2)]], device float* WEIGHT [[buffer(3)]],
+                         constant RouteArgs& a [[buffer(4)]], const device int* IMG [[buffer(5)]],
+                         const device float* BIAS_VL [[buffer(6)]], device uint* TRACE [[buffer(7)]], uint r [[threadgroup_position_in_grid]],
+                         uint t [[thread_position_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+                         uint sg [[simdgroup_index_in_threadgroup]], uint nsg [[simdgroups_per_threadgroup]]) {
+  threadgroup uint bad[32];
+  threadgroup float cv[32][16];
+  threadgroup int ci[32][16];
+  threadgroup float cs[32][16];
+  const device float* z = LOGITS + size_t(r) * a.experts;
+  float score = 0.0f, key = -INFINITY;
+  if (int(t) < a.experts) {
+    const float x = z[t];
+    score = precise::sqrt(x > 20.0f ? x : precise::log(1.0f + precise::exp(x)));
+    key = score + (IMG[r] ? BIAS_VL[t] : BIAS[t]);  // an image span's rows steer by their own bias
+  }
+  const int myid = int(t) < a.experts ? int(t) : 0x7fffffff;
+  const bool ordinary = simd_all(isfinite(key));
+  if (lane == 0) bad[sg] = !ordinary;
+  for (int k = 0; k < a.topk; k++) {
+    float v = key;
+    int id = myid;
+    if (ordinary) {
+      id = tf_route_rank(v, id);
+      v = simd_shuffle(v, ushort(id & 31));
+    } else {
+    for (ushort o = 16; o > 0; o >>= 1) {
+      const float ov = simd_shuffle_down(v, o);
+      const int oi = simd_shuffle_down(id, o);
+      if (route_better(ov, oi, v, id)) {
+        v = ov;
+        id = oi;
+      }
+    }
+    }
+    v = simd_broadcast(v, 0);
+    id = simd_broadcast(id, 0);
+    const float s = simd_broadcast(id == myid ? score : 0.0f, ushort(id & 31));
+    if (lane == 0) {
+      cv[sg][k] = v;
+      ci[sg][k] = id;
+      cs[sg][k] = s;
+    }
+    if (id == myid) key = -INFINITY;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (sg != 0) return;
+  const bool all_ordinary = simd_all(lane >= nsg || !bad[lane]);
+  int s2[16];
+  float w2[16];
+  if (all_ordinary) {
+    int at = 0;
+    const bool live = lane < nsg;
+    for (int k = 0; k < a.topk; k++) {
+      const bool used = live && at < a.topk;
+      const float v = used ? cv[lane][at] : -INFINITY;
+      const int candidate = used ? ci[lane][at] : 0x7fffffff;
+      const float score = used ? cs[lane][at] : 0.0f;
+      const int id = tf_route_rank(v, candidate);
+      const uint from = simd_min(candidate == id ? lane : 32u);
+      s2[k] = id;
+      w2[k] = simd_broadcast(score, ushort(from));
+      at += (lane == from);
+    }
+  } else {
+  // simdgroup 0: lane l holds candidates l, l + 32 and l + 64
+  const int total = int(nsg) * a.topk;
+  float lv[3], ls[3];
+  int li[3];
+  for (int j = 0; j < 3; j++) {
+    const int c = int(lane) + 32 * j;
+    const bool live = c < total;
+    lv[j] = live ? cv[c / a.topk][c % a.topk] : -INFINITY;
+    li[j] = live ? ci[c / a.topk][c % a.topk] : 0x7fffffff;
+    ls[j] = live ? cs[c / a.topk][c % a.topk] : 0.0f;
+  }
+  for (int k = 0; k < a.topk; k++) {
+    float v = lv[0];
+    int id = li[0];
+    for (int j = 1; j < 3; j++)
+      if (route_better(lv[j], li[j], v, id)) {
+        v = lv[j];
+        id = li[j];
+      }
+    if (all_ordinary) {
+      id = tf_route_rank(v, id);
+    } else {
+    for (ushort o = 16; o > 0; o >>= 1) {
+      const float ov = simd_shuffle_down(v, o);
+      const int oi = simd_shuffle_down(id, o);
+      if (route_better(ov, oi, v, id)) {
+        v = ov;
+        id = oi;
+      }
+    }
+    }
+    id = simd_broadcast(id, 0);
+    float mine = 0.0f;
+    bool has = false;
+    for (int j = 0; j < 3; j++)
+      if (li[j] == id) {
+        mine = ls[j];
+        has = true;
+        lv[j] = -INFINITY;
+        li[j] = 0x7fffffff;
+      }
+    s2[k] = id;
+    w2[k] = simd_broadcast(mine, ushort(simd_min(has ? lane : 32u)));
+  }
+  }
+  if (lane == 0) {
+    float sum = 0.0f;
+    for (int k = 0; k < a.topk; k++) sum += w2[k];
+    for (int k = 0; k < a.topk; k++) w2[k] = w2[k] / (sum + 1e-20f) * a.scale;
+    for (int i = 1; i < a.topk; i++)
+      for (int j = i; j > 0 && s2[j - 1] > s2[j]; j--) {
+        const int ts = s2[j];
+        s2[j] = s2[j - 1];
+        s2[j - 1] = ts;
+        const float tw = w2[j];
+        w2[j] = w2[j - 1];
+        w2[j - 1] = tw;
+      }
+    for (int k = 0; k < a.topk; k++) {
+      PICK[r * a.topk + k] = uint(s2[k]);
+      if (a.trace_layer >= 0) TRACE[(a.trace_layer * 6 + r) * a.topk + k] = uint(s2[k]);
+      WEIGHT[r * a.topk + k] = w2[k];
+    }
+  }
+}
+
+
+template <int ROWS, int COLS>
+[[kernel]] void tf_router_project(
+    const device bfloat4* X [[buffer(0)]], const device bfloat4* W [[buffer(1)]],
+    device float* Y [[buffer(2)]],
+    uint tg [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]], uint nsg [[simdgroups_per_threadgroup]]) {
+  constexpr int K = 5120, N = 384;
+  const int j0 = (int(tg) * int(nsg) + int(sg)) * COLS;
+  float acc[ROWS][COLS];
+  for (int r = 0; r < ROWS; ++r)
+    for (int c = 0; c < COLS; ++c)
+      acc[r][c] = 0.0f;
+
+  for (int k = int(lane) * 2; k < K / 4; k += 64) {
+    float w[COLS][8];
+    for (int c = 0; c < COLS; ++c) {
+      const device bfloat4* p = W + (j0 + c) * (K / 4) + k;
+      const bfloat4 lo = p[0], hi = p[1];
+      for (int i = 0; i < 4; ++i) {
+        w[c][i] = float(lo[i]);
+        w[c][i + 4] = float(hi[i]);
+      }
+    }
+    for (int r = 0; r < ROWS; ++r) {
+      const device bfloat4* p = X + r * (K / 4) + k;
+      const bfloat4 lo = p[0], hi = p[1];
+      float x[8];
+      for (int i = 0; i < 4; ++i) {
+        x[i] = float(lo[i]);
+        x[i + 4] = float(hi[i]);
+      }
+      for (int c = 0; c < COLS; ++c) {
+        float part = 0.0f;
+        for (int i = 0; i < 8; ++i) part += x[i] * w[c][i];
+        acc[r][c] += part;
+      }
+    }
+  }
+  for (int r = 0; r < ROWS; ++r)
+    for (int c = 0; c < COLS; ++c) {
+      const float value = simd_sum(acc[r][c]);
+      if (lane == 0) Y[r * N + j0 + c] = value;
+    }
+}
+
+#define TF_ROUTER(R, C) template [[host_name("tf_router_project_" #R "_" #C)]] [[kernel]] \
+  decltype(tf_router_project<R, C>) tf_router_project<R, C>;
+#define TF_ROUTER_COLS(R) TF_ROUTER(R, 1) TF_ROUTER(R, 2) TF_ROUTER(R, 4)
+TF_ROUTER_COLS(1) TF_ROUTER_COLS(2) TF_ROUTER_COLS(3)
+TF_ROUTER_COLS(4) TF_ROUTER_COLS(5) TF_ROUTER_COLS(6)
+
diff --git a/zig/src/families/deepseek_v41_metal/router_reduction.zig b/zig/src/families/deepseek_v41_metal/router_reduction.zig
new file mode 100644
index 0000000000000000000000000000000000000000..645c3b9f0beff90b883ec082e2859a46111d5826
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/router_reduction.zig
@@ -0,0 +1,187 @@
+//! Measure the full, exact router path on installed DeepSeek weights.
+const std = @import("std");
+const mtl = @import("metal");
+const c = @import("config.zig");
+const fwd = @import("forward.zig");
+const st = @import("state.zig");
+const wts = @import("weights.zig");
+const Model = @import("model.zig").Model;
+const Buffer = mtl.Buffer;
+const rows_max = 1 + c.draft_block;
+const RouteArgs = extern struct {
+    experts: i32 = c.experts,
+    topk: i32 = c.topk,
+    scale: f32 = c.route_scale,
+    trace_layer: i32 = -1,
+};
+
+pub const Layout = struct { cols: usize, groups: usize };
+pub const layouts = [_]Layout{
+    .{ .cols = 1, .groups = 8 }, // original
+    .{ .cols = 1, .groups = 4 }, .{ .cols = 1, .groups = 8 },
+    .{ .cols = 2, .groups = 4 }, .{ .cols = 2, .groups = 8 },
+    .{ .cols = 4, .groups = 2 }, .{ .cols = 4, .groups = 4 },
+};
+const selector_names = [_][:0]const u8{ "tf_route_reduce", "tf_route_merge" };
+
+pub fn projection(device: mtl.Device, lib: mtl.Library, rows: usize, cols: usize) !mtl.Pipeline {
+    var name: [64]u8 = undefined;
+    const label = try std.fmt.bufPrint(&name, "tf_router_project_{d}_{d}\x00", .{ rows, cols });
+    return mtl.Pipeline.init(device, lib, label[0 .. label.len - 1 :0], false);
+}
+
+pub fn encodeProjection(e: mtl.ComputeEncoder, p: mtl.Pipeline, w: wts.Tensor, input: Buffer,
+    out: Buffer, rows: usize, layout: usize) void {
+    const g = layouts[layout];
+    e.setPipeline(p);
+    e.setBuffer(input, 0, 0);
+    e.setBuffer(w.buffer, w.offset, 1);
+    e.setBuffer(out, 0, 2);
+    if (layout == 0) e.setValue(fwd.GemvArgs{ .rows = @intCast(rows), .n = c.experts, .k = c.hidden,
+        .group_n = c.experts, .x_stride = c.hidden, .y_stride = c.experts }, 3);
+    e.dispatchGroups(mtl.Size.of(c.experts / (g.cols * g.groups), 1, 1), mtl.Size.of(g.groups * 32, 1, 1));
+}
+
+const Output = struct {
+    logits: Buffer,
+    pick: Buffer,
+    weights: Buffer,
+
+    fn init(s: *st.Storage) !Output {
+        return .{ .logits = try s.alloc(rows_max * c.experts * 4), .pick = try s.alloc(rows_max * c.topk * 4),
+            .weights = try s.alloc(rows_max * c.topk * 4) };
+    }
+
+    fn verify(a: Output, b: Output, rows: usize, logits: bool) !void {
+        if (!std.mem.eql(u32, a.pick.slice(u32, rows * c.topk), b.pick.slice(u32, rows * c.topk)))
+            return error.RouterVariantPickDiffers;
+        if (!std.mem.eql(u32, a.weights.slice(u32, rows * c.topk), b.weights.slice(u32, rows * c.topk)))
+            return error.RouterVariantWeightDiffers;
+        if (logits and !std.mem.eql(u32, a.logits.slice(u32, rows * c.experts), b.logits.slice(u32, rows * c.experts)))
+            return error.RouterVariantLogitDiffers;
+    }
+};
+
+const Trial = struct {
+    m: *Model,
+    w: *const wts.Moe,
+    rows: usize,
+    input: Buffer,
+    images: Buffer,
+    unused_trace: Buffer,
+    projections: [layouts.len]mtl.Pipeline,
+    selectors: [3]mtl.Pipeline,
+
+    fn time(t: Trial, l: usize, select: usize, out: Output, reps: usize, synthetic: ?[2]Buffer) !f64 {
+        const cb = t.m.queue.commandBuffer();
+        const e = cb.compute(.concurrent);
+        for (0..reps) |r| {
+            if (r != 0) e.barrier();
+            if (synthetic == null) {
+                encodeProjection(e, t.projections[l], t.w.router, t.input, out.logits, t.rows, l);
+                e.barrier();
+            }
+            e.setPipeline(t.selectors[select]);
+            const logits = if (synthetic) |s| s[0] else out.logits;
+            e.setBuffer(logits, 0, 0);
+            if (synthetic) |s| e.setBuffer(s[1], 0, 1) else e.setBuffer(t.w.bias.buffer, t.w.bias.offset, 1);
+            e.setBuffer(out.pick, 0, 2);
+            e.setBuffer(out.weights, 0, 3);
+            e.setValue(RouteArgs{}, 4);
+            e.setBuffer(t.images, 0, 5);
+            if (synthetic) |s| e.setBuffer(s[1], 0, 6) else e.setBuffer(t.w.bias_vl.buffer, t.w.bias_vl.offset, 6);
+            e.setBuffer(t.unused_trace, 0, 7);
+            e.dispatchGroups(mtl.Size.of(t.rows, 1, 1), mtl.Size.of(c.experts, 1, 1));
+        }
+        e.end();
+        cb.commit();
+        cb.wait();
+        if (cb.failure()) |why| {
+            std.log.err("router reduction probe Metal error: {s}", .{why});
+            return error.RouterVariantGpuFailed;
+        }
+        return cb.gpuSeconds() * 1e6 / @as(f64, @floatFromInt(reps));
+    }
+};
+
+pub fn probe(m: *Model) !void {
+    const lib = try mtl.Library.fromSource(m.device, @embedFile("router_reduction.metal"), mtl.CompileOptions.mlx());
+    defer lib.deinit();
+    var selectors: [3]mtl.Pipeline = undefined;
+    selectors[0] = m.kernels.get("ds_route");
+    var loaded: usize = 1;
+    defer for (selectors[1..loaded]) |p| p.deinit();
+    for (selector_names, 1..) |name, i| {
+        selectors[i] = try mtl.Pipeline.init(m.device, lib, name, false);
+        loaded += 1;
+    }
+    var memory: st.Storage = .{ .gpa = m.gpa, .device = m.device };
+    defer memory.deinit();
+    const input = try memory.alloc(rows_max * c.hidden * 2);
+    const images = try memory.alloc(rows_max * 4);
+    const synthetic_logits = try memory.alloc(rows_max * c.experts * 4);
+    const synthetic_bias = try memory.alloc(c.experts * 4);
+    const trace = try memory.alloc(4);
+    const reference = try Output.init(&memory);
+    const trial = try Output.init(&memory);
+    for (images.slice(i32, rows_max), 0..) |*cell, i| cell.* = @intCast(i % 2);
+    @memset(synthetic_bias.slice(u32, c.experts), 0);
+    for (1..rows_max + 1) |rows| {
+        const pool = mtl.objc.Pool.push();
+        defer pool.pop();
+        var p: [layouts.len]mtl.Pipeline = undefined;
+        p[0] = m.kernels.get("ds_gemv_bf_f32");
+        var count: usize = 1;
+        defer for (p[1..count]) |item| item.deinit();
+        for (layouts[1..], 1..) |g, i| {
+            p[i] = try projection(m.device, lib, rows, g.cols);
+            count += 1;
+        }
+        for ([_]usize{ 0, 10, 24, 39 }) |layer| {
+            const w = &m.weights.layers[layer].moe;
+            if (w.router.offset % 8 != 0) return error.RouterVariantUnalignedWeights;
+            for (input.slice(u16, rows * c.hidden), 0..) |*cell, i| {
+                const f: f32 = @floatFromInt(@as(i32, @intCast((i * 127 + layer * 89 + 71) % 997)) - 498);
+                cell.* = @truncate(@as(u32, @bitCast(f / 256.0)) >> 16);
+            }
+            const t = Trial{ .m = m, .w = w, .rows = rows, .input = input, .images = images,
+                .unused_trace = trace, .projections = p, .selectors = selectors };
+            _ = try t.time(0, 0, reference, 1, null);
+            const arms = layouts.len + 2;
+            for (1..arms) |i| {
+                const l = if (i < layouts.len) i else 0;
+                const s = if (i < layouts.len) 0 else i - layouts.len + 1;
+                _ = try t.time(l, s, trial, 1, null);
+                reference.verify(trial, rows, true) catch |err| {
+                    std.log.err("router variant differs layer={d} rows={d} layout={d} selector={d}", .{ layer, rows, l, s });
+                    return err;
+                };
+                std.log.info("router exact layer={d} rows={d} arm={d} f32={d} ids={d}",
+                    .{ layer, rows, i, rows * (c.experts + c.topk), rows * c.topk });
+            }
+            if (layer == 0) for (0..2) |special| {
+                @memset(synthetic_logits.slice(u32, rows * c.experts), 0);
+                if (special != 0) {
+                    for (synthetic_logits.slice(f32, rows * c.experts), 0..) |*cell, i|
+                        cell.* = @as(f32, @floatFromInt(i % 17)) * 0.25;
+                    synthetic_logits.slice(u32, rows * c.experts)[17] = 0x7fc00000;
+                }
+                const synthetic = [2]Buffer{ synthetic_logits, synthetic_bias };
+                _ = try t.time(0, 0, reference, 1, synthetic);
+                for (1..selectors.len) |s| {
+                    _ = try t.time(0, s, trial, 1, synthetic);
+                    try reference.verify(trial, rows, false);
+                    std.log.info("router special rows={d} fixture={d} selector={d} f32={d} ids={d}",
+                        .{ rows, special, s, rows * c.topk, rows * c.topk });
+                }
+            };
+            for (0..7) |run| for (0..arms) |j| {
+                const i = if (run % 2 == 0) j else arms - 1 - j;
+                const l = if (i < layouts.len) i else 0;
+                const s = if (i < layouts.len) 0 else i - layouts.len + 1;
+                const us = try t.time(l, s, trial, 10, null);
+                std.log.info("router time layer={d} rows={d} arm={d} run={d} us={d:.4}", .{ layer, rows, i, run, us });
+            };
+        }
+    }
+}
