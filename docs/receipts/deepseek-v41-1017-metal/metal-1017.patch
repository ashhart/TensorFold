diff --git a/zig/src/families/deepseek_v41_metal/gpu_greedy.metal b/zig/src/families/deepseek_v41_metal/gpu_greedy.metal
new file mode 100644
index 0000000000000000000000000000000000000000..1955547363f4f4f0d033b3dc341690689b71b6ba
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/gpu_greedy.metal
@@ -0,0 +1,59 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// Order the unmodified BF16 bits, including subnormals. The largest key
+// reports a nonfinite logit, and both signed zeros compare equally.
+static uint tf_greedy_key(uint bits) {
+  if ((bits & 0x7f80u) == 0x7f80u) return 0xffffu;
+  if (bits == 0x8000u) bits = 0;
+  return (bits & 0x8000u) ? 0xffffu - bits : bits | 0x8000u;
+}
+
+static uint2 tf_greedy_simd(uint2 pair) {
+  const uint max_key = simd_max(pair.x);
+  const uint min_id = simd_min(pair.x == max_key ? pair.y : 0xffffffffu);
+  return uint2(max_key, min_id);
+}
+
+static uint2 tf_greedy_group(uint2 pair, uint lane, uint sg, threadgroup uint2* waves, uint count) {
+  const uint2 winner = tf_greedy_simd(pair);
+  if (lane == 0) waves[sg] = winner;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (sg != 0) return uint2(0, 0xffffffffu);
+  return tf_greedy_simd(lane < count ? waves[lane] : uint2(0, 0xffffffffu));
+}
+
+[[kernel]] void tf_greedy_tiles(const device ushort* logits [[buffer(0)]],
+                                 device uint2* winners [[buffer(1)]],
+                                 constant uint2& dims [[buffer(2)]],
+                                 uint2 group [[threadgroup_position_in_grid]],
+                                 uint2 position [[thread_position_in_threadgroup]],
+                                 uint lane [[thread_index_in_simdgroup]],
+                                 uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup uint2 waves[8];
+  const uint t = position.x;
+  const device ushort* row = logits + size_t(group.y) * dims.x;
+  uint2 best(0, 0xffffffffu);
+  for (uint x = t; x < 1024; x += 256) {
+    const uint id = group.x * 1024 + x;
+    if (id < dims.x) {
+      const uint key = tf_greedy_key(row[id]);
+      if (key > best.x || (key == best.x && id < best.y)) best = uint2(key, id);
+    }
+  }
+  const uint2 winner = tf_greedy_group(best, lane, sg, waves, 8);
+  if (t == 0) winners[size_t(group.y) * dims.y + group.x] = winner;
+}
+
+[[kernel]] void tf_greedy_finish(const device uint2* winners [[buffer(0)]],
+                                  device uint* best [[buffer(1)]],
+                                  constant uint& tiles [[buffer(2)]],
+                                  uint row [[threadgroup_position_in_grid]],
+                                  uint t [[thread_position_in_threadgroup]],
+                                  uint lane [[thread_index_in_simdgroup]],
+                                  uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup uint2 waves[4];
+  const uint2 local = t < tiles ? winners[size_t(row) * tiles + t] : uint2(0, 0xffffffffu);
+  const uint2 winner = tf_greedy_group(local, lane, sg, waves, 4);
+  if (t == 0) best[row] = winner.x == 0xffffu ? 0xffffffffu : winner.y;
+}
diff --git a/zig/src/families/deepseek_v41_metal/gpu_greedy.zig b/zig/src/families/deepseek_v41_metal/gpu_greedy.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e26ca91a8ad66d3988ec709cc3c346130da7888d
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/gpu_greedy.zig
@@ -0,0 +1,95 @@
+//! Greedy selection with the host sampler's ordering of the stored BF16 scores.
+const std = @import("std");
+const mtl = @import("metal");
+const c = @import("config.zig");
+const draw = @import("../lfm2_moe/backend.zig").draw;
+const Buffer = mtl.Buffer;
+
+const tile_values = 1024;
+const tiles = (c.vocab + tile_values - 1) / tile_values;
+pub const bytes_per_row = tiles * 8;
+pub const nonfinite = std.math.maxInt(u32);
+
+pub const Kernels = struct {
+    tiles_pipe: mtl.Pipeline,
+    finish_pipe: mtl.Pipeline,
+    audit: bool,
+
+    pub fn load(device: mtl.Device) !?Kernels {
+        const audit = std.c.getenv("TF_BENCH_DS_GPU_GREEDY_AUDIT") != null;
+        if (!audit and std.c.getenv("TF_BENCH_DS_GPU_GREEDY") == null) return null;
+        const lib = try mtl.Library.fromSource(device, @embedFile("gpu_greedy.metal"), mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const tile = try mtl.Pipeline.init(device, lib, "tf_greedy_tiles", false);
+        errdefer tile.deinit();
+        return .{ .tiles_pipe = tile, .finish_pipe = try mtl.Pipeline.init(device, lib, "tf_greedy_finish", false), .audit = audit };
+    }
+
+    pub fn deinit(p: Kernels) void {
+        p.tiles_pipe.deinit();
+        p.finish_pipe.deinit();
+    }
+
+    pub fn encodeTiles(p: Kernels, enc: mtl.ComputeEncoder, logits: Buffer, part: Buffer, rows: usize) void {
+        const dims = [2]u32{ c.vocab, tiles };
+        enc.setPipeline(p.tiles_pipe);
+        enc.setBuffer(logits, 0, 0);
+        enc.setBuffer(part, 0, 1);
+        enc.setBytes(std.mem.asBytes(&dims), 2);
+        enc.dispatchGroups(mtl.Size.of(tiles, rows, 1), mtl.Size.of(256, 1, 1));
+    }
+
+    pub fn encodeFinish(p: Kernels, enc: mtl.ComputeEncoder, part: Buffer, tokens: Buffer, rows: usize) void {
+        comptime std.debug.assert(tiles <= 128);
+        const count: u32 = tiles;
+        enc.setPipeline(p.finish_pipe);
+        enc.setBuffer(part, 0, 0);
+        enc.setBuffer(tokens, 0, 1);
+        enc.setBytes(std.mem.asBytes(&count), 2);
+        enc.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(128, 1, 1));
+    }
+
+    pub fn check(p: Kernels, gpa: std.mem.Allocator, device: mtl.Device, queue: mtl.Queue) !void {
+        const rows = 7;
+        const options = mtl.ResourceOptions.shared;
+        const logits = try device.buffer(rows * c.vocab * 2, options);
+        defer logits.deinit();
+        const part = try device.buffer(rows * bytes_per_row, options);
+        defer part.deinit();
+        const tokens = try device.buffer(rows * 4, options);
+        defer tokens.deinit();
+        const input = logits.slice(u16, rows * c.vocab);
+        @memset(input, 0xbf80); // -1
+        input[1023] = 0x3f80;
+        input[1024] = 0x3f80; // a tie across tile boundaries
+        input[c.vocab + 87] = 0x8000;
+        input[c.vocab + 88] = 0; // signed zero tie
+        input[2 * c.vocab + 127] = 0;
+        input[2 * c.vocab + 128] = 1; // positive subnormal
+        @memset(input[3 * c.vocab ..][0..c.vocab], 0x8002);
+        input[4 * c.vocab - 1] = 0x8001; // negative subnormal in the last tile
+        input[5 * c.vocab - 1] = 0xff80; // nonfinite in the last tile
+        input[5 * c.vocab + 1] = 0x7fc1; // NaN
+
+        const cb = queue.commandBuffer();
+        const enc = cb.compute(.concurrent);
+        p.encodeTiles(enc, logits, part, rows);
+        enc.barrier();
+        p.encodeFinish(enc, part, tokens, rows);
+        enc.end();
+        cb.commit();
+        cb.wait();
+        if (cb.failure()) |message| {
+            std.log.err("DeepSeek GPU greedy check: {s}", .{message});
+            return error.DeepseekGreedyGpuFailed;
+        }
+        for (tokens.slice(u32, rows), 0..) |picked, row| {
+            const gold = draw(gpa, input[row * c.vocab ..][0..c.vocab], null, 0, &.{}) catch |err| switch (err) {
+                error.NonfiniteLfmLogits => nonfinite,
+                else => return err,
+            };
+            if (gold != picked) return error.DeepseekGreedyGpuDiffers;
+        }
+        std.log.info("deepseek_v41 bench: exact GPU greedy, {d} BF16 fixtures passed, audit={}", .{ rows, p.audit });
+    }
+};
diff --git a/zig/src/families/deepseek_v41_metal/hc_coefficients.metal b/zig/src/families/deepseek_v41_metal/hc_coefficients.metal
new file mode 100644
index 0000000000000000000000000000000000000000..c01e5a7ccf8dae17f2422b73fac0d44864abf8e4
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/hc_coefficients.metal
@@ -0,0 +1,50 @@
+#include <metal_stdlib>
+using namespace metal;
+#pragma clang fp contract(off)
+constant constexpr int S = 4, D = 5120, F = S * D, MIX = 2 * S + S * S, SLICES = F / 1024;
+struct HcArgs { float eps; float hc_eps; int iters; };
+
+[[kernel]] void tf_hc_coefficients(const device float* PART [[buffer(0)]],
+                                  const device float* BASE [[buffer(1)]],
+                                  const device float* SCALE [[buffer(2)]],
+                                  constant HcArgs& a [[buffer(3)]],
+                                  device float* PRE_OUT [[buffer(4)]],
+                                  device float* POST_OUT [[buffer(5)]],
+                                  device float* COMB_OUT [[buffer(6)]],
+                                  uint r [[threadgroup_position_in_grid]],
+                                  uint lane [[thread_index_in_simdgroup]]) {
+    float value = 0.0f;
+    if (lane <= MIX)
+      for (int j = 0; j < SLICES; j++)
+        value += PART[(size_t(r) * SLICES + j) * (MIX + 1) + lane];
+    const float sum_squares = simd_shuffle(value, ushort(MIX));
+    const float pre_sum = value;
+    const float post_sum = simd_shuffle(value, ushort(S + (lane & 3)));
+    const float comb_sum = simd_shuffle(value, ushort(2 * S + (lane < S * S ? lane : 0)));
+
+    const float rs = precise::rsqrt(sum_squares / float(F) + a.eps);
+    if (lane < uint(S)) {
+      PRE_OUT[r * S + lane] = 1.0f / (1.0f + precise::exp(-(pre_sum * rs * SCALE[0] + BASE[lane]))) + a.hc_eps;
+      POST_OUT[r * S + lane] = 2.0f / (1.0f + precise::exp(-(post_sum * rs * SCALE[1] + BASE[S + lane])));
+    }
+    const bool act = lane < uint(S * S);
+    const uint cell = act ? lane : 0;
+    const float v = comb_sum * rs * SCALE[2] + BASE[2 * S + cell];
+    float mx = max(v, simd_shuffle_xor(v, ushort(1)));
+    mx = max(mx, simd_shuffle_xor(mx, ushort(2)));
+    const float e = precise::exp(v - mx);
+    float row = e + simd_shuffle_xor(e, ushort(1));
+    row = row + simd_shuffle_xor(row, ushort(2));
+    float cm = act ? e / row + a.hc_eps : 0.0f;
+    for (int it = 0; it < a.iters; it++) {
+      if (it > 0) {
+        float rsum = cm + simd_shuffle_xor(cm, ushort(1));
+        rsum = rsum + simd_shuffle_xor(rsum, ushort(2));
+        cm = act ? cm / (rsum + a.hc_eps) : 0.0f;
+      }
+      float csum = cm + simd_shuffle_xor(cm, ushort(4));
+      csum = csum + simd_shuffle_xor(csum, ushort(8));
+      cm = act ? cm / (csum + a.hc_eps) : 0.0f;
+    }
+    if (act) COMB_OUT[r * S * S + lane] = cm;
+}
diff --git a/zig/src/families/deepseek_v41_metal/hc_overlap.zig b/zig/src/families/deepseek_v41_metal/hc_overlap.zig
new file mode 100644
index 0000000000000000000000000000000000000000..93bd52d55d0f844cdbab00f2e0390e7b51c366e3
--- /dev/null
+++ b/zig/src/families/deepseek_v41_metal/hc_overlap.zig
@@ -0,0 +1,184 @@
+//! Check whether moving hyperconnection metadata beside Q and KV reduces the decode dependency.
+const std = @import("std");
+const mtl = @import("metal");
+const st = @import("state.zig");
+const Model = @import("model.zig").Model;
+const c = @import("config.zig");
+const k = @import("kernels.zig");
+const wts = @import("weights.zig");
+const simd = @import("../../core/row_projection.zig").simd_bits;
+const Buffer = mtl.Buffer;
+
+const Args = extern struct { eps: f32 = c.norm_eps, hc_eps: f32 = c.hc_eps, iters: i32 = c.sinkhorn };
+const slices = c.hc * c.hidden / 1024;
+
+const Output = struct {
+    norm: Buffer,
+    pre: Buffer,
+    post: Buffer,
+    comb: Buffer,
+    q: Buffer,
+    kv: Buffer,
+
+    fn init(s: *st.Storage) !Output {
+        return .{ .norm = try s.alloc(2 * c.hidden * 2), .pre = try s.alloc(2 * c.hc * 4),
+            .post = try s.alloc(2 * c.hc * 4), .comb = try s.alloc(2 * c.hc * c.hc * 4),
+            .q = try s.alloc(2 * c.hidden * 2), .kv = try s.alloc(2 * c.hidden * 2) };
+    }
+
+    fn difference(a: Output, b: Output, rows: usize, q: usize, kv: usize) ?[]const u8 {
+        if (!std.mem.eql(u16, a.norm.slice(u16, rows * c.hidden), b.norm.slice(u16, rows * c.hidden))) return "norm";
+        if (!std.mem.eql(u32, a.pre.slice(u32, rows * c.hc), b.pre.slice(u32, rows * c.hc))) return "pre";
+        if (!std.mem.eql(u32, a.post.slice(u32, rows * c.hc), b.post.slice(u32, rows * c.hc))) return "post";
+        if (!std.mem.eql(u32, a.comb.slice(u32, rows * c.hc * c.hc), b.comb.slice(u32, rows * c.hc * c.hc))) return "comb";
+        if (!std.mem.eql(u16, a.q.slice(u16, rows * q), b.q.slice(u16, rows * q))) return "q";
+        if (!std.mem.eql(u16, a.kv.slice(u16, rows * kv), b.kv.slice(u16, rows * kv))) return "kv";
+        return null;
+    }
+};
+
+fn tensor(e: mtl.ComputeEncoder, t: wts.Tensor, i: usize) void {
+    e.setBuffer(t.buffer, t.offset, i);
+}
+
+const Trial = struct {
+    model: *Model,
+    layer: *const wts.Layer,
+    hc: wts.Hc,
+    rows: usize,
+    q: simd.Call,
+    kv: simd.Call,
+    mix: mtl.Pipeline,
+    input: Buffer,
+    parts: Buffer,
+    lagged_pre: Buffer,
+
+    fn prepare(t: Trial) !void {
+        const cb = t.model.queue.commandBuffer();
+        const e = cb.compute(.serial);
+        e.setPipeline(t.model.kernels.get("ds_hc_mix_part"));
+        e.setBuffer(t.input, 0, 0);
+        tensor(e, t.hc.fn_, 1);
+        e.setBuffer(t.parts, 0, 2);
+        e.dispatchGroups(mtl.Size.of(slices, t.rows, 1), mtl.Size.of(256, 1, 1));
+        e.end();
+        cb.commit();
+        cb.wait();
+        if (cb.status() != .completed) return error.HcProbeCannotPrepareParts;
+    }
+
+    fn norm(t: Trial, e: mtl.ComputeEncoder, out: Output, full: bool) void {
+        if (full) {
+            e.setPipeline(t.model.kernels.get("ds_hc_boundary"));
+            e.setBuffer(t.parts, 0, 1);
+            tensor(e, t.hc.base, 2);
+            tensor(e, t.hc.scale, 3);
+        } else {
+            e.setPipeline(t.model.kernels.get("ds_hc_collapse"));
+            e.setBuffer(t.input, 0, 1);
+            e.setBuffer(t.input, 0, 2);
+            e.setBuffer(t.input, 0, 3);
+        }
+        e.setBuffer(t.input, 0, 0);
+        e.setBuffer(t.lagged_pre, 0, 4);
+        tensor(e, t.layer.attn_norm, 5);
+        e.setValue(Args{}, 6);
+        e.setBuffer(out.pre, 0, 7);
+        e.setBuffer(out.post, 0, 8);
+        e.setBuffer(out.comb, 0, 9);
+        e.setBuffer(out.norm, 0, 10);
+        e.dispatchGroups(mtl.Size.of(t.rows, 1, 1), mtl.Size.of(1024, 1, 1));
+    }
+
+    fn metadata(t: Trial, e: mtl.ComputeEncoder, out: Output) void {
+        e.setPipeline(t.mix);
+        e.setBuffer(t.parts, 0, 0);
+        tensor(e, t.hc.base, 1);
+        tensor(e, t.hc.scale, 2);
+        e.setValue(Args{}, 3);
+        e.setBuffer(out.pre, 0, 4);
+        e.setBuffer(out.post, 0, 5);
+        e.setBuffer(out.comb, 0, 6);
+        e.dispatchGroups(mtl.Size.of(t.rows, 1, 1), mtl.Size.of(32, 1, 1));
+    }
+
+    fn projection(e: mtl.ComputeEncoder, p: simd.Call, w: wts.Linear, input: Buffer, out: Buffer) void {
+        simd.encode(e, p, .{ .w = w.w, .w_off = w.w_off, .scales = w.scales, .s_off = w.s_off,
+            .biases = w.biases, .b_off = w.b_off }, input, 0, out, 0);
+    }
+
+    fn time(t: Trial, out: Output, mode: usize, reps: usize) !f64 {
+        const cb = t.model.queue.commandBuffer();
+        const e = cb.compute(.concurrent);
+        for (0..reps) |r| {
+            if (r != 0) e.barrier();
+            t.norm(e, out, mode == 0);
+            if (mode == 1) t.metadata(e, out);
+            e.barrier();
+            projection(e, t.q, t.layer.attn.wq_a, out.norm, out.q);
+            projection(e, t.kv, t.layer.attn.wkv, out.norm, out.kv);
+            if (mode == 2) t.metadata(e, out);
+        }
+        e.end();
+        cb.commit();
+        cb.wait();
+        if (cb.failure()) |why| {
+            std.log.err("hyperconnection schedule probe error: {s}", .{why});
+            return error.HcProbeMetalFailed;
+        }
+        return cb.gpuSeconds() * 1e6 / @as(f64, @floatFromInt(reps));
+    }
+};
+
+pub fn probe(m: *Model) !void {
+    const tiles = if (m.kernels.tiles) |*p| p else return error.HcProbeNeedsProjectionTiles;
+    const lib = try mtl.Library.fromSource(m.device, @embedFile("hc_coefficients.metal"), mtl.CompileOptions.mlx());
+    defer lib.deinit();
+    const pipeline = try mtl.Pipeline.init(m.device, lib, "tf_hc_coefficients", false);
+    defer pipeline.deinit();
+    var store: st.Storage = .{ .gpa = m.gpa, .device = m.device };
+    defer store.deinit();
+    const input = try store.alloc(2 * c.hc * c.hidden * 2);
+    const parts = try store.alloc(2 * slices * (c.hc_mix + 1) * 4);
+    const lagged = try store.alloc(2 * c.hc * 4);
+    const a = try Output.init(&store);
+    const b = try Output.init(&store);
+    for (lagged.slice(f32, 2 * c.hc), 0..) |*p, i| p.* = @as(f32, @floatFromInt(i + 5)) / 32.0;
+    for ([_]usize{ 0, 10, 20, 30, 39 }) |layer_index| {
+        const layer = &m.weights.layers[layer_index];
+        const q = layer.attn.wq_a;
+        const kv = layer.attn.wkv;
+        if (!k.tiled(q) or !k.tiled(kv) or q.n > c.hidden or kv.n > c.hidden)
+            return error.HcProbeUnsupportedProjection;
+        for (input.slice(u16, 2 * c.hc * c.hidden), 0..) |*bits, i| {
+            const x: f32 = @floatFromInt(@as(i32, @intCast((i * 127 + layer_index * 39) % 997)) - 498);
+            bits.* = @truncate(@as(u32, @bitCast(x / 256.0)) >> 16);
+        }
+        for (1..3) |rows| {
+            const pool = mtl.objc.Pool.push();
+            defer pool.pop();
+            const t = Trial{ .model = m, .layer = layer, .hc = layer.hc_attn,
+                .rows = rows, .q = try simd.call(tiles, q.bits, q.n, q.k, rows, q.n, true),
+                .kv = try simd.call(tiles, kv.bits, kv.n, kv.k, rows, kv.n, true),
+                .mix = pipeline, .input = input, .parts = parts, .lagged_pre = lagged };
+            try t.prepare();
+            _ = try t.time(a, 0, 1);
+            for (1..3) |mode| {
+                _ = try t.time(b, mode, 1);
+                if (a.difference(b, rows, q.n, kv.n)) |field| {
+                    std.log.err("hc-overlap differs layer={d} rows={d} mode={d} field={s}",
+                        .{ layer_index, rows, mode, field });
+                    return error.HcOverlapDiffers;
+                }
+                std.log.info("hc-overlap exact layer={d} rows={d} mode={d} bf16={d} f32={d}",
+                    .{ layer_index, rows, mode, rows * (c.hidden + q.n + kv.n), rows * c.hc_mix });
+            }
+            for (0..7) |run| for (0..3) |i| {
+                const mode = if (run % 2 == 0) i else 2 - i;
+                const us = try t.time(b, mode, 12);
+                std.log.info("hc-overlap timing layer={d} rows={d} mode={d} run={d} us={d:.4}",
+                    .{ layer_index, rows, mode, run, us });
+            };
+        }
+    }
+}
