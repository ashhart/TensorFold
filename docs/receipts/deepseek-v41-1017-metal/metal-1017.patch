+static RankState estimate_rank_acceptance(RankState s, constant RankArgs& a, MarkovRank r, float group_p = -1.0f) {
+  float chance = s.pending;
+  const float gap = r.first_score - r.second_score;
+  if (isfinite(gap) && isfinite(chance)) {
+    const uint ci = uint(chance > 0.2f) + uint(chance > 0.4f) + uint(chance > 0.6f) + uint(chance > 0.8f);
+    const uint gi = uint(gap > 0.25f) + uint(gap > 0.5f) + uint(gap > 1.0f) + uint(gap > 2.0f);
+    const ushort2 counts = rank_counts[(a.step * 5 + ci) * 5 + gi];
+    chance = (32.0f * chance + float(counts.y)) / (32.0f + float(counts.x));
+    if (isfinite(group_p) && group_p >= 0.0f) {
+      const uint pi = uint(group_p >= 0.25f) + uint(group_p >= 0.5f) +
+                      uint(group_p >= 0.75f) + uint(group_p >= 0.90f);
+      const ushort2 entries = leader_counts[((a.step * 5 + ci) * 5 + gi) * 5 + pi];
+      chance = (8.0f * chance + float(entries.y)) / (8.0f + float(entries.x));
+    }
+  }
+  s.survival *= chance;
+  s.expected += s.survival;
+  s.examined++;
+  const uint depth = a.step + 1;
+  const float rate = s.expected / a.costs[depth];
+  if (rate > s.best_rate) {
+    s.best_rate = rate;
+    s.chosen = depth;
+  }
+  bool deeper = false;
+  for (uint j = depth + 1; j <= a.cap; ++j) {
+    const float bound = (s.expected + float(j - depth) * s.survival) / a.costs[j];
+    deeper = deeper || bound >= s.best_rate - 0.000001f;
+  }
+  if (!deeper) s.stop = depth;
+  return s;
+}
