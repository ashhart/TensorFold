+/// ROUND-537: the burst window. A family that batches prompts needs two requests queued AND two lanes free,
+/// but the host admits each arrival into a free lane as it is read -- so the first is always gone before the
+/// second lands, and `batches()` can never fire on a real burst. When the window is non-zero, a free-lane
+/// admission waits up to that many milliseconds for a second request (a lane already decoding pauses at most
+/// that long, against the ~0.6 s a suffix pass costs). Default 0: the shipped path, unchanged.
+pub fn holdForBurst(h: *LaneHost) void {
+    const ms = holdMs();
+    if (ms == 0) return;
+    const dbg = std.c.getenv("TF_DSV41_BATCH_DEBUG") != null;
+    var waited: u32 = 0;
+    var last: usize = 0;
+    while (waited < ms) {
+        h.lock();
+        const queued = h.queued.items.len;
+        const free = @min(h.info_.lanes, h.memory_lanes orelse h.info_.lanes) -| h.admitted.items.len;
+        h.unlock();
+        last = queued;
+        if (queued >= 2 or free < 2) break;
+        std.Io.sleep(h.io, .fromMilliseconds(1), .awake) catch {
+            if (dbg) std.log.info("hold: sleep failed after {d} ms, queued {d}", .{ waited, last });
+            return;
+        };
+        waited += 1;
+    }
+    if (dbg) std.log.info("hold: waited {d} of {d} ms, queued {d}", .{ waited, ms, last });
+}
+
+fn holdMs() u32 {
+    const S = struct {
+        var cached: i64 = -1;
+    };
+    if (S.cached < 0) S.cached = if (std.c.getenv("TF_DSV41_BATCH_HOLD_MS")) |v|
+        (std.fmt.parseInt(u32, std.mem.span(v), 10) catch 0)
+    else
+        0;
+    return @intCast(@min(S.cached, 500));
+}
