# rank 0 (aiai, head): serves HTTP. Both RoCE links: NCCL stripes over the two HCAs.
TF_RANK=0
NCCL_SOCKET_IFNAME=enP2p1s0f0np0
NCCL_IB_HCA==roceP2p1s0f0,rocep1s0f0

# host memory: no transparent huge pages for NumPy buffers or mimalloc arenas (THP first-touch compaction under
# memory pressure stalls long prefills on GB10; seen in jayleaton/deepseek-v41-tensorfold-spark, G12)
NUMPY_MADVISE_HUGEPAGE=0
MIMALLOC_ALLOW_THP=0
