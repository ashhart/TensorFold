# One watchdog tick for the tensorfold-dsv41 compose pair (watchdog.sh), run by tensorfold-dsv41-watchdog.timer.
# `make watch-install` copies it to ~/.config/systemd/user with @DIR@ set to the deploy directory. Settings (WATCH_HEAL,
# WATCH_FAILS, WATCH_ALERT, ...) come from that directory's .env; `make lease` makes it stand down for a while.
# Adapted from jayleaton/deepseek-v41-tensorfold-spark scripts/systemd/dsv41-tf-watchdog.service, Apache License 2.0,
# Copyright 2026 Jay Leaton (https://x.com/jayleaton). Modified: names, paths, the compose pair's script.
[Unit]
Description=tensorfold-dsv41 watchdog tick
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=@DIR@
ExecStart=/usr/bin/env bash @DIR@/watchdog.sh
# an unhealthy tick is logged, not a unit failure that trips start limits
SuccessExitStatus=1
# a heal runs `make restart` detached (setsid ... &): keep it alive when the oneshot exits
KillMode=process
TimeoutStartSec=300
