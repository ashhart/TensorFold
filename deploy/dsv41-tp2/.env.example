# Copy to .env (chmod 600: it holds the API key). Read by compose on both nodes (`make sync` copies it).
TF_IMAGE=tensorfold-dsv41:latest
MODELS_DIR=/home/urtho/models
CACHE_DIR=/home/urtho/.cache/tensorfold-serve
# node-local NVMe for each rank's prepared weight folder (~95 GB a node; make prepare writes it, starts read it)
PREPARED_DIR=/home/urtho/.cache/tensorfold-prepared
MODEL=dsv41/DeepSeek-V4.1-Flash-EXL3-2.9bpw
ENGRAM=dsv41/DeepSeek-V4.1-Flash-engram
MASTER_ADDR=10.42.0.1

# endpoint: the same port and model id as the vLLM recipe, so clients and the frpc tunnel need no change
HOST=0.0.0.0
PORT=8888
SERVED_NAME=DeepSeek-v4.1-Flash-EXL3
TF_API_KEY=

# capacity: concurrent streams, and the prompt + reply window each may use (admission refuses what will not fit)
PARALLEL=8
CONTEXT=131072
# extra serve flags, e.g. --thinking or --max-tokens 32768
EXTRA_ARGS=

TF_CARVEOUT=1
TF_DSV41_KV_FP8=1

# kept prompts on NVMe: states the shared pool evicts (and every kept state at `make down`) are written to each node's
# KV_DISK_DIR and restored when a prompt resumes from one (seconds instead of minutes of prefill for long prompts).
# Off unless TF_DSV41_DISK is set; both nodes need the same settings. /models may share the NVMe (Engram reads).
#TF_DSV41_DISK=/kvdisk
#KV_DISK_DIR=/home/urtho/.cache/tensorfold-kvdisk
#TF_DSV41_DISK_GIB=128
#STOP_GRACE_S=150

# /health answers 503 when the engine is fatal or one engine call runs longer than TF_STALL_S seconds
TF_HEALTH=strict
TF_STALL_S=300
# required / named / strict tools held to a DSML grammar: off | required | all (proven on the pair: exact alone ==
# batched, required == auto when auto calls first; off answers tool_choice "required" with HTTP 400)
TF_DSV41_TOOL_GRAMMAR=required

# the watchdog (make watch-install): WATCH_HEAL=1 restarts both ranks after WATCH_FAILS bad ticks (a dead container
# counts 2), at most once every WATCH_MIN_HEAL s; 0 only alerts (WATCH_ALERT: a command given the message)
WATCH_HEAL=0
WATCH_FAILS=3
WATCH_MIN_HEAL=1800
WATCH_ALERT=
