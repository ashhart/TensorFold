 }
+
+/// ComfyUI keeps double-precision coordinates and float32 rotary tables.
+pub fn rotaryComfy(cos: []f32, sin: []f32, text: usize, rows: usize, columns: usize) void {
+    const half = cfg.head_dim / 2;
+    const image = rows * columns;
+    std.debug.assert(cos.len == (image + text) * half and sin.len == cos.len);
+    var frequencies: [cfg.bands]f64 = undefined;
+    for (&frequencies, 0..) |*frequency, i| frequency.* = 1.0 / std.math.pow(f64, 10000, @as(f64, @floatFromInt(i)) / cfg.bands);
+    const top = @as(f64, @floatFromInt(rows - 1)) / 2;
+    const left = @as(f64, @floatFromInt(columns - 1)) / 2;
+    for (0..image + text) |r| {
+        const at: [4]f64 = if (r < image)
+            .{ 0, @floatFromInt(text), @as(f64, @floatFromInt(r / columns)) - top, @as(f64, @floatFromInt(r % columns)) - left }
+        else
+            .{ 0, @floatFromInt(r - image), 0, 0 };
+        for (0..half) |j| {
+            const angle = at[j / cfg.bands] * frequencies[j % cfg.bands];
+            cos[r * half + j] = @floatCast(@cos(angle));
+            sin[r * half + j] = @floatCast(@sin(angle));
+        }
+    }
+}
+
+test "Comfy rotary keeps float32 tables" {
+    var cos: [(16 * 14 + 33) * 64]f32 = undefined;
+    var sin: [cos.len]f32 = undefined;
+    rotaryComfy(&cos, &sin, 33, 16, 14);
+    try std.testing.expectEqual(@as(u32, 0xbc5986b7), @as(u32, @bitCast(cos[13 * 64 + 16])));
+    try std.testing.expectEqual(@as(u32, 0x3f7ffa39), @as(u32, @bitCast(sin[13 * 64 + 16])));
+    try std.testing.expectEqual(@as(u32, 0x3f75245a), @as(u32, @bitCast(cos[13 * 64 + 17])));
+    try std.testing.expectEqual(@as(u32, 0xbe938821), @as(u32, @bitCast(sin[13 * 64 + 17])));
+    try std.testing.expectEqual(@as(u32, 0xbe8feb12), @as(u32, @bitCast(cos[13 * 64 + 21])));
+    try std.testing.expectEqual(@as(u32, 0x3f75adad), @as(u32, @bitCast(sin[13 * 64 + 21])));
+    try std.testing.expectEqual(@as(u32, 0x3f7ffedf), @as(u32, @bitCast(cos[13 * 64 + 31])));
+    try std.testing.expectEqual(@as(u32, 0x3bc04ac5), @as(u32, @bitCast(sin[13 * 64 + 31])));
+    try std.testing.expectEqual(@as(u32, 0x3eb17a2f), @as(u32, @bitCast(cos[13 * 64 + 32])));
