new file mode 100644
index 0000000000000000000000000000000000000000..86e61c097365adba9cd34748d7a122738f9a6a6c
--- /dev/null
+++ b/zig/tests/cuda/contract_moss_image_time.zig
@@ -0,0 +1,101 @@
+//! Integer and actual adapter timestep grids, with FP64 sinusoids and derived FP32 transcendental ranges.
+const std = @import("std");
+const moss = @import("moss_image_cuda");
+const rig_ = @import("contract_rig.zig");
+const mi = @import("contract_moss_image_ref.zig");
+const c = mi.c;
+const g = mi.g;
+const Range = mi.Range;
+
+pub const Time = struct {
+    rig: rig_.Rig,
+    k: moss.Kernels,
+    name: []const u8,
+    control: ?g.Gate = null,
+    shape: c.Shape = undefined,
+    fill: g.Fill = .random,
+    out: u64 = 0,
+    ends: mi.Ends,
+
+    pub fn kernel(t: *Time) g.Kernel {
+        return .{ .spec = .{ .name = t.name, .accum = .none, .depth = mi.noSums, .ops = 12, .out = .bf16, .served = &.{.{ .rows = 2001, .n = 256, .k = 1 }} }, .ctx = t, .vt = &vt, .control = t.control };
+    }
+    const vt = g.hooks(Time);
+
+    pub fn deinit(t: *Time) void {
+        t.ends.deinit();
+        t.rig.deinit();
+    }
+    pub fn count(t: *Time) usize {
+        return t.shape.rows * 256;
+    }
+
+    pub fn prepare(t: *Time, shape: c.Shape, fill: g.Fill, _: u64) !bool {
+        if (shape.n != 256 or shape.rows == 0) return false;
+        var inputs: [2001 * 4]u8 = undefined;
+        for (0..2001) |row| std.mem.writeInt(u32, inputs[row * 4 ..][0..4], @bitCast(gridTime(row)), .little);
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(&inputs, &digest, .{});
+        const hex = std.fmt.bytesToHex(digest, .lower);
+        if (!std.mem.eql(u8, &hex, "c60288519f0d6cb98ab71900de27efbf5b84d75e127b4b84f5b9d479e5fe7333")) return error.AdapterTimeGridChanged;
+        t.rig.reset();
+        t.shape = shape;
+        t.fill = fill;
+        t.out = try t.rig.output(t.count() * 2);
+        return true;
+    }
+
+    fn gridTime(row: usize) f32 {
+        @setFloatMode(.strict);
+        if (row <= 1000) return @floatFromInt(row);
+        const index = row - 1001;
+        const end: f32 = 1.0 / 1000.0;
+        const step: f32 = (end - 1.0) / 999.0;
+        const position: f32 = @floatFromInt(if (index < 500) index else 999 - index);
+        const product: f32 = step * position;
+        const sigma: f32 = if (index < 500) 1.0 + product else end - product;
+        return sigma * 1000.0;
+    }
+
+    fn timestep(t: *const Time, row: usize) f32 {
+        if (t.fill == .nonfinite) return switch (row % 4) {
+            0 => std.math.nan(f32),
+            1 => std.math.inf(f32),
+            2 => -std.math.inf(f32),
+            else => gridTime(row),
+        };
+        return gridTime(row);
+    }
+
+    pub fn run(t: *Time) !void {
+        for (0..t.shape.rows) |row| try moss.time(&t.k, t.rig.s, t.out + row * 256 * 2, t.timestep(row));
+        try t.rig.s.synchronize();
+    }
+
+    pub fn reference(t: *Time, want: []f64, mag: []f64) !void {
+        try t.ends.size(t.count());
+        const base: f64 = @as(f32, -9.210340371976184);
+        for (0..t.shape.rows) |row| for (0..128) |column| {
+            const i: f64 = @floatFromInt(column);
+            const step: f64 = t.timestep(row);
+            const phase = step * @exp(base * i / 128);
+            const exponent = Range.of(base * i).fp32(0.5).mul(Range.of(1.0 / 128.0)).fp32(0.5);
+            const frequency = Range.of(@exp(exponent.lo));
+            const fr = Range{ .lo = frequency.lo, .hi = @exp(exponent.hi) };
+            const pr = fr.fp32(2.5).mul(Range.of(step)).fp32(0.5);
+            const radius = @max(@abs(pr.lo - phase), @abs(pr.hi - phase));
+            for (0..2) |part| {
+                const v = if (part == 0) @cos(phase) else @sin(phase);
+                const span = Range{ .lo = @max(-1, v - radius), .hi = @min(1, v + radius) };
+                t.ends.put(want, mag, row * 256 + part * 128 + column, mi.bf(v), span.fp32(2.5).bf16());
+            }
+        };
+    }
+
+    pub fn bounds(t: *Time, want: []const f64, _: []const f64, allow: []f64) !void {
+        t.ends.bounds(want, allow);
+    }
+    pub fn intervals(t: *Time, low: []f64, high: []f64) !void {
+        t.ends.intervals(low, high);
+    }
+};
