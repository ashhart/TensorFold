+//! The MOSS companion's CUDA contract runner.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub fn main(init: std.process.Init) !void {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var context = try cuda.Context.init(&driver, 0);
+    defer context.deinit();
+    const gpu: @import("check.zig").Gpu = .{ .d = &driver, .ctx = &context, .gpa = init.gpa, .io = init.io };
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const record_only = args.len == 2 and std.mem.eql(u8, args[1], "--record");
+    if (!record_only) try @import("contract_moss_image.zig").run(gpu);
+    const failures = try @import("contract_moss_image_limits.zig").audit(gpu, record_only);
+    if (failures != 0) return error.KernelLimitsFailed;
+}
