diff --git a/zig/tests/cuda/contract_moss_image_elementwise.zig b/zig/tests/cuda/contract_moss_image_elementwise.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ecaf68471a62e2d219c7010b9e87c933c4702145
--- /dev/null
+++ b/zig/tests/cuda/contract_moss_image_elementwise.zig
@@ -0,0 +1,144 @@
+//! MOSS bias, SiLU and modulation through independent FP64 formulas and guarded CUDA buffers.
+const std = @import("std");
+const cuda = @import("cuda");
+const moss = @import("moss_image_cuda");
+const rig_ = @import("contract_rig.zig");
+const mi = @import("contract_moss_image_ref.zig");
+const c = mi.c;
+const g = mi.g;
+const Range = mi.Range;
+
+pub const Kind = enum { bias, silu, modulation };
+
+pub const Elementwise = struct {
+    rig: rig_.Rig,
+    k: moss.Kernels,
+    kind: Kind,
+    name: []const u8,
+    control: ?g.Gate = null,
+    shape: c.Shape = undefined,
+    x: []u16 = &.{},
+    b: []u16 = &.{},
+    ins: [2]u64 = @splat(0),
+    out: u64 = 0,
+    ends: mi.Ends,
+
+    pub fn spec(t: *const Elementwise) c.Spec {
+        return .{
+            .name = t.name,
+            .accum = .none,
+            .depth = mi.noSums,
+            .ops = if (t.kind == .silu) 2 * (mi.exp_ulps + mi.div_ulps) + 1 else 1,
+            .out = .bf16,
+            .in_place = t.kind != .modulation,
+            .tiles = .{ .{}, .{ .size = 256 }, .{} },
+            .served = if (t.kind == .bias)
+                &.{ .{ .rows = 65536, .n = mi.hidden, .k = 1 }, .{ .rows = 4096, .n = mi.hidden, .k = 1 }, .{ .rows = 1, .n = mi.hidden, .k = 1 } }
+            else
+                &.{.{ .rows = 1, .n = mi.hidden, .k = 1 }},
+        };
+    }
+
+    fn free(t: *Elementwise) void {
+        t.rig.gpu.gpa.free(t.x);
+        t.rig.gpu.gpa.free(t.b);
+        t.x = &.{};
+        t.b = &.{};
+    }
+
+    pub fn deinit(t: *Elementwise) void {
+        t.free();
+        t.ends.deinit();
+        t.rig.deinit();
+    }
+
+    pub fn kernel(t: *Elementwise) g.Kernel {
+        return .{ .spec = t.spec(), .ctx = t, .vt = &vt, .control = t.control };
+    }
+    const vt = g.hooks(Elementwise);
+
+    pub fn prepare(t: *Elementwise, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0) return false;
+        t.rig.reset();
+        t.free();
+        t.shape = shape;
+        const a = t.rig.gpu.gpa;
+        const n = shape.rows * shape.n * @as(usize, if (t.kind == .modulation) 8 else 1);
+        t.x = try a.alloc(u16, n);
+        t.b = try a.alloc(u16, if (t.kind == .bias) shape.n else 0);
+        var random = std.Random.DefaultPrng.init(seed);
+        mi.randomBf16(random.random(), t.x, -16, 16);
+        mi.randomBf16(random.random(), t.b, -4, 4);
+        if (fill == .nonfinite) {
+            for ([_]u16{ mi.nan16, mi.inf16, mi.ninf16 }, 0..) |v, i| t.x[i % n] = v;
+            if (t.kind == .bias) for ([_]u16{ mi.nan16, mi.inf16, mi.ninf16 }, 0..) |v, i| {
+                t.b[(i + 3) % t.b.len] = v;
+            };
+        }
+        t.ins[0] = try mi.input(&t.rig, t.x);
+        if (t.kind == .bias) t.ins[1] = try mi.input(&t.rig, t.b);
+        t.out = try t.rig.output(t.count() * 2);
+        return true;
+    }
+
+    pub fn count(t: *Elementwise) usize {
+        return t.shape.rows * t.shape.n * @as(usize, if (t.kind == .modulation) 9 else 1);
+    }
+
+    pub fn run(t: *Elementwise) !void {
+        if (t.kind != .modulation) {
+            const bytes = t.x.len * 2;
+            try (cuda.DeviceBuffer{ .d = t.rig.gpu.d, .ptr = t.out, .len = bytes }).copyFrom(0, t.ins[0], bytes, t.rig.s.handle);
+        }
+        switch (t.kind) {
+            .bias => try moss.biasAdd(&t.k, t.rig.s, t.out, t.ins[1], t.shape.rows, t.shape.n),
+            .silu => try moss.silu(&t.k, t.rig.s, t.out, t.count()),
+            .modulation => for (0..t.shape.rows) |row| {
+                const input = t.ins[0] + row * 8 * t.shape.n * 2;
+                const output = t.out + row * 9 * t.shape.n * 2;
+                try moss.modulation(&t.k, t.rig.s, input, output, t.shape.n);
+            },
+        }
+        try t.rig.s.synchronize();
+    }
+
+    pub fn reference(t: *Elementwise, want: []f64, mag: []f64) !void {
+        try t.ends.size(t.count());
+        const from = [_]usize{ 1, 0, 2, 4, 3, 5, 7, 6 };
+        for (0..t.count()) |i| {
+            const n = t.shape.n;
+            var value: f64 = undefined;
+            var range: Range = undefined;
+            switch (t.kind) {
+                .bias => {
+                    value = c.fromBf16(t.x[i]) + c.fromBf16(t.b[i % n]);
+                    range = Range.of(value).fp32(0.5).bf16();
+                },
+                .silu => {
+                    const x: f64 = c.fromBf16(t.x[i]);
+                    value = x / (1 + @exp(-x));
+                    range = Range.of(@exp(-x)).fp32(2.5).add(Range.of(1)).fp32(0.5).recip().mul(Range.of(x)).fp32(mi.div_ulps).bf16();
+                },
+                .modulation => {
+                    const sample = i / (9 * n);
+                    const row = (i / n) % 9;
+                    if (row == 8) {
+                        value = 1;
+                    } else {
+                        const x = c.fromBf16(t.x[sample * 8 * n + from[row] * n + i % n]);
+                        value = x + @as(f64, if (row == 0 or row == 3 or row == 6) 1 else 0);
+                    }
+                    range = Range.of(value).fp32(0.5).bf16();
+                },
+            }
+            t.ends.put(want, mag, i, mi.bf(value), range);
+        }
+    }
+
+    pub fn bounds(t: *Elementwise, want: []const f64, _: []const f64, allow: []f64) !void {
+        t.ends.bounds(want, allow);
+    }
+    pub fn intervals(t: *Elementwise, low: []f64, high: []f64) !void {
+        t.ends.intervals(low, high);
+    }
+};
