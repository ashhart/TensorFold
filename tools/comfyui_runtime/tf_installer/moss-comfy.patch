new file mode 100644
index 0000000000000000000000000000000000000000..4cd834cc71436443577d1006008c1184d1819361
--- /dev/null
+++ b/zig/tests/cuda/contract_moss_image_limits.zig
@@ -0,0 +1,89 @@
+//! Compile records on every release SM and the companion's actual launches on this device.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const limits = core.contract.limits;
+const registry = core.contract.registry;
+const cubin = core.contract.cubin;
+const records = struct {
+    pub const cuda = core.contract.registry.moss_cuda;
+};
+const controls = struct {
+    pub const bytes align(16) = @embedFile("fatbin_contract_controls").*;
+};
+
+fn image(name: []const u8) ![]const u8 {
+    if (std.mem.eql(u8, name, "moss_image")) return cuda.kernels.moss_image;
+    if (std.mem.eql(u8, name, "prefill_attention")) return cuda.kernels.prefill_attention;
+    if (std.mem.eql(u8, name, "vit")) return cuda.kernels.vit;
+    if (std.mem.eql(u8, name, "contract_controls")) return &controls.bytes;
+    return error.UnknownImage;
+}
+
+pub fn audit(gpu: check.Gpu, record_only: bool) !usize {
+    const a = gpu.gpa;
+    var problems: usize = 0;
+    var caught: usize = 0;
+    for (records.cuda ++ registry.cuda_controls) |record| {
+        const control = std.mem.startsWith(u8, record.launch.name, "control:");
+        const bytes = try image(record.launch.image);
+        const images = try cubin.images(a, bytes);
+        defer cubin.freeImages(a, images);
+        var measured: [limits.sms.len]limits.Usage = undefined;
+        for (limits.sms, 0..) |sm, i| {
+            const im = for (images) |candidate| {
+                if (candidate.sm == sm.sm) break candidate;
+            } else return error.MissingArchitecture;
+            const kernels = try cubin.kernels(a, im.elf, sm.sm);
+            defer a.free(kernels);
+            const kernel = for (kernels) |candidate| {
+                if (std.mem.eql(u8, candidate.name, record.launch.symbol)) break candidate;
+            } else return error.MissingKernel;
+            measured[i] = kernel.usage;
+            if (record_only) continue;
+            var details: std.ArrayList(u8) = .empty;
+            defer details.deinit(a);
+            const failures = try limits.cuda(record.launch, kernel.usage, sm, &details, a);
+            if (control) {
+                if (failures > 0) caught += 1 else problems += 1;
+                std.debug.print("{s} limits sm_{d} {s}\n", .{ if (failures > 0) "RED" else "MISSED", sm.sm, record.launch.name });
+            } else {
+                const current = std.meta.eql(kernel.usage, record.usage[i]);
+                if (!current or failures > 0) problems += 1;
+                std.debug.print("{s} limits sm_{d} {s}: regs={d} shared={d} bound={d} local={d}\n", .{ if (current and failures == 0) "PASS" else "FAIL", sm.sm, record.launch.name, kernel.usage.regs, kernel.usage.static, kernel.usage.bound, kernel.usage.local });
+            }
+        }
+        if (record_only and !control) {
+            std.debug.print("RECORDJSON {s} [", .{record.launch.symbol});
+            for (measured, 0..) |u, i| std.debug.print("{s}{{\"regs\":{d},\"static\":{d},\"bound\":{d},\"local\":{d}}}", .{ if (i == 0) "" else ",", u.regs, u.static, u.bound, u.local });
+            std.debug.print("]\n", .{});
+        }
+    }
+    if (record_only) return 0;
+    const capability: u32 = @intCast(try gpu.ctx.capability());
+    const shared: u32 = @intCast(try gpu.ctx.attribute(.max_shared_memory_per_block_optin));
+    for (records.cuda ++ registry.cuda_controls) |record| {
+        const control = std.mem.startsWith(u8, record.launch.name, "control:");
+        var module = try cuda.Module.load(gpu.d, try image(record.launch.image));
+        defer module.unload();
+        const name = try a.dupeSentinel(u8, record.launch.symbol, 0);
+        defer a.free(name);
+        const function = try module.function(name);
+        const max_threads: u32 = @intCast(try function.attribute(.max_threads_per_block));
+        const static: u32 = @intCast(try function.attribute(.shared_size_bytes));
+        const regs: u32 = @intCast(try function.attribute(.num_regs));
+        const at = for (limits.sms, 0..) |sm, i| {
+            if (sm.sm == capability) break i;
+        } else return error.UnregisteredDevice;
+        const fits = record.launch.threads <= max_threads and static + record.launch.dynamic <= shared;
+        const current = static == record.usage[at].static and regs == record.usage[at].regs;
+        if (control) {
+            if (!fits) caught += 1 else problems += 1;
+        } else if (!fits or !current) problems += 1;
+        const passed = if (control) !fits else fits and current;
+        std.debug.print("{s} live sm_{d} {s}: regs={d} shared={d} threads={d}/{d}\n", .{ if (passed) (if (control) "RED" else "PASS") else "FAIL", capability, record.launch.name, regs, static, record.launch.threads, max_threads });
+    }
+    std.debug.print("SUMMARY moss limits: {d} launches, {d} compile/live controls red, {d} problems\n", .{ records.cuda.len, caught, problems });
+    return problems;
+}
